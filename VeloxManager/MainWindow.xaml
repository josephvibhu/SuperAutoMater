<Window x:Class="VeloxManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:VeloxManager.Converters"
        mc:Ignorable="d"
        Title="VeloxManager — Asset Inventory &amp; Fleet Operations Cockpit" 
        Height="720" Width="1200"
        MinHeight="550" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C10"
        Foreground="#F0F6FC"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:BoolToColorBrushConverter x:Key="BoolColor" />
        <conv:BoolToStatusTextConverter x:Key="BoolStatus" />
        <conv:InvoiceTypeToBrushConverter x:Key="InvTypeBrush" />
        <conv:InvoiceTypeToStringConverter x:Key="InvTypeString" />

        <!-- Metric Box Style -->
        <Style x:Key="HeaderMetric" TargetType="Border">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CaretBrush" Value="#58A6FF" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="#8B949E" Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#58A6FF" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#58A6FF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder"
                                            Background="#161B22"
                                            BorderBrush="#30363D"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,2">
                                        <ScrollViewer Margin="4,4,4,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F6FEB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#238636" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Column Header Style (Eradicates Windows Aero White Header) -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F6FEB" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#21262D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F6FEB" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark TabControl Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF" />
                                <Setter TargetName="border" Property="Background" Value="#21262D" />
                                <Setter Property="Foreground" Value="#F0F6FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Real-Time Indicators -->
            <RowDefinition Height="Auto" />
            <!-- 1: Navigation & Content -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Status Strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── TOP HEADER BAR ────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="24" Foreground="#58A6FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VELOX" FontWeight="Bold" FontSize="19" Foreground="#58A6FF" />
                            <TextBlock Text="MANAGER" FontWeight="Light" FontSize="19" Foreground="#F0F6FC" Margin="6,0,0,0" />
                            <Border Background="#238636" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LIVE DEPOT COCKPIT" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Warehouse Asset Inventory, Dispatch, Fleet &amp; Billing Engine" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Pills & Metrics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Cloud Indicator -->
                    <Border Background="#0D1117" BorderBrush="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CloudStatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" />
                        </StackPanel>
                    </Border>

                    <!-- LAN Indicator -->
                    <Border Background="#0D1117" BorderBrush="{Binding LanStatusColor, Converter={StaticResource HexBrush}}" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding LanStatusColor, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LanStatusText}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding LanStatusColor, Converter={StaticResource HexBrush}}" />
                        </StackPanel>
                    </Border>

                    <!-- KPI Badges -->
                    <Border Style="{StaticResource HeaderMetric}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TOTAL: " FontSize="11" Foreground="#8B949E" />
                            <TextBlock Text="{Binding TotalAssetsCount}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HeaderMetric}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WIP: " FontSize="11" Foreground="#8B949E" />
                            <TextBlock Text="{Binding WipCount}" FontWeight="Bold" FontSize="12" Foreground="#58A6FF" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HeaderMetric}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="READY TO SELL: " FontSize="11" Foreground="#8B949E" />
                            <TextBlock Text="{Binding ReadyForSaleCount}" FontWeight="Bold" FontSize="12" Foreground="#3FB950" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshAssetsCommand}"
                            Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                            Padding="12,6" FontWeight="SemiBold" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh Assets" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── TAB CONTROL / MAIN WORKSPACE ───────────────────────────────────── -->
        <TabControl Grid.Row="1" Background="#0A0C10" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 0: ASSET INVENTORY COCKPIT (THE CORE PAGE)                      -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="📦 ASSET INVENTORY">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Top Filter / Search Bar -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="14" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="360"
                                         FontSize="13" Padding="8,5" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                                         ToolTip="Search by Serial Number, Asset Tag, Model, Assigned Tech, Supplier, or Customer..." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Filter:" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged}" Width="160" IsReadOnly="True">
                                    <ComboBoxItem Content="ALL" IsSelected="True" />
                                    <ComboBoxItem Content="READY_FOR_SALE" />
                                    <ComboBoxItem Content="WIP" />
                                    <ComboBoxItem Content="TESTING" />
                                    <ComboBoxItem Content="REPAIR" />
                                    <ComboBoxItem Content="SOLD" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Asset DataGrid -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="1" Margin="0,0,12,0">
                        <DataGrid ItemsSource="{Binding FilteredAssets}" 
                                  SelectedItem="{Binding SelectedAsset}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#21262D"
                                  Background="#0D1117" 
                                  RowBackground="#0D1117" 
                                  AlternatingRowBackground="#161B22"
                                  Foreground="#F0F6FC" 
                                  BorderThickness="0"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single">


                            <DataGrid.Columns>
                                <!-- Serial Number -->
                                <DataGridTextColumn Header="SERIAL NUMBER" Binding="{Binding SerialNumber}" FontWeight="Bold" Width="140" />

                                <!-- Asset Tag -->
                                <DataGridTextColumn Header="ASSET TAG" Binding="{Binding AssetTag}" Width="120" />

                                <!-- Model -->
                                <DataGridTextColumn Header="MODEL / SPECS" Binding="{Binding ModelName}" Width="*" />

                                <!-- Status Pill -->
                                <DataGridTemplateColumn Header="STATUS" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColorHex, Converter={StaticResource HexBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Grade -->
                                <DataGridTemplateColumn Header="GRADE" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#21262D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                <TextBlock Text="{Binding GradeBadge}" FontWeight="SemiBold" FontSize="10" Foreground="#58A6FF" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Assigned Technician -->
                                <DataGridTextColumn Header="ASSIGNED TO" Binding="{Binding AssignedEmployeeName}" Width="130" />

                                <!-- Storage Health -->
                                <DataGridTemplateColumn Header="DISK HEALTH" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StorageHealth, StringFormat='{}{0}%'}" FontWeight="Bold" Foreground="#3FB950" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Location -->
                                <DataGridTextColumn Header="LOCATION" Binding="{Binding CurrentLocation}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Right Side Asset Inspector & Action Panel -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <!-- Empty state if no asset selected -->
                            <TextBlock Text="Select an asset from the inventory to inspect details, dispatch to technician, or update status."
                                       Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Visibility="{Binding HasSelectedAsset, Converter={StaticResource NullVis}, ConverterParameter=invert}" />

                            <!-- Active Asset Inspector -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasSelectedAsset, Converter={StaticResource NullVis}}">
                                <StackPanel>
                                    <TextBlock Text="ASSET INSPECTOR" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,8" />

                                    <!-- Asset Identity Card -->
                                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedAsset.ModelName}" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedAsset.SerialNumber, StringFormat='Serial: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding SelectedAsset.AssetTag, StringFormat='Tag: {0}'}" FontSize="11" Foreground="#58A6FF" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding SelectedAsset.CurrentLocation, StringFormat='Location: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- One-Click Lifecycle Actions -->
                                    <TextBlock Text="QUICK STATUS MUTATION" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <Button Content="READY FOR SALE" Command="{Binding UpdateStatusCommand}" CommandParameter="ReadyForSale" 
                                                Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                        <Button Content="ACTIVE TESTING" Command="{Binding UpdateStatusCommand}" CommandParameter="ActiveTesting" 
                                                Background="#1F6FEB" Foreground="#FFF" BorderBrush="#388BFD" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                        <Button Content="IN REPAIR" Command="{Binding UpdateStatusCommand}" CommandParameter="InHouseRepair" 
                                                Background="#9E6A03" Foreground="#FFF" BorderBrush="#BB8009" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                        <Button Content="AWAITING PARTS" Command="{Binding UpdateStatusCommand}" CommandParameter="AwaitingParts" 
                                                Background="#6E40C9" Foreground="#FFF" BorderBrush="#8957E5" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                        <Button Content="MARK SOLD" Command="{Binding UpdateStatusCommand}" CommandParameter="Sold" 
                                                Background="#30363D" Foreground="#8B949E" BorderBrush="#484F58" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                        <Button Content="SCRAP / SALVAGE" Command="{Binding UpdateStatusCommand}" CommandParameter="ScrapHarvest" 
                                                Background="#DA3633" Foreground="#FFF" BorderBrush="#F85149" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                    </UniformGrid>

                                    <!-- Technician Job Dispatch -->
                                    <TextBlock Text="DISPATCH TO TECHNICIAN" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
                                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" DisplayMemberPath="Name" Margin="0,0,0,8" />
                                            <Button Content="⚡ Assign Job to Technician" Command="{Binding AssignToEmployeeCommand}"
                                                    Background="#1F6FEB" Foreground="#FFF" BorderBrush="#388BFD" FontWeight="Bold" Padding="10,6" FontSize="11" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Commercial Details -->
                                    <TextBlock Text="ATTRIBUTION &amp; NOTES" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
                                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedAsset.Supplier, StringFormat='Supplier: {0}'}" FontSize="11" Foreground="#8B949E" />
                                            <TextBlock Text="{Binding SelectedAsset.Customer, StringFormat='Customer: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding SelectedAsset.MissingComponents, StringFormat='Defects: {0}'}" FontSize="11" Foreground="#D29922" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedAsset.Notes, StringFormat='Notes: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 1: FLEET & BENCH OPERATIONS (UPGRADED FLEET VIEW)               -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="⚡ BENCH FLEET OPS">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="LIVE DIAGNOSTIC BENCHES &amp; WORKSTATION STREAM" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" />
                            <TextBlock Text="Real-time telemetry and intake events broadcasted from active diagnostic bench clients via Railway SSE &amp; LAN Mirror port 9000."
                                       FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Real-Time Activity Log List -->
                    <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12">
                        <ListBox ItemsSource="{Binding LiveActivityFeed}" Background="#0D1117" Foreground="#3FB950" FontFamily="Consolas, monospace" FontSize="12" BorderThickness="0" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 2: TECHNICIANS & JOB QUEUE                                      -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="👥 TECHNICIANS &amp; JOBS">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Employee List -->
                    <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="DEPOT TECHNICIANS &amp; BENCH OPERATORS" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                <TextBlock Text="Select a technician to reset PIN or modify assigned bench" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployeeForEdit}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22" Foreground="#F0F6FC" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120" />
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" FontWeight="Bold" Width="160" />
                                    <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="110" />
                                    <DataGridTemplateColumn Header="STATION" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StationId}" FontWeight="Bold" FontSize="10" Foreground="#58A6FF" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="STATUS" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding IsActive, Converter={StaticResource BoolColor}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolStatus}}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ASSIGNED WORK" Binding="{Binding WorkloadCount, StringFormat='{}{0} assets'}" Width="110" />
                                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right Column: Registration & Active Technician Management -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Register Technician Card -->
                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="REGISTER NEW TECHNICIAN" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,12" />

                                    <TextBlock Text="FULL NAME" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewEmployeeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="STATION PIN" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewEmployeePin, UpdateSourceTrigger=PropertyChanged}" ToolTip="4+ digit PIN for bench and mobile PWA login" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="STATION / BENCH ID" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NewEmployeeStationId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Assigned hardware bench (e.g. BENCH-01)" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="SECURITY ROLE" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                    <ComboBox Text="{Binding NewEmployeeRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" IsEditable="True">
                                        <ComboBoxItem Content="Technician" IsSelected="True" />
                                        <ComboBoxItem Content="Supervisor" />
                                        <ComboBoxItem Content="WarehouseManager" />
                                        <ComboBoxItem Content="Administrator" />
                                    </ComboBox>

                                    <Button Content="+ Register Technician" Command="{Binding CreateEmployeeCommand}"
                                            Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" FontWeight="Bold" Padding="12,8" />
                                </StackPanel>
                            </Border>

                            <!-- Selected Technician Management Card -->
                            <Border Background="#161B22" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="8" Padding="14"
                                    Visibility="{Binding HasSelectedEmployeeForEdit, Converter={StaticResource NullVis}}">
                                <StackPanel>
                                    <TextBlock Text="MANAGE SELECTED OPERATOR" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding SelectedEmployeeForEdit.Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                        <TextBlock Text=" — " Foreground="#8B949E" />
                                        <TextBlock Text="{Binding SelectedEmployeeForEdit.Role}" Foreground="#8B949E" />
                                    </StackPanel>

                                    <!-- Reset PIN -->
                                    <TextBlock Text="NEW STATION PIN" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding EditEmployeePin, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="🔑 Reset PIN" Command="{Binding ResetEmployeePinCommand}"
                                                Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" FontWeight="Bold" Padding="10,6" />
                                    </Grid>

                                    <!-- Modify Station ID -->
                                    <TextBlock Text="ASSIGN BENCH / STATION ID" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding EditEmployeeStationId, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="🏷 Update Station" Command="{Binding UpdateEmployeeStationCommand}"
                                                Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" FontWeight="Bold" Padding="10,6" />
                                    </Grid>

                                    <!-- Toggle Active -->
                                    <Button Content="⏻ Toggle Active / Inactive Status" Command="{Binding ToggleEmployeeActiveCommand}"
                                            Background="#21262D" Foreground="#D29922" BorderBrush="#30363D" FontWeight="SemiBold" Padding="10,7" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 3: BILLING & INVOICING (SALES BILL & PURCHASE BILL)             -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="🧾 BILLING &amp; INVOICES">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <!-- Generated Invoices List -->
                    <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="GENERATED COMMERCIAL INVOICES &amp; BILLS" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,10" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22" Foreground="#F0F6FC" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" FontWeight="Bold" Width="150" />
                                    <DataGridTemplateColumn Header="TYPE" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Type, Converter={StaticResource InvTypeBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource InvTypeString}}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" Width="95" />
                                    <DataGridTextColumn Header="PARTY / CLIENT / SUPPLIER" Binding="{Binding PartyName}" Width="*" />
                                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding SubTotal, StringFormat='{}{0:C}'}" Width="90" />
                                    <DataGridTextColumn Header="TAX" Binding="{Binding TaxAmount, StringFormat='{}{0:C}'}" Width="80" />
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat='{}{0:C}'}" FontWeight="Bold" Width="95" />
                                    <DataGridTemplateColumn Header="ACTIONS" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="📄 Preview" Command="{Binding DataContext.PreviewInvoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" Padding="6,2" FontSize="10" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Invoice Generator Panel -->
                    <Border Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="COMMERCIAL BILLING SUITE" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,12" />

                                <TextBlock Text="DOCUMENT TYPE" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <ComboBox Text="{Binding SelectedInvoiceTypeString, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" IsReadOnly="True">
                                    <ComboBoxItem Content="Sales Tax Invoice" IsSelected="True" />
                                    <ComboBoxItem Content="Purchase Inward Bill" />
                                </ComboBox>

                                <TextBlock Text="{Binding InvoicePartyLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewInvoiceParty, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding InvoicePriceLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NewInvoiceUnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TAX RATE (%)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NewInvoiceTax, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="MEMO / TERMS &amp; CONDITIONS" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewInvoiceNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <CheckBox Content="Mark invoiced unit(s) as SOLD"
                                          IsChecked="{Binding MarkAsSoldOnInvoice}"
                                          Visibility="{Binding IsSalesInvoice, Converter={StaticResource NullVis}}"
                                          Foreground="#3FB950" FontWeight="SemiBold" Margin="0,0,0,14" />

                                <TextBlock Text="Billing will be generated for the currently selected unit in the Inventory tab, or bundles top inventory units if none are selected."
                                           FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <Button Content="{Binding GenerateInvoiceButtonText}" Command="{Binding GenerateInvoiceCommand}"
                                        Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" FontWeight="Bold" Padding="14,10" FontSize="12" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 4: SETTINGS & LAN MIRROR SERVER                                 -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="⚙ SETTINGS &amp; LAN SERVER">
                <Grid Margin="16">
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="20" MaxWidth="600" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="VELOX DEPOT CONFIGURATION" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,14" />

                            <TextBlock Text="CLOUD API ENDPOINT" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
                                <TextBlock Text="https://velox-api-production.up.railway.app" Foreground="#58A6FF" FontWeight="Bold" />
                            </Border>

                            <TextBlock Text="PRIMARY API KEY" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
                                <TextBlock Text="vx-2fe1479ad70dffd3017a0aa8c67b1c270fc9dd00bb9d4bdf" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                            </Border>

                            <TextBlock Text="LOCAL LAN MIRROR SERVER" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,8,0,4" />
                            <TextBlock Text="Listens on Port 9000 for zero-latency local bench synchronization. Bench clients on the same local network push tests here sub-millisecond, which are then synchronized to Railway Cloud."
                                       FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <Button Content="Toggle LAN Mirror Server" Command="{Binding ToggleLanServerCommand}"
                                    Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" FontWeight="SemiBold" Padding="12,8" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ── FOOTER STATUS BAR ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Velox Platform: " FontSize="11" Foreground="#8B949E" />
                    <TextBlock Text="Railway Cloud Active + Local LAN Mirror Active" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,16,0" />
                    <TextBlock Text="Event Stream: " FontSize="11" Foreground="#8B949E" />
                    <TextBlock Text="Real-Time Zero-Click Active" FontSize="11" FontWeight="SemiBold" Foreground="#3FB950" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VeloxManager 1.0.0 — Velox Depot Operations" FontSize="10" Foreground="#8B949E" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
