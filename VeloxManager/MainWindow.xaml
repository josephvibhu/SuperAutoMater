<Window x:Class="VeloxManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:VeloxManager.Converters"
        mc:Ignorable="d"
        Title="Velox Manager — Depot Inventory &amp; Fleet Operations Cockpit" 
        Height="940" Width="1600"
        MinHeight="640" MinWidth="1024"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TokenBgAppBrush}"
        Foreground="{DynamicResource TokenTextPrimaryBrush}"
        FontFamily="{StaticResource FontSans}">

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleNavCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenQuickIntakeDrawerCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportExcelCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshAssetsCommand}" />
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding NavigateToTabCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding NavigateToTabCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding NavigateToTabCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Alt" Command="{Binding NavigateToTabCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Alt" Command="{Binding NavigateToTabCommand}" CommandParameter="4" />
        <KeyBinding Key="Escape" Command="{Binding CloseQuickIntakeDrawerCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:BoolToColorBrushConverter x:Key="BoolColor" />
        <conv:BoolToStatusTextConverter x:Key="BoolStatus" />
        <conv:InvoiceTypeToBrushConverter x:Key="InvTypeBrush" />
        <conv:InvoiceTypeToStringConverter x:Key="InvTypeString" />

        <!-- Metric Box Style -->
        <Style x:Key="HeaderMetric" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TokenBgCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- Left Nav Rail Button Style -->
        <Style x:Key="NavRailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TokenBgHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Tab Filter Button Style -->
        <Style x:Key="StatusTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextMutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Top Bar 52px -->
            <RowDefinition Height="52" />
            <!-- 1: Navigation & Content Flexible -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Status Strip 30px -->
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ── TOP BAR (52 PX) ────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Logo & Wordmark -->
                    <ColumnDefinition Width="220" />
                    <!-- Center: Global Search -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Connectivity, Actions & User -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Official Vector Logo & Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Vector Mark (exact match to velox-manager SVG) -->
                    <Viewbox Width="32" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Canvas Width="50" Height="44">
                            <Path Data="M 7,5 L 22,39 L 32,16" Fill="{x:Null}" Stroke="{DynamicResource TokenTextPrimaryBrush}" StrokeThickness="9" StrokeLineJoin="Bevel" />
                            <Path Data="M 27,27.5 L 32,16" Fill="{x:Null}" Stroke="{DynamicResource TokenAppManagerBrush}" StrokeThickness="9" />
                            <Path Data="M 37.65,14.5 V 2.95 L 42.1,9.2 L 46.55,2.95 V 14.5" Fill="{x:Null}" Stroke="{DynamicResource TokenAppManagerBrush}" StrokeThickness="2.9" StrokeLineJoin="Bevel" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="VELOX" FontWeight="ExtraBold" FontSize="17" Foreground="{DynamicResource TokenTextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="MANAGER" FontWeight="Normal" FontSize="17" Foreground="{DynamicResource TokenAppManagerBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Global Search Field (Ctrl+K) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Height="34"
                        Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" x:Name="GlobalSearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TokenTextPrimaryBrush}"
                                 VerticalAlignment="Center" FontSize="12" Padding="0" />
                        <TextBlock Grid.Column="1" Text="Search assets, serials, tags, jobs..." FontSize="12" Foreground="{DynamicResource TokenTextMutedBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Grid.Column="2" Background="{DynamicResource TokenBgCardBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+K" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TokenTextMutedBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: Cloud Status Chip, Theme Toggle & User Menu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Cloud Status Chip -->
                    <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Cloud Database Sync Status (Railway Cloud)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CloudStatusText}" FontWeight="Bold" FontSize="10" Foreground="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" />
                        </StackPanel>
                    </Border>

                    <!-- Instant Theme Quick-Toggle Button -->
                    <Button Command="{Binding ToggleThemeCommand}" ToolTip="Toggle Dark / Light Theme" Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,6,0" Cursor="Hand">
                        <TextBlock Text="🌓" FontSize="15" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                    </Button>

                    <!-- Notifications / Activity Button -->
                    <Button Command="{Binding NavigateToTabCommand}" CommandParameter="1" ToolTip="Live Fleet Stream &amp; Activity (Alt+2)" Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,6,0" Cursor="Hand">
                        <TextBlock Text="🔔" FontSize="14" Foreground="{DynamicResource TokenTextMutedBrush}" />
                    </Button>

                    <!-- User Profile & Settings Menu -->
                    <Border Background="{DynamicResource TokenBgCardBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="6,3" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource TokenBrandSubtleBrush}" Margin="0,0,6,0">
                                <TextBlock Text="DM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Depot Manager" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource TokenSuccessBrush}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>

                            <!-- User Dropdown Menu Button -->
                            <Button Background="Transparent" BorderThickness="0" Padding="4,0" Margin="2,0,0,0" Cursor="Hand">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Operations Manager (Pro Account)" IsEnabled="False" FontWeight="Bold" />
                                        <Separator />
                                        <MenuItem Header="🌙 Theme: Dark Mode" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                                        <MenuItem Header="☀️ Theme: Light Mode" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                                        <MenuItem Header="🖥 Theme: Windows System Sync" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                                        <Separator />
                                        <MenuItem Header="🌐 Open VeloxShowroom Web Portal" Command="{Binding OpenShowroomWebCommand}" />
                                        <MenuItem Header="💾 Cloud Database Operations..." Command="{Binding OpenCloudOperationsCommand}" />
                                        <MenuItem Header="⚙ Settings &amp; LAN Server" Command="{Binding NavigateToTabCommand}" CommandParameter="4" />
                                        <Separator />
                                        <MenuItem Header="Shortcuts: Ctrl+K Search • Ctrl+B Menu • Ctrl+N New • F5 Refresh" IsEnabled="False" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── ROW 1: LEFT NAVIGATION + MAIN CONTENT WORKSPACE ────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Nav Rail (Width bound to NavRailWidth, 216 or 56) -->
                <ColumnDefinition Width="{Binding NavRailWidth}" />
                <!-- Content Workspace -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT NAVIGATION RAIL ──────────────────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="8,12,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Menu Items -->
                    <StackPanel Grid.Row="0">
                        <!-- Group: OPERATIONS -->
                        <TextBlock Text="OPERATIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="8,0,0,8"
                                   Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />

                        <!-- Nav 0: Asset Inventory -->
                        <Button Style="{StaticResource NavRailButton}" Command="{Binding NavigateToTabCommand}" CommandParameter="0" ToolTip="Asset Inventory (Alt+1)" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📦" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Asset inventory" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                                <Border Grid.Column="2" Background="{DynamicResource TokenBgInsetBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}">
                                    <TextBlock Text="{Binding AllCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenBrandBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Nav 1: Bench Fleet Ops -->
                        <Button Style="{StaticResource NavRailButton}" Command="{Binding NavigateToTabCommand}" CommandParameter="1" ToolTip="Bench Fleet Ops (Alt+2)" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="14" Foreground="{DynamicResource TokenBrandBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Bench fleet ops" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                                <Border Grid.Column="2" Background="{DynamicResource TokenBgInsetBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}">
                                    <TextBlock Text="{Binding OnBenchCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenWarningBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Nav 2: Technicians & Jobs -->
                        <Button Style="{StaticResource NavRailButton}" Command="{Binding NavigateToTabCommand}" CommandParameter="2" ToolTip="Technicians &amp; Jobs (Alt+3)" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="👥" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Technicians &amp; jobs" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                            </Grid>
                        </Button>

                        <!-- Nav 3: Billing & Financials -->
                        <Button Style="{StaticResource NavRailButton}" Command="{Binding NavigateToTabCommand}" CommandParameter="3" ToolTip="Billing &amp; Financials (Alt+4)" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🧾" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Billing &amp; financials" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                            </Grid>
                        </Button>

                        <!-- Group: SYSTEM -->
                        <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="8,16,0,8"
                                   Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />

                        <!-- Nav: Cloud DB Ops -->
                        <Button Style="{StaticResource NavRailButton}" Command="{Binding OpenCloudOperationsCommand}" ToolTip="Cloud Database Operations (Backup, Restore, Purge)" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="☁" FontSize="14" Foreground="{DynamicResource TokenInfoBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Cloud DB ops" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                            </Grid>
                        </Button>

                        <!-- Nav 4: Settings & LAN Server -->
                        <Button Style="{StaticResource NavRailButton}" Command="{Binding NavigateToTabCommand}" CommandParameter="4" ToolTip="Settings &amp; LAN Server (Alt+5)" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚙" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Settings &amp; LAN" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Footer: Open Showroom & Collapse Menu -->
                    <StackPanel Grid.Row="1">
                        <Separator Margin="0,4,0,8" />

                        <!-- Open Showroom (External Link) -->
                        <Button Style="{StaticResource NavRailButton}" Command="{Binding OpenShowroomWebCommand}" ToolTip="Open VeloxShowroom Storefront in Web Browser" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🌐" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Open Showroom" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                                <TextBlock Grid.Column="2" Text="↗" FontSize="12" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                            </Grid>
                        </Button>

                        <!-- Collapse / Expand Menu Button (Ctrl+B) -->
                        <Button Style="{StaticResource NavRailButton}" Command="{Binding ToggleNavCommand}" ToolTip="Collapse / Expand Menu (Ctrl+B)" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="◀" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Collapse menu" FontSize="12" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding IsNavExpanded, Converter={StaticResource NullVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── MAIN CONTENT WORKSPACE (TAB CONTROL) ─────────────────────── -->
            <Grid Grid.Column="1">
                <TabControl Background="{DynamicResource TokenBgAppBrush}" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <!-- TAB 0: ASSET INVENTORY (THE CORE SCREEN)                            -->
                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="Asset Inventory">
                        <Grid Margin="20,16,20,16">
                            <Grid.RowDefinitions>
                                <!-- 0: Page Header with Single Primary Action -->
                                <RowDefinition Height="Auto" />
                                <!-- 1: Status Tabs with Counts -->
                                <RowDefinition Height="Auto" />
                                <!-- 2: Filter Row -->
                                <RowDefinition Height="Auto" />
                                <!-- 3: Bulk Action Bar (Revealed on selection) -->
                                <RowDefinition Height="Auto" />
                                <!-- 4: Main Content (Table + Inspector) -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- ── 0: PAGE HEADER ────────────────────────────────────────── -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Title and Subtitle -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Asset inventory" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                    <TextBlock Text="Depot inventory pipeline, hardware grading and component fitted BOM tracking" FontSize="12.5" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Header Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Refresh Ghost Button -->
                                    <Button Command="{Binding RefreshAssetsCommand}" ToolTip="Refresh asset data from Cloud DB" Background="Transparent" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                                            <TextBlock Text="Refresh" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Import Secondary Button -->
                                    <Button Command="{Binding ImportExcelCommand}" ToolTip="Import manifest from Excel (.xlsx) or CSV (.csv)" Background="{DynamicResource TokenBgCardBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Padding="12,6" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📥" Margin="0,0,6,0" />
                                            <TextBlock Text="Import" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Single Primary Action: + Add asset -->
                                    <Button Command="{Binding OpenQuickIntakeDrawerCommand}" ToolTip="Quickly intake an asset or component into Depot DB (Ctrl+N)" Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="➕" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="Add asset" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ── 1: STATUS TABS WITH LIVE COUNTS ───────────────────────── -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Tab: All Assets -->
                                    <Button Style="{StaticResource StatusTabButton}" Command="{Binding SelectStatusTabCommand}" CommandParameter="ALL">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="All assets" />
                                            <Border Background="{DynamicResource TokenBgInsetBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding AllCount}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab: Intake -->
                                    <Button Style="{StaticResource StatusTabButton}" Command="{Binding SelectStatusTabCommand}" CommandParameter="INTAKE">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Intake" />
                                            <Border Background="{DynamicResource TokenBgInsetBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding IntakeCount}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab: On Bench -->
                                    <Button Style="{StaticResource StatusTabButton}" Command="{Binding SelectStatusTabCommand}" CommandParameter="ON_BENCH">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="On bench" />
                                            <Border Background="{DynamicResource TokenBgInsetBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding OnBenchCount}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab: Ready -->
                                    <Button Style="{StaticResource StatusTabButton}" Command="{Binding SelectStatusTabCommand}" CommandParameter="READY">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Ready" />
                                            <Border Background="{DynamicResource TokenSuccessBgBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding ReadyCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TokenSuccessBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab: Reserved -->
                                    <Button Style="{StaticResource StatusTabButton}" Command="{Binding SelectStatusTabCommand}" CommandParameter="RESERVED">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Reserved" />
                                            <Border Background="{DynamicResource TokenBgInsetBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding ReservedCount}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab: Sold -->
                                    <Button Style="{StaticResource StatusTabButton}" Command="{Binding SelectStatusTabCommand}" CommandParameter="SOLD">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Sold" />
                                            <Border Background="{DynamicResource TokenBgInsetBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SoldCount}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ── 2: FILTER ROW ─────────────────────────────────────────── -->
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Local Search Input (300px) -->
                                <Border Grid.Column="0" Width="300" Height="32" Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,0" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TokenTextPrimaryBrush}" VerticalAlignment="Center" FontSize="12" Padding="0" />
                                    </Grid>
                                </Border>

                                <!-- Dropdown Filter Controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Category:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="32" Margin="0,0,12,0" IsReadOnly="True">
                                        <ComboBoxItem Content="ALL" IsSelected="True" />
                                        <ComboBoxItem Content="LAPTOPS" />
                                        <ComboBoxItem Content="RAM" />
                                        <ComboBoxItem Content="STORAGE" />
                                        <ComboBoxItem Content="CHARGERS" />
                                        <ComboBoxItem Content="PERIPHERALS" />
                                        <ComboBoxItem Content="REPAIR SPARES" />
                                    </ComboBox>

                                    <TextBlock Text="Status:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="32" IsReadOnly="True" Margin="0,0,12,0">
                                        <ComboBoxItem Content="ALL" IsSelected="True" />
                                        <ComboBoxItem Content="READY_FOR_SALE" />
                                        <ComboBoxItem Content="INTAKE" />
                                        <ComboBoxItem Content="ON_BENCH" />
                                        <ComboBoxItem Content="TESTING" />
                                        <ComboBoxItem Content="REPAIR" />
                                        <ComboBoxItem Content="RESERVED" />
                                        <ComboBoxItem Content="SOLD" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Secondary Actions: Mass Update & Sync Sheets -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenMassUpdateCommand}" Background="{DynamicResource TokenBgCardBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,0" ToolTip="Batch update status, grades, locations, or customers">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" Margin="0,0,4,0" />
                                            <TextBlock Text="Mass update" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding SyncGoogleSheetsCommand}" Background="{DynamicResource TokenBgCardBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Padding="10,6" ToolTip="Export ITAM spreadsheet &amp; sync to Google Sheets">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊" Margin="0,0,4,0" />
                                            <TextBlock Text="Sync sheets / Backup" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ── 3: BULK ACTION BAR (Visible when rows are selected) ───── -->
                            <Border Grid.Row="3" Background="{DynamicResource TokenBrandSubtleBrush}" BorderBrush="{DynamicResource TokenBrandBrush}" BorderThickness="1" CornerRadius="8" Height="42" Padding="14,0" Margin="0,0,0,10"
                                    Visibility="{Binding HasBulkSelection, Converter={StaticResource NullVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCountText}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TokenBrandBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <Button Content="⚡ Mass update" Command="{Binding OpenMassUpdateCommand}" Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0" Padding="10,4" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" />
                                        <Button Content="📊 Sync &amp; Backup" Command="{Binding SyncGoogleSheetsCommand}" Background="{DynamicResource TokenBgPanelBrush}" Foreground="{DynamicResource TokenTextPrimaryBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Padding="10,4" FontSize="11" Margin="0,0,8,0" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="✕ Clear selection" Command="{Binding ClearSelectionCommand}" Background="Transparent" Foreground="{DynamicResource TokenTextMutedBrush}" BorderThickness="0" Padding="8,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- ── 4: TABLE + INSPECTOR DUAL-COLUMN PANE ─────────────────── -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <!-- Table Area (Flexible) -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Splitter / Gap -->
                                    <ColumnDefinition Width="14" />
                                    <!-- Inspector Panel (360px) -->
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <!-- Table Card (CornerRadius 12px) -->
                                <Border Grid.Column="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="1">
                                    <DataGrid ItemsSource="{Binding FilteredAssets}" 
                                              SelectedItem="{Binding SelectedAsset}"
                                              AutoGenerateColumns="False" 
                                              IsReadOnly="True" 
                                              CanUserSortColumns="True"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{DynamicResource TokenBorderSubtleBrush}"
                                              Background="Transparent" 
                                              RowBackground="{DynamicResource TokenBgPanelBrush}" 
                                              AlternatingRowBackground="{DynamicResource TokenBgAppBrush}"
                                              Foreground="{DynamicResource TokenTextPrimaryBrush}" 
                                              BorderThickness="0"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single">

                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Setter Property="ContextMenu">
                                                    <Setter.Value>
                                                        <ContextMenu>
                                                            <MenuItem Header="⚡ Quick Mark as SOLD" Command="{Binding DataContext.QuickMarkSoldCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" FontWeight="Bold" />
                                                            <MenuItem Header="✅ Quick Mark as READY FOR SALE" Command="{Binding DataContext.QuickMarkRtsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Foreground="{DynamicResource TokenSuccessBrush}" />
                                                            <MenuItem Header="🔧 Quick Mark as ACTIVE TESTING" Command="{Binding DataContext.QuickMarkWipCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Foreground="{DynamicResource TokenInfoBrush}" />
                                                            <Separator />
                                                            <MenuItem Header="🔄 Reassign to Technician..." Command="{Binding DataContext.ReassignAssignedAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="📦 Unassign (Return to Depot Pool)" Command="{Binding DataContext.UnassignAssignedAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="📋 Copy Asset Tag" Command="{Binding DataContext.CopyAssetTagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="📋 Copy Serial Number" Command="{Binding DataContext.CopySerialNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="🗑 Delete Asset from DB" Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Foreground="{DynamicResource TokenDangerBrush}" />
                                                        </ContextMenu>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGrid.RowStyle>

                                        <DataGrid.Columns>
                                            <!-- Checkbox Column -->
                                            <DataGridTemplateColumn Width="32">
                                                <DataGridTemplateColumn.Header>
                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Tag Column -->
                                            <DataGridTemplateColumn Header="TAG" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding AssetTag}" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" Foreground="{DynamicResource TokenBrandBrush}" VerticalAlignment="Center" Margin="6,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Serial / Part # Column -->
                                            <DataGridTemplateColumn Header="SERIAL / PART #" Width="125">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding SerialNumber}" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" Margin="6,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Model / Description Column -->
                                            <DataGridTemplateColumn Header="MODEL / DESCRIPTION" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="6,4">
                                                            <TextBlock Text="{Binding ModelName}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TokenTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding QuantityDisplay, StringFormat='Stock: {0}'}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Category Column -->
                                            <DataGridTemplateColumn Header="CATEGORY" Width="95">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource TokenBgInsetBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding CategoryIcon}" Margin="0,0,4,0" FontSize="11" />
                                                                <TextBlock Text="{Binding CategoryBadge}" FontWeight="Bold" FontSize="10" Foreground="{Binding CategoryColorHex, Converter={StaticResource HexBrush}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Status Column -->
                                            <DataGridTemplateColumn Header="STATUS" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding StatusColorHex, Converter={StaticResource HexBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                            <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Grade Column (Dot + Letter) -->
                                            <DataGridTemplateColumn Header="GRADE" Width="65">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding GradeDotColorHex, Converter={StaticResource HexBrush}}" Margin="0,0,5,0" />
                                                            <TextBlock Text="{Binding GradeLetter}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Assigned Technician -->
                                            <DataGridTextColumn Header="ASSIGNED TO" Binding="{Binding AssignedEmployeeName}" Width="115" />

                                            <!-- Disk Health Column -->
                                            <DataGridTemplateColumn Header="DISK HEALTH" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DiskHealthDisplay}" FontWeight="Bold" FontSize="11" Foreground="{Binding DiskHealthColorHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" Margin="6,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Shelf / Box # -->
                                            <DataGridTemplateColumn Header="SHELF / BOX" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding CurrentLocation}" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" Margin="6,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- ── INSPECTOR PANEL (360 PX) ─────────────────────────── -->
                                <Border Grid.Column="2" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <Grid>
                                        <!-- Empty state when no row selected -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding HasSelectedAsset, Converter={StaticResource NullVis}, ConverterParameter=invert}">
                                            <TextBlock Text="🔍" FontSize="28" Foreground="{DynamicResource TokenTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <TextBlock Text="Select an asset to see details" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TokenTextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Inspect fitted BOM, QC reports, and assign jobs." FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" TextAlignment="Center" />
                                        </StackPanel>

                                        <!-- Active Asset Inspector -->
                                        <Grid Visibility="{Binding HasSelectedAsset, Converter={StaticResource NullVis}}">
                                            <Grid.RowDefinitions>
                                                <!-- Header -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Inspector Content (Tabs) -->
                                                <RowDefinition Height="*" />
                                                <!-- Bottom Contextual Action -->
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 8.1 Header: Tag, Status Chip, Grade, Model & Serial -->
                                            <Border Grid.Row="0" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding SelectedAsset.AssetTag}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TokenBrandBrush}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{Binding SelectedAsset.StatusColorHex, Converter={StaticResource HexBrush}}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding SelectedAsset.StatusBadge}" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF" />
                                                            </Border>
                                                            <Ellipse Width="6" Height="6" Fill="{Binding SelectedAsset.GradeDotColorHex, Converter={StaticResource HexBrush}}" Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding SelectedAsset.GradeLetter}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SelectedAsset.ModelName}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TokenTextPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedAsset.SerialNumber, StringFormat='S/N: {0}'}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 8.2 Inspector Tabs: Details & Fitted BOM -->
                                            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                                                <!-- TAB: DETAILS -->
                                                <TabItem Header="Details">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                                        <StackPanel>
                                                            <!-- Shelf Location -->
                                                            <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="📍 SHELF / BOX #" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                                                        <TextBox Text="{Binding SelectedAsset.CurrentLocation, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TokenBrandBrush}" FontWeight="Bold" FontSize="12" Padding="0" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="💾 Save" Command="{Binding UpdateSelectedAssetLocationCommand}" CommandParameter="{Binding SelectedAsset.CurrentLocation}" Background="{DynamicResource TokenBgCardBrush}" Foreground="{DynamicResource TokenTextPrimaryBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Padding="8,3" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Quick Status Mutations -->
                                                            <TextBlock Text="LIFECYCLE STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,6" />
                                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                                <Button Content="READY FOR SALE" Command="{Binding UpdateStatusCommand}" CommandParameter="ReadyForSale" Background="{DynamicResource TokenSuccessBgBrush}" Foreground="{DynamicResource TokenSuccessBrush}" BorderBrush="{DynamicResource TokenSuccessBorderBrush}" BorderThickness="1" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                                <Button Content="ACTIVE TESTING" Command="{Binding UpdateStatusCommand}" CommandParameter="ActiveTesting" Background="{DynamicResource TokenInfoBgBrush}" Foreground="{DynamicResource TokenInfoBrush}" BorderBrush="{DynamicResource TokenInfoBorderBrush}" BorderThickness="1" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                                <Button Content="IN REPAIR" Command="{Binding UpdateStatusCommand}" CommandParameter="InHouseRepair" Background="{DynamicResource TokenWarningBgBrush}" Foreground="{DynamicResource TokenWarningBrush}" BorderBrush="{DynamicResource TokenWarningBorderBrush}" BorderThickness="1" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                                <Button Content="MARK SOLD" Command="{Binding UpdateStatusCommand}" CommandParameter="Sold" Background="{DynamicResource TokenBgInsetBrush}" Foreground="{DynamicResource TokenTextMutedBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                            </UniformGrid>

                                                            <!-- Technician Dispatch -->
                                                            <TextBlock Text="DISPATCH TO TECHNICIAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,6" />
                                                            <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" DisplayMemberPath="Name" Margin="0,0,0,6" />
                                                                    <Button Content="⚡ Assign to Technician" Command="{Binding AssignToEmployeeCommand}" Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Padding="8,5" FontSize="11" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Financial Summary -->
                                                            <TextBlock Text="COMMERCIAL MARGIN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,6" />
                                                            <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="PURCHASE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                                                            <TextBlock Text="{Binding SelectedAsset.PurchasePrice, StringFormat='₹{0:N0}', TargetNullValue='₹0'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="SALE / PROJ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                                                            <TextBlock Text="{Binding SelectedAsset.SalePrice, StringFormat='₹{0:N0}', TargetNullValue='Unpriced'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TokenBrandBrush}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding SelectedAsset.MarginBadgeText, StringFormat='Estimated Gross: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SelectedAsset.MarginColorHex, Converter={StaticResource HexBrush}}" Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </TabItem>

                                                <!-- TAB: FITTED BOM -->
                                                <TabItem Header="Fitted BOM">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                                        <StackPanel>
                                                            <!-- Items List -->
                                                            <TextBlock Text="UPGRADES &amp; INSTALLED PARTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,6" />
                                                            <ItemsControl ItemsSource="{Binding SelectedAssetFittedComponents}" Margin="0,0,0,8">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0">
                                                                                    <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                                                                    <TextBlock Text="{Binding PriceDeltaDisplay}" FontSize="10" Foreground="{DynamicResource TokenSuccessBrush}" FontWeight="Bold" />
                                                                                </StackPanel>
                                                                                <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.DetachBomComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource TokenDangerBrush}" BorderThickness="0" Padding="6,2" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Attach Component -->
                                                            <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                                                <StackPanel>
                                                                    <TextBlock Text="➕ Attach Component" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TokenBrandBrush}" Margin="0,0,0,6" />
                                                                    <ComboBox ItemsSource="{Binding BomCategoryOptions}" SelectedItem="{Binding NewBomCategory}" Margin="0,0,0,6" />
                                                                    <TextBox Text="{Binding NewBomDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="Component spec (e.g. 16GB RAM, 512GB SSD)" Margin="0,0,0,6" />
                                                                    <Button Content="Attach to Machine" Command="{Binding AttachBomComponentCommand}" Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Padding="8,4" FontSize="11" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </TabItem>
                                            </TabControl>

                                            <!-- 8.3 Contextual Primary Action Button -->
                                            <Border Grid.Row="2" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                                                <Button Content="🧾 Create Tax Invoice &amp; Bill" Command="{Binding NavigateToTabCommand}" CommandParameter="3"
                                                        Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Padding="12,8" FontSize="12" HorizontalAlignment="Stretch" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <!-- TAB 1: BENCH FLEET OPS                                              -->
                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="Bench Fleet Ops">
                        <Grid Margin="20,16,20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="LIVE DIAGNOSTIC BENCHES &amp; WORKSTATION STREAM" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                    <TextBlock Text="Real-time telemetry and intake events broadcasted from active diagnostic bench clients via Railway SSE &amp; LAN Mirror port 9000."
                                               FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Real-Time Activity Log List -->
                            <Border Grid.Row="1" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <ListBox ItemsSource="{Binding LiveActivityFeed}" Background="{DynamicResource TokenBgInsetBrush}" Foreground="{DynamicResource TokenSuccessBrush}" FontFamily="{StaticResource FontMono}" FontSize="12" BorderThickness="0" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <!-- TAB 2: TECHNICIANS & JOBS                                           -->
                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="Technicians &amp; Jobs">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="220" MinHeight="160" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" MinHeight="280" />
                            </Grid.RowDefinitions>

                            <!-- Top: Technicians Roster -->
                            <Border Grid.Row="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="DEPOT TECHNICIANS &amp; BENCH OPERATORS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TokenTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Employees.Count, StringFormat='{}{0} Registered'}" FontSize="11" Foreground="{DynamicResource TokenBrandBrush}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource TokenTextPrimaryBrush}" BorderThickness="0" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" FontWeight="Bold" Width="140" />
                                            <DataGridTextColumn Header="STATION" Binding="{Binding BenchStation}" Width="110" />
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding IsActive, Converter={StaticResource BoolStatus}}" Width="80" />
                                            <DataGridTextColumn Header="PASS PIN" Binding="{Binding PinCode}" FontFamily="{StaticResource FontMono}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource TokenBorderSubtleBrush}" />

                            <!-- Bottom: Assigned Jobs & History -->
                            <Border Grid.Row="2" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="BENCH WORK QUEUE &amp; PRODUCTIVITY" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,0,8" />
                                    <TextBlock Text="Select a technician above to view assigned machines and inspection history." FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <!-- TAB 3: BILLING & FINANCIALS                                         -->
                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="Billing &amp; Financials">
                        <Grid Margin="20,16,20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Financial Summary KPI Banner -->
                            <Border Grid.Row="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DEPOT INVENTORY COST" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                        <TextBlock Text="{Binding DepotInventoryCostValue, StringFormat='₹{0:N0}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PROJECTED SALE VALUE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                        <TextBlock Text="{Binding DepotProjectedSaleValue, StringFormat='₹{0:N0}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TokenBrandBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PROJECTED GROSS MARGIN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                        <TextBlock Text="{Binding DepotProjectedMarginValue, StringFormat='₹{0:N0}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TokenSuccessBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="MARGIN PERCENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" />
                                        <TextBlock Text="{Binding DepotMarginPercent, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TokenInfoBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Invoicing Workspace -->
                            <Border Grid.Row="1" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="420" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Invoice Draft Generator -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TAX INVOICE GENERATOR" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TokenBrandBrush}" Margin="0,0,0,8" />
                                        <TextBlock Text="Client Name:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding DraftPartyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                        <TextBlock Text="Phone:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding DraftPartyPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                        <TextBlock Text="Address:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding DraftPartyAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                        <TextBlock Text="Payment Mode:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding DraftPaymentMode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                        <Button Content="{Binding GenerateInvoiceButtonText}" Command="{Binding GenerateInvoiceCommand}" Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Padding="12,8" FontSize="12" />
                                    </StackPanel>

                                    <!-- Right: Recent Invoices List -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RECENT INVOICES &amp; BILLS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,0,8" />
                                        <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource TokenTextPrimaryBrush}" BorderThickness="0" HeadersVisibility="Column" Height="400">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" FontWeight="Bold" Width="120" />
                                                <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100" />
                                                <DataGridTextColumn Header="CLIENT" Binding="{Binding CustomerName}" Width="*" />
                                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat='₹{0:N0}'}" FontWeight="Bold" Width="100" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <!-- TAB 4: SETTINGS & LAN SERVER                                        -->
                    <!-- ═══════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="Settings &amp; LAN">
                        <Grid Margin="20,16,20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="520" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MaxWidth="560" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Depot Config & LAN Mirror -->
                            <Border Grid.Column="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="VELOX DEPOT CONFIGURATION" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,0,14" />
                                    <TextBlock Text="Depot Site Code:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="MAIN" IsReadOnly="True" Margin="0,0,0,12" />
                                    <TextBlock Text="LAN Mirror HTTP Port:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="9000" IsReadOnly="True" Margin="0,0,0,16" />
                                    <Button Content="⚡ Restart Local LAN Mirror Server" Command="{Binding ToggleLanServerCommand}" Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Padding="12,8" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Right: Cloud Database Operations -->
                            <Border Grid.Column="2" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="CLOUD DATABASE OPERATIONS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,0,14" />
                                    <TextBlock Text="Backup, restore, and maintain cloud state on Railway." FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,16" />
                                    <Button Content="💾 Export Database Backup (JSON)" Command="{Binding BackupCloudDatabaseCommand}" Background="{DynamicResource TokenBgCardBrush}" Foreground="{DynamicResource TokenTextPrimaryBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Padding="12,8" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Button Content="📥 Restore From Backup File" Command="{Binding RestoreCloudDatabaseCommand}" Background="{DynamicResource TokenBgCardBrush}" Foreground="{DynamicResource TokenTextPrimaryBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" Padding="12,8" FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <Button Content="🗑 Purge Test Data (Reset to 0)" Command="{Binding PurgeCloudDatabaseCommand}" Background="{DynamicResource TokenDangerBgBrush}" Foreground="{DynamicResource TokenDangerBrush}" BorderBrush="{DynamicResource TokenDangerBorderBrush}" BorderThickness="1" Padding="12,8" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- ── 9: QUICK INTAKE DRAWER (Overlaid flyout from the right) ──── -->
                <Grid Visibility="{Binding IsQuickIntakeOpen, Converter={StaticResource NullVis}}" SnapsToDevicePixels="True">
                    <!-- Dimmed Backdrop -->
                    <Border Background="#80000000" MouseDown="OnDrawerBackdropMouseDown" />

                    <!-- Drawer Container (480px) -->
                    <Border Width="480" HorizontalAlignment="Right" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1,0,0,0" Padding="24,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Drawer Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Add asset / Quick intake" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TokenTextPrimaryBrush}" />
                                    <TextBlock Text="Scanner ready: barcode, laptop or spare parts" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Command="{Binding CloseQuickIntakeDrawerCommand}" Background="Transparent" Foreground="{DynamicResource TokenTextMutedBrush}" BorderThickness="0" Padding="6" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                    <TextBlock Text="✕" />
                                </Button>
                            </DockPanel>

                            <!-- Drawer Form Fields -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Serial / Barcode (Scanner-friendly first field) -->
                                    <TextBlock Text="SERIAL NUMBER / BARCODE (AUTO-DETECT)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenBrandBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding QuickIntakeSerial, UpdateSourceTrigger=PropertyChanged}" ToolTip="Scan hardware barcode or type serial" FontSize="13" Padding="8,6" Margin="0,0,0,12" />

                                    <!-- Category -->
                                    <TextBlock Text="HARDWARE CATEGORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding QuickIntakeCategories}" SelectedItem="{Binding QuickIntakeCategory}" Height="34" Margin="0,0,0,12" />

                                    <!-- Model / Description -->
                                    <TextBlock Text="MODEL / DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding QuickIntakeModel, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. ThinkPad T480s i5-8350U, Samsung 8GB DDR4, 512GB NVMe" FontSize="13" Padding="8,6" Margin="0,0,0,12" />

                                    <!-- Quantity and Shelf Location -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="QUANTITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding QuickIntakeQuantity, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SHELF / BOX #" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding QuickIntakeLocation, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. Shelf A-1, Bin 04" FontSize="13" Padding="8,6" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Pricing: Unit Cost & Sale Price -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="UNIT COST (₹)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding QuickIntakePurchasePrice, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SALE PRICE (₹)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding QuickIntakeSalePrice, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Notes / Memo -->
                                    <TextBlock Text="MEMO / SOURCE NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding QuickIntakeNotes, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,6" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,16" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Drawer Footer: Save and Add Another & Save and Close -->
                            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                <Button Content="📥 Save &amp; Add Another" Command="{Binding QuickIntakeCommand}" Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Padding="14,10" FontSize="13" Margin="0,0,0,8" />
                                <Button Content="✓ Save &amp; Close" Command="{Binding QuickIntakeCommand}" Background="{DynamicResource TokenBgCardBrush}" Foreground="{DynamicResource TokenTextPrimaryBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" FontWeight="SemiBold" Padding="14,8" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── FOOTER STATUS BAR (30 PX) ──────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Cloud Indicator -->
                    <Ellipse Width="6" Height="6" Fill="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CloudStatusText}" FontSize="11" Foreground="{DynamicResource TokenTextSecondaryBrush}" Margin="0,0,18,0" />

                    <!-- LAN Mirror Indicator -->
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TokenInfoBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding LanStatusText}" FontSize="11" Foreground="{DynamicResource TokenTextSecondaryBrush}" Margin="0,0,18,0" />

                    <!-- SSE Event Stream Indicator -->
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TokenSuccessBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="Event stream: Live SSE" FontSize="11" Foreground="{DynamicResource TokenSuccessBrush}" />
                </StackPanel>

                <!-- App Version -->
                <TextBlock Grid.Column="1" Text="Velox Manager v2.4.0-beta • Velox Depot Suite" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
