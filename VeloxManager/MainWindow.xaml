<Window x:Class="VeloxManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:VeloxManager.Converters"
        mc:Ignorable="d"
        Title="VeloxManager — Asset Inventory &amp; Fleet Operations Cockpit" 
        Height="720" Width="1200"
        MinHeight="550" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C10"
        Foreground="#F0F6FC"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:BoolToColorBrushConverter x:Key="BoolColor" />
        <conv:BoolToStatusTextConverter x:Key="BoolStatus" />
        <conv:InvoiceTypeToBrushConverter x:Key="InvTypeBrush" />
        <conv:InvoiceTypeToStringConverter x:Key="InvTypeString" />

        <!-- Metric Box Style -->
        <Style x:Key="HeaderMetric" TargetType="Border">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CaretBrush" Value="#58A6FF" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Dark TabControl Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#58A6FF" />
                                <Setter TargetName="border" Property="Background" Value="#21262D" />
                                <Setter Property="Foreground" Value="#F0F6FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Real-Time Indicators -->
            <RowDefinition Height="Auto" />
            <!-- 1: Navigation & Content -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Status Strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── TOP HEADER BAR ────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="24" Foreground="#58A6FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VELOX" FontWeight="Bold" FontSize="19" Foreground="#58A6FF" />
                            <TextBlock Text="MANAGER" FontWeight="Light" FontSize="19" Foreground="#F0F6FC" Margin="6,0,0,0" />
                            <Border Background="#238636" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LIVE DEPOT COCKPIT" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Warehouse Asset Inventory, Dispatch, Fleet &amp; Billing Engine" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Pills & Metrics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Cloud Indicator -->
                    <Border Background="#0D1117" BorderBrush="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CloudStatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" />
                        </StackPanel>
                    </Border>

                    <!-- LAN Indicator -->
                    <Border Background="#0D1117" BorderBrush="{Binding LanStatusColor, Converter={StaticResource HexBrush}}" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding LanStatusColor, Converter={StaticResource HexBrush}}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LanStatusText}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding LanStatusColor, Converter={StaticResource HexBrush}}" />
                        </StackPanel>
                    </Border>

                    <!-- KPI Badges -->
                    <Border Style="{StaticResource HeaderMetric}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TOTAL: " FontSize="11" Foreground="#8B949E" />
                            <TextBlock Text="{Binding TotalAssetsCount}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HeaderMetric}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WIP: " FontSize="11" Foreground="#8B949E" />
                            <TextBlock Text="{Binding WipCount}" FontWeight="Bold" FontSize="12" Foreground="#58A6FF" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HeaderMetric}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="READY TO SELL: " FontSize="11" Foreground="#8B949E" />
                            <TextBlock Text="{Binding ReadyForSaleCount}" FontWeight="Bold" FontSize="12" Foreground="#3FB950" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenShowroomWebCommand}"
                            Background="#1F6FEB" Foreground="#FFFFFF" BorderBrush="#388BFD" BorderThickness="1"
                            Padding="12,6" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"
                            ToolTip="Open the read-only VeloxShowroom portal for Sales &amp; Media teams in default browser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,6,0" />
                            <TextBlock Text="VeloxShowroom" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportExcelCommand}"
                            Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043" BorderThickness="1"
                            Padding="12,6" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"
                            ToolTip="Upload an Excel (.xlsx) or CSV (.csv) manifest of assets directly into the database">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" Margin="0,0,6,0" />
                            <TextBlock Text="Import Excel / CSV" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCsvCommand}"
                            Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                            Padding="12,6" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"
                            ToolTip="Export current asset inventory to CSV spreadsheet file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,6,0" />
                            <TextBlock Text="Export CSV" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshAssetsCommand}"
                            Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                            Padding="12,6" FontWeight="SemiBold" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh Assets" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── TAB CONTROL / MAIN WORKSPACE ───────────────────────────────────── -->
        <TabControl Grid.Row="1" Background="#0A0C10" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 0: ASSET INVENTORY COCKPIT (THE CORE PAGE)                      -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="📦 ASSET INVENTORY">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Top Filter / Search Bar -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="14" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280"
                                         FontSize="13" Padding="8,5" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                                         ToolTip="Search by Serial Number, Asset Tag, Model, Assigned Tech, Supplier, or Customer..." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Category:" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}" Width="135" Margin="0,0,10,0" IsReadOnly="True">
                                    <ComboBoxItem Content="ALL" IsSelected="True" />
                                    <ComboBoxItem Content="LAPTOPS" />
                                    <ComboBoxItem Content="RAM" />
                                    <ComboBoxItem Content="STORAGE" />
                                    <ComboBoxItem Content="CHARGERS" />
                                    <ComboBoxItem Content="PERIPHERALS" />
                                    <ComboBoxItem Content="REPAIR SPARES" />
                                </ComboBox>

                                <TextBlock Text="Status:" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged}" Width="140" IsReadOnly="True" Margin="0,0,12,0">
                                    <ComboBoxItem Content="ALL" IsSelected="True" />
                                    <ComboBoxItem Content="READY_FOR_SALE" />
                                    <ComboBoxItem Content="WIP" />
                                    <ComboBoxItem Content="TESTING" />
                                    <ComboBoxItem Content="REPAIR" />
                                    <ComboBoxItem Content="SOLD" />
                                </ComboBox>

                                <Button Command="{Binding ImportExcelCommand}"
                                        Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043" BorderThickness="1"
                                        Padding="10,5" FontWeight="Bold" FontSize="11"
                                        ToolTip="Upload an Excel (.xlsx) or CSV (.csv) list of assets directly to DB">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥" Margin="0,0,4,0" />
                                        <TextBlock Text="Import Excel / CSV" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenMassUpdateCommand}"
                                        Background="#1F6FEB" Foreground="#FFFFFF" BorderBrush="#388BFD" BorderThickness="1"
                                        Padding="10,5" FontWeight="Bold" FontSize="11" Margin="8,0,0,0"
                                        ToolTip="Mass update status (SOLD, RTS, WIP), locations, grades, or customers using a list of asset tags / numbers">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" Margin="0,0,4,0" />
                                        <TextBlock Text="Mass Update Assets" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SyncGoogleSheetsCommand}"
                                        Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                                        Padding="10,5" FontWeight="Bold" FontSize="11" Margin="8,0,0,0"
                                        ToolTip="Export standard 15-column ITAM sheet, sync to Google Sheets webhook, and save local backup">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" Margin="0,0,4,0" />
                                        <TextBlock Text="Sync Sheets / Backup" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Asset DataGrid -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="1" Margin="0,0,12,0">
                        <DataGrid ItemsSource="{Binding FilteredAssets}" 
                                  SelectedItem="{Binding SelectedAsset}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#21262D"
                                  Background="#0D1117" 
                                  RowBackground="#0D1117" 
                                  AlternatingRowBackground="#161B22"
                                  Foreground="#F0F6FC" 
                                  BorderThickness="0"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="⚡ Quick Mark as SOLD"
                                                          Command="{Binding DataContext.QuickMarkSoldCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          FontWeight="Bold" Foreground="#8B949E" />
                                                <MenuItem Header="✅ Quick Mark as READY FOR SALE (RTS)"
                                                          Command="{Binding DataContext.QuickMarkRtsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          Foreground="#3FB950" />
                                                <MenuItem Header="🔧 Quick Mark as ACTIVE TESTING (WIP)"
                                                          Command="{Binding DataContext.QuickMarkWipCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          Foreground="#58A6FF" />
                                                <Separator />
                                                <MenuItem Header="🔄 Reassign to Technician..."
                                                          Command="{Binding DataContext.ReassignAssignedAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          FontWeight="Bold" Foreground="#58A6FF" />
                                                <MenuItem Header="📦 Unassign (Return to Depot Pool)"
                                                          Command="{Binding DataContext.UnassignAssignedAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          Foreground="#D29922" />
                                                <Separator />
                                                <MenuItem Header="⚡ Mass Batch Update Tool..."
                                                          Command="{Binding DataContext.OpenMassUpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="📋 Copy Asset Tag"
                                                          Command="{Binding DataContext.CopyAssetTagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="📋 Copy Serial Number"
                                                          Command="{Binding DataContext.CopySerialNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="🗑 Delete Asset from DB"
                                                          Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          Foreground="#F85149" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <!-- Category Pill -->
                                <DataGridTemplateColumn Header="CATEGORY" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#21262D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CategoryIcon}" Margin="0,0,4,0" FontSize="11" />
                                                    <TextBlock Text="{Binding CategoryBadge}" FontWeight="Bold" FontSize="10" Foreground="{Binding CategoryColorHex, Converter={StaticResource HexBrush}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Serial Number -->
                                <DataGridTextColumn Header="SERIAL / PART #" Binding="{Binding SerialNumber}" FontWeight="Bold" Width="130" />

                                <!-- Asset Tag -->
                                <DataGridTextColumn Header="TAG" Binding="{Binding AssetTag}" Width="100" />

                                <!-- Model -->
                                <DataGridTextColumn Header="MODEL / DESCRIPTION" Binding="{Binding ModelName}" Width="*" />

                                <!-- Stock / Qty -->
                                <DataGridTextColumn Header="STOCK" Binding="{Binding QuantityDisplay}" FontWeight="SemiBold" Width="75" />

                                <!-- Status Pill -->
                                <DataGridTemplateColumn Header="STATUS" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColorHex, Converter={StaticResource HexBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Grade -->
                                <DataGridTemplateColumn Header="GRADE" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#21262D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                                <TextBlock Text="{Binding GradeBadge}" FontWeight="SemiBold" FontSize="10" Foreground="#58A6FF" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Assigned Technician -->
                                <DataGridTextColumn Header="ASSIGNED TO" Binding="{Binding AssignedEmployeeName}" Width="130" />

                                <!-- Storage Health -->
                                <DataGridTemplateColumn Header="DISK HEALTH" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StorageHealth, StringFormat='{}{0}%'}" FontWeight="Bold" Foreground="#3FB950" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Location -->
                                <DataGridTextColumn Header="LOCATION" Binding="{Binding CurrentLocation}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Right Side Tabbed Inspector & Quick Stock Intake Panel -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <!-- TAB 0A: ASSET INSPECTOR -->
                            <TabItem Header="🔍 INSPECTOR" FontSize="11" Padding="10,5">
                                <Grid Margin="0,10,0,0">
                                    <!-- Empty state if no asset selected -->
                                    <TextBlock Text="Select an asset from the inventory to inspect details, dispatch to technician, or update status."
                                               Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Visibility="{Binding HasSelectedAsset, Converter={StaticResource NullVis}, ConverterParameter=invert}" />

                                    <!-- Active Asset Inspector -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasSelectedAsset, Converter={StaticResource NullVis}}">
                                        <StackPanel>
                                            <!-- Asset Identity Card -->
                                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding SelectedAsset.CategoryIcon}" FontSize="13" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding SelectedAsset.CategoryBadge}" FontWeight="Bold" FontSize="10" Foreground="{Binding SelectedAsset.CategoryColorHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" />
                                                        <TextBlock Text=" • " Foreground="#8B949E" />
                                                        <TextBlock Text="{Binding SelectedAsset.QuantityDisplay}" FontSize="11" Foreground="#3FB950" FontWeight="Bold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SelectedAsset.ModelName}" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedAsset.SerialNumber, StringFormat='Serial/Part: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding SelectedAsset.AssetTag, StringFormat='Tag: {0}'}" FontSize="11" Foreground="#58A6FF" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding SelectedAsset.CurrentLocation, StringFormat='Location: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- One-Click Lifecycle Actions -->
                                            <TextBlock Text="QUICK STATUS MUTATION" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <Button Content="READY FOR SALE" Command="{Binding UpdateStatusCommand}" CommandParameter="ReadyForSale" 
                                                        Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                <Button Content="ACTIVE TESTING" Command="{Binding UpdateStatusCommand}" CommandParameter="ActiveTesting" 
                                                        Background="#1F6FEB" Foreground="#FFF" BorderBrush="#388BFD" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                <Button Content="IN REPAIR" Command="{Binding UpdateStatusCommand}" CommandParameter="InHouseRepair" 
                                                        Background="#9E6A03" Foreground="#FFF" BorderBrush="#BB8009" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                <Button Content="AWAITING PARTS" Command="{Binding UpdateStatusCommand}" CommandParameter="AwaitingParts" 
                                                        Background="#6E40C9" Foreground="#FFF" BorderBrush="#8957E5" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                <Button Content="MARK SOLD" Command="{Binding UpdateStatusCommand}" CommandParameter="Sold" 
                                                        Background="#30363D" Foreground="#8B949E" BorderBrush="#484F58" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                                <Button Content="SCRAP / SALVAGE" Command="{Binding UpdateStatusCommand}" CommandParameter="ScrapHarvest" 
                                                        Background="#DA3633" Foreground="#FFF" BorderBrush="#F85149" Margin="2" Padding="6,6" FontSize="10" FontWeight="Bold" />
                                            </UniformGrid>

                                            <!-- Technician Job Dispatch -->
                                            <TextBlock Text="DISPATCH TO TECHNICIAN" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
                                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" DisplayMemberPath="Name" Margin="0,0,0,8" />
                                                    <Button Content="⚡ Assign Job to Technician" Command="{Binding AssignToEmployeeCommand}"
                                                            Background="#1F6FEB" Foreground="#FFF" BorderBrush="#388BFD" FontWeight="Bold" Padding="10,6" FontSize="11" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Commercial Details -->
                                            <TextBlock Text="ATTRIBUTION &amp; NOTES" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
                                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedAsset.Supplier, StringFormat='Supplier: {0}'}" FontSize="11" Foreground="#8B949E" />
                                                    <TextBlock Text="{Binding SelectedAsset.Customer, StringFormat='Customer: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding SelectedAsset.MissingComponents, StringFormat='Defects: {0}'}" FontSize="11" Foreground="#D29922" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedAsset.Notes, StringFormat='Notes: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Financial Margin & BOM Landed Cost -->
                                            <TextBlock Text="FINANCIAL MARGIN &amp; BOM LANDED COST" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
                                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="PURCHASE PRICE" FontSize="9" FontWeight="Bold" Foreground="#8B949E" />
                                                            <TextBlock Text="{Binding SelectedAsset.PurchasePrice, StringFormat='₹{0:N0}', TargetNullValue='₹0'}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="FITTED BOM DELTA" FontSize="9" FontWeight="Bold" Foreground="#8B949E" />
                                                            <TextBlock Text="{Binding SelectedAsset.FittedCostDelta, StringFormat='+₹{0:N0}'}" FontWeight="Bold" FontSize="12" Foreground="#D2A8FF" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="LANDED COST" FontSize="9" FontWeight="Bold" Foreground="#8B949E" />
                                                            <TextBlock Text="{Binding SelectedAsset.LandedCost, StringFormat='₹{0:N0}'}" FontWeight="Bold" FontSize="13" Foreground="#FFA657" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="SALE / PROJ. PRICE" FontSize="9" FontWeight="Bold" Foreground="#8B949E" />
                                                            <TextBlock Text="{Binding SelectedAsset.SalePrice, StringFormat='₹{0:N0}', TargetNullValue='Unpriced'}" FontWeight="Bold" FontSize="13" Foreground="#58A6FF" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="GROSS MARGIN:" FontSize="10" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SelectedAsset.MarginBadgeText}" FontWeight="Bold" FontSize="11" Foreground="{Binding SelectedAsset.MarginColorHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- TAB 0B: QUICK STOCK INTAKE (PARTS, RAM, SSD, CHARGERS, SPARES) -->
                            <TabItem Header="⚡ QUICK INTAKE" FontSize="11" Padding="10,5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="INTAKE STOCK / HARDWARE" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,4" />
                                        <TextBlock Text="Add Laptops, RAM, SSDs, Chargers, or Spares to Depot Cloud DB" FontSize="11" Foreground="#8B949E" Margin="0,0,0,10" />

                                        <TextBlock Text="HARDWARE CATEGORY" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding QuickIntakeCategories}" SelectedItem="{Binding QuickIntakeCategory}" Margin="0,0,0,8" />

                                        <TextBlock Text="MODEL / DESCRIPTION" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding QuickIntakeModel, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. Samsung 8GB DDR4 3200MHz, Crucial 512GB NVMe, 65W USB-C" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="SERIAL / PART # (OPTIONAL)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding QuickIntakeSerial, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave empty to auto-generate" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="QUANTITY" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding QuickIntakeQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="UNIT COST (₹)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding QuickIntakePurchasePrice, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SALE PRICE (₹)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding QuickIntakeSalePrice, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="MEMO / SOURCE NOTES" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding QuickIntakeNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                        <Button Content="📥 Intake Stock to Inventory" Command="{Binding QuickIntakeCommand}"
                                                Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" FontWeight="Bold" Padding="12,8" FontSize="11" />

                                        <Button Content="📊 Bulk Import Manifest (Excel / CSV)" Command="{Binding ImportExcelCommand}"
                                                Background="#1F6FEB" Foreground="#FFF" BorderBrush="#388BFD" FontWeight="Bold" Padding="12,8" FontSize="11" Margin="0,8,0,0"
                                                ToolTip="Upload an entire Excel (.xlsx) or CSV spreadsheet with multiple assets to the database" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 0C: FITTED COMPONENTS (OPTIONAL BOM) -->
                            <TabItem Header="🛠️ FITTED BOM" FontSize="11" Padding="10,5">
                                <Grid Margin="0,10,0,0">
                                    <!-- Empty state if no asset selected -->
                                    <TextBlock Text="Select a laptop or unit from inventory to view or attach fitted components/upgrades."
                                               Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Visibility="{Binding HasSelectedAsset, Converter={StaticResource NullVis}, ConverterParameter=invert}" />

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedAsset, Converter={StaticResource NullVis}}">
                                        <StackPanel>
                                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedAsset.ModelName}" FontWeight="Bold" FontSize="12" Foreground="#58A6FF" />
                                                    <TextBlock Text="{Binding SelectedAsset.SerialNumber, StringFormat='S/N: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Fitted Items List -->
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="FITTED COMPONENTS &amp; UPGRADES" FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                                                <TextBlock Text="{Binding SelectedAssetFittedComponents.Count, StringFormat='({0} items)'}" FontSize="11" Foreground="#58A6FF" HorizontalAlignment="Right" />
                                            </DockPanel>

                                            <!-- Notice if no fitted components -->
                                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                                                    Visibility="{Binding HasFittedComponents, Converter={StaticResource NullVis}, ConverterParameter=invert}">
                                                <TextBlock Text="Standard Factory Chassis. No custom upgrades recorded." Foreground="#8B949E" FontSize="11" FontStyle="Italic" TextAlignment="Center" />
                                            </Border>

                                            <!-- Items DataGrid/List -->
                                            <ItemsControl ItemsSource="{Binding SelectedAssetFittedComponents}" Margin="0,0,0,12"
                                                          Visibility="{Binding HasFittedComponents, Converter={StaticResource NullVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                        <TextBlock Text="{Binding CategoryIcon}" Margin="0,0,4,0" />
                                                                        <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="11" Foreground="#F0F6FC" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding SerialNumber, StringFormat='S/N: {0}'}" FontSize="10" Foreground="#8B949E" Margin="0,0,8,0" />
                                                                        <TextBlock Text="{Binding PriceDeltaDisplay}" FontSize="10" Foreground="#3FB950" FontWeight="Bold" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <Button Grid.Column="1" Content="✕ Detach"
                                                                        Command="{Binding DataContext.DetachBomComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="#21262D" Foreground="#F85149" BorderBrush="#30363D" Padding="6,3" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                        ToolTip="Detach component (optionally return part to stock)" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Quick Attach Panel -->
                                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                                                <StackPanel>
                                                    <TextBlock Text="➕ ATTACH UPGRADE / REPLACEMENT" FontSize="11" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,8" />

                                                    <!-- Mode Toggle: Stock vs Free-Form -->
                                                    <CheckBox Content="Link from Tracked Depot Stock" IsChecked="{Binding AttachFromStock}" Foreground="#58A6FF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"
                                                              ToolTip="Check to pick from entered inventory stock and decrement quantity. Uncheck to type a free-form spec without stock balance." />

                                                    <!-- Tracked Stock Picker (Visible if AttachFromStock is true) -->
                                                    <StackPanel Visibility="{Binding AttachFromStock, Converter={StaticResource NullVis}}">
                                                        <TextBlock Text="PICK FROM DEPOT STOCK" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                        <ComboBox ItemsSource="{Binding ComponentStock}" SelectedItem="{Binding SelectedBomStockItem}" Margin="0,0,0,8">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding CategoryIcon}" Margin="0,0,4,0" />
                                                                        <TextBlock Text="{Binding ModelName}" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,8,0" />
                                                                        <TextBlock Text="{Binding QuantityDisplay}" Foreground="#D29922" Margin="0,0,8,0" FontSize="10" />
                                                                        <TextBlock Text="{Binding SalePrice, StringFormat='₹{0:N0}'}" Foreground="#3FB950" FontWeight="Bold" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Free-Form Spec Fields -->
                                                    <TextBlock Text="CATEGORY" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                    <ComboBox ItemsSource="{Binding BomCategoryOptions}" SelectedItem="{Binding NewBomCategory}" Margin="0,0,0,8" />

                                                    <TextBlock Text="COMPONENT SPEC / DESCRIPTION" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding NewBomDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. 16GB DDR4 3200MHz SODIMM or 512GB NVMe M.2" Margin="0,0,0,8" />

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="SERIAL # (OPTIONAL)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding NewBomSerial, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave blank if untracked" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="PRICE DELTA (₹)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding NewBomPriceDelta, UpdateSourceTrigger=PropertyChanged}" ToolTip="Added price for invoice" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Button Content="➕ Attach Component to Machine" Command="{Binding AttachBomComponentCommand}"
                                                            Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" FontWeight="Bold" Padding="10,6" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 1: FLEET & BENCH OPERATIONS (UPGRADED FLEET VIEW)               -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="⚡ BENCH FLEET OPS">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="LIVE DIAGNOSTIC BENCHES &amp; WORKSTATION STREAM" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" />
                            <TextBlock Text="Real-time telemetry and intake events broadcasted from active diagnostic bench clients via Railway SSE &amp; LAN Mirror port 9000."
                                       FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Real-Time Activity Log List -->
                    <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12">
                        <ListBox ItemsSource="{Binding LiveActivityFeed}" Background="#0D1117" Foreground="#3FB950" FontFamily="Consolas, monospace" FontSize="12" BorderThickness="0" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 2: TECHNICIANS & JOB QUEUE (OPERATIONS COCKPIT)                   -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="👥 TECHNICIANS &amp; JOBS">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <!-- 0: Depot Technician Roster (Top Pane) -->
                        <RowDefinition Height="220" MinHeight="160" />
                        <!-- 1: Splitter -->
                        <RowDefinition Height="8" />
                        <!-- 2: Selected Technician Detailed Cockpit & History (Bottom Pane) -->
                        <RowDefinition Height="*" MinHeight="280" />
                    </Grid.RowDefinitions>

                    <!-- ── TOP PANE: DEPOT TECHNICIAN ROSTER ─────────────────────── -->
                    <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DEPOT TECHNICIANS &amp; BENCH OPERATORS" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" />
                                    <Border Background="#21262D" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Employees.Count, StringFormat='{}{0} Registered'}" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Click any technician to view live bench queue, productivity stats, and audit history below"
                                           FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployeeForEdit}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22" Foreground="#F0F6FC" BorderThickness="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="➕ Dispatch Asset to this Tech..."
                                                              Command="{Binding DataContext.AssignAssetToSelectedTechCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              FontWeight="Bold" Foreground="#3FB950" />
                                                    <Separator />
                                                    <MenuItem Header="🗑 Delete Technician Permanently"
                                                              Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}"
                                                              Foreground="#F85149" FontWeight="Bold" />
                                                    <Separator />
                                                    <MenuItem Header="⏻ Toggle Active / Inactive"
                                                              Command="{Binding DataContext.ToggleEmployeeActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="🔑 Reset Station PIN..."
                                                              Command="{Binding DataContext.SelectEmployeeForPinResetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="📋 Copy Technician ID"
                                                              Command="{Binding DataContext.CopyEmployeeIdCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="📋 Copy Station ID"
                                                              Command="{Binding DataContext.CopyEmployeeStationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" FontWeight="Bold" Width="170" />
                                    <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="110" />
                                    <DataGridTemplateColumn Header="STATION" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StationId}" FontWeight="Bold" FontSize="10" Foreground="#58A6FF" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="STATUS" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding IsActive, Converter={StaticResource BoolColor}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolStatus}}" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ACTIVE WIP" Binding="{Binding WorkloadCount, StringFormat='{}{0} WIP'}" FontWeight="Bold" Width="100" />
                                    <DataGridTextColumn Header="FINISHED (RTS)" Binding="{Binding FinishedCount, StringFormat='{}{0} done'}" Width="110" />
                                    <DataGridTextColumn Header="LIVE BENCH ACTIVITY / LAST ACTION" Binding="{Binding CurrentActivity}" Foreground="#58A6FF" Width="*" />
                                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ── SPLITTER ──────────────────────────────────────────────── -->
                    <GridSplitter Grid.Row="1" Height="6" Background="#30363D" HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="SizeNS" Margin="0,1" />

                    <!-- ── BOTTOM PANE: SELECTED OPERATOR DEEP COCKPIT ───────────── -->
                    <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <!-- Empty State when no tech selected -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasSelectedEmployeeForEdit, Converter={StaticResource NullVis}, ConverterParameter=Invert}">
                                <TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#8B949E" />
                                <TextBlock Text="SELECT AN OPERATOR FROM THE ROSTER ABOVE" FontWeight="Bold" FontSize="14" Foreground="#F0F6FC" HorizontalAlignment="Center" />
                                <TextBlock Text="Inspect active bench queue, finished productivity, and full audit trail of everything this technician does."
                                           FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Detailed Tech Inspector -->
                            <Grid Visibility="{Binding HasSelectedEmployeeForEdit, Converter={StaticResource NullVis}}">
                                <Grid.RowDefinitions>
                                    <!-- 0: Profile Header & Action Bar -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 1: Performance Metric Strip -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 2: Detailed Sub-Tabs: Assigned Units, Work Log, Settings -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Profile & Toolbar -->
                                <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="#30363D" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <!-- Operator Info & Live Status -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👤" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#58A6FF" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SelectedEmployeeForEdit.Name}" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" />
                                                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedEmployeeForEdit.StationId}" FontWeight="Bold" FontSize="11" Foreground="#58A6FF" />
                                                    </Border>
                                                    <Border Background="#21262D" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedEmployeeForEdit.Role}" FontSize="11" Foreground="#8B949E" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="Live Status: " FontSize="11" Foreground="#8B949E" />
                                                    <TextBlock Text="{Binding SelectedTechCurrentStatus}" FontWeight="Bold" FontSize="11" Foreground="#3FB950" Margin="0,0,12,0" />
                                                    <TextBlock Text="•  Last Action: " FontSize="11" Foreground="#8B949E" />
                                                    <TextBlock Text="{Binding SelectedTechLastAction}" FontSize="11" Foreground="#F0F6FC" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions Toolbar -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="➕ Dispatch Asset to Tech" Command="{Binding AssignAssetToSelectedTechCommand}"
                                                    Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" FontWeight="Bold" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                                                    ToolTip="Pick any unassigned depot unit and dispatch it directly to this technician's bench" />

                                            <Button Content="🔄 Refresh Tech" Command="{Binding RefreshSelectedTechDataCommand}"
                                                    Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" FontWeight="SemiBold" Padding="10,6" FontSize="12" Margin="0,0,8,0"
                                                    ToolTip="Reload this technician's live bench queue and recent audit activity" />

                                            <Button Content="⏻ Toggle Active" Command="{Binding ToggleEmployeeActiveCommand}"
                                                    Background="#21262D" Foreground="#D29922" BorderBrush="#30363D" FontWeight="SemiBold" Padding="10,6" FontSize="12" Margin="0,0,8,0" />

                                            <Button Content="🗑 Delete Tech" Command="{Binding DeleteEmployeeCommand}"
                                                    Background="#21262D" Foreground="#F85149" BorderBrush="#F85149" FontWeight="Bold" Padding="10,6" FontSize="12"
                                                    ToolTip="Permanently delete this technician" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Performance Metric Strip (5 Cards) -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- WIP Units -->
                                    <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE IN-PROGRESS" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                            <TextBlock Text="{Binding SelectedTechActiveAssignedCount, StringFormat='{}{0} units'}" FontSize="16" FontWeight="Bold" Foreground="#58A6FF" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Finished Today -->
                                    <Border Grid.Column="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="FINISHED TODAY" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                            <TextBlock Text="{Binding SelectedTechCompletedTodayCount, StringFormat='{}{0} units'}" FontSize="16" FontWeight="Bold" Foreground="#3FB950" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Finished Total (RTS/Sold) -->
                                    <Border Grid.Column="2" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="FINISHED TOTAL (RTS)" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                            <TextBlock Text="{Binding SelectedTechCompletedAllTimeCount, StringFormat='{}{0} units'}" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Total Bench Actions -->
                                    <Border Grid.Column="3" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="BENCH ACTIONS / FIXES" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                            <TextBlock Text="{Binding SelectedTechTotalFixesCount, StringFormat='{}{0} logged'}" FontSize="16" FontWeight="Bold" Foreground="#D29922" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- BOM Components Fitted -->
                                    <Border Grid.Column="4" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="PARTS &amp; UPGRADES FITTED" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                            <TextBlock Text="{Binding SelectedTechComponentsFittedCount, StringFormat='{}{0} parts'}" FontSize="16" FontWeight="Bold" Foreground="#A371F7" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Sub-Tabs: Assigned Units, Work History, Settings -->
                                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                                    <!-- TAB A: Currently Assigned Assets Queue -->
                                    <TabItem Header="📋 ASSIGNED BENCH QUEUE">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                <TextBlock Text="UNITS CURRENTLY ASSIGNED TO THIS OPERATOR'S BENCH:" FontSize="11" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="Use the action buttons in any row to reassign, unassign back to depot pool, or mark as RTS." FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>

                                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedTechAssignedAssets}"
                                                      AutoGenerateColumns="False" IsReadOnly="True"
                                                      Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22" Foreground="#F0F6FC" BorderThickness="0">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                        <Setter Property="ContextMenu">
                                                            <Setter.Value>
                                                                <ContextMenu>
                                                                    <MenuItem Header="🔄 Reassign to Another Tech..."
                                                                              Command="{Binding DataContext.ReassignAssignedAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}" FontWeight="Bold" />
                                                                    <MenuItem Header="📦 Unassign (Return to Depot Pool)"
                                                                              Command="{Binding DataContext.UnassignAssignedAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <Separator />
                                                                    <MenuItem Header="✅ Quick Mark as Ready For Sale (RTS)"
                                                                              Command="{Binding DataContext.QuickMarkAssignedRtsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}" Foreground="#3FB950" />
                                                                    <Separator />
                                                                    <MenuItem Header="📋 Copy Asset Tag"
                                                                              Command="{Binding DataContext.CopyAssetTagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="📋 Copy Serial Number"
                                                                              Command="{Binding DataContext.CopySerialNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                              CommandParameter="{Binding}" />
                                                                </ContextMenu>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="TAG" Binding="{Binding AssetTag}" FontWeight="Bold" Width="110" />
                                                    <DataGridTextColumn Header="SERIAL NUMBER" Binding="{Binding SerialNumber}" Width="130" />
                                                    <DataGridTextColumn Header="MODEL" Binding="{Binding ModelName}" FontWeight="SemiBold" Width="*" />
                                                    <DataGridTextColumn Header="LOCATION" Binding="{Binding CurrentLocation}" Width="100" />
                                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                                                    <DataGridTextColumn Header="GRADE" Binding="{Binding GradeBadge}" Width="80" />
                                                    <DataGridTextColumn Header="BATTERY" Binding="{Binding BatteryHealth, StringFormat='{}{0}%'}" Width="80" />
                                                    <DataGridTextColumn Header="SSD" Binding="{Binding StorageHealth, StringFormat='{}{0}%'}" Width="70" />
                                                    <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="140" />

                                                    <!-- In-Row Quick Actions -->
                                                    <DataGridTemplateColumn Header="DISPATCH ACTIONS" Width="220">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="🔄 Reassign"
                                                                            Command="{Binding DataContext.ReassignAssignedAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" FontWeight="SemiBold" FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                                                            ToolTip="Reassign this product to another operator or station" />

                                                                    <Button Content="📦 Unassign"
                                                                            Command="{Binding DataContext.UnassignAssignedAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="#21262D" Foreground="#D29922" BorderBrush="#30363D" FontWeight="SemiBold" FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                                                            ToolTip="Unassign this asset and return to general depot intake/bench pool" />

                                                                    <Button Content="⚡ RTS"
                                                                            Command="{Binding DataContext.QuickMarkAssignedRtsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="#21262D" Foreground="#3FB950" BorderBrush="#30363D" FontWeight="Bold" FontSize="11" Padding="6,3"
                                                                            ToolTip="Promote asset to Ready For Sale" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>

                                    <!-- TAB B: Work Log & Audit Trail -->
                                    <TabItem Header="🕒 WORK LOG &amp; AUDIT TRAIL">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                <TextBlock Text="HISTORICAL ACTIONS, BENCH FIXES, AND REPAIR LOGGED BY THIS OPERATOR:" FontSize="11" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SelectedTechActivityLog.Count, StringFormat='{}{0} Activity Events'}" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedTechActivityLog}"
                                                      AutoGenerateColumns="False" IsReadOnly="True"
                                                      Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22" Foreground="#F0F6FC" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="TIME" Binding="{Binding RecordedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="150" />
                                                    <DataGridTextColumn Header="ASSET TAG" Binding="{Binding AssetTag}" FontWeight="Bold" Foreground="#58A6FF" Width="120" />
                                                    <DataGridTextColumn Header="SERIAL NUMBER" Binding="{Binding SerialNumber}" Width="130" />
                                                    <DataGridTextColumn Header="MODEL" Binding="{Binding Model}" FontWeight="SemiBold" Width="170" />
                                                    <DataGridTemplateColumn Header="BENCH ACTION" Width="140">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding EventType}" FontWeight="Bold" FontSize="11" Foreground="#3FB950" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="BENCH / STATION" Binding="{Binding Location}" Width="120" />
                                                    <DataGridTextColumn Header="ACTION DETAILS / NOTES" Binding="{Binding NotesJson}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>

                                    <!-- TAB C: Station Settings & Registration -->
                                    <TabItem Header="⚙ STATION CONFIG &amp; REGISTRATION">
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Manage Current Operator -->
                                            <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <StackPanel>
                                                    <TextBlock Text="OPERATOR CREDENTIALS &amp; BENCH STATION" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,12" />

                                                    <!-- Reset PIN -->
                                                    <TextBlock Text="NEW STATION PIN" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding EditEmployeePin, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Content="🔑 Reset PIN" Command="{Binding ResetEmployeePinCommand}"
                                                                Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" FontWeight="Bold" Padding="10,6" />
                                                    </Grid>

                                                    <!-- Modify Station ID -->
                                                    <TextBlock Text="ASSIGN HARDWARE BENCH / STATION ID" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding EditEmployeeStationId, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="2" Content="🏷 Update Station" Command="{Binding UpdateEmployeeStationCommand}"
                                                                Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" FontWeight="Bold" Padding="10,6" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Right: Register New Technician Form -->
                                            <Border Grid.Column="2" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <StackPanel>
                                                    <TextBlock Text="REGISTER NEW TECHNICIAN / OPERATOR" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,12" />

                                                    <TextBlock Text="FULL NAME" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding NewEmployeeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="STATION PIN" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding NewEmployeePin, UpdateSourceTrigger=PropertyChanged}" ToolTip="4+ digit PIN for bench login" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="STATION / BENCH ID" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding NewEmployeeStationId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Assigned hardware bench (e.g. BENCH-01)" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="SECURITY ROLE" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NewEmployeeRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14">
                                                        <ComboBoxItem Content="Technician" IsSelected="True" />
                                                        <ComboBoxItem Content="Manager" />
                                                        <ComboBoxItem Content="Owner" />
                                                    </ComboBox>

                                                    <Button Content="+ Register Technician" Command="{Binding CreateEmployeeCommand}"
                                                            Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" FontWeight="Bold" Padding="12,8" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 3: BILLING & INVOICING (VYAPAR-STYLE REFURBISHMENT SUITE)        -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="🧾 BILLING &amp; FINANCIALS">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Depot Financial Intelligence KPI Banner -->
                    <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- KPI 1 -->
                            <Border Grid.Column="0" BorderBrush="#30363D" BorderThickness="0,0,1,0" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="DEPOT INVENTORY COST" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding DepotInventoryCostValue, StringFormat='₹{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,2,0,0" />
                                    <TextBlock Text="Active non-sold stock cost" FontSize="9" Foreground="#8B949E" />
                                </StackPanel>
                            </Border>
                            <!-- KPI 2 -->
                            <Border Grid.Column="1" BorderBrush="#30363D" BorderThickness="0,0,1,0" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="RTS PROJECTED VALUE" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding DepotProjectedSaleValue, StringFormat='₹{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#58A6FF" Margin="0,2,0,0" />
                                    <TextBlock Text="Ready for sale catalog total" FontSize="9" Foreground="#8B949E" />
                                </StackPanel>
                            </Border>
                            <!-- KPI 3 -->
                            <Border Grid.Column="2" BorderBrush="#30363D" BorderThickness="0,0,1,0" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="PROJECTED MARGIN" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding DepotProjectedMarginValue, StringFormat='₹{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#3FB950" Margin="0,2,0,0" />
                                    <TextBlock Text="RTS sale value - Landed cost" FontSize="9" Foreground="#8B949E" />
                                </StackPanel>
                            </Border>
                            <!-- KPI 4 -->
                            <Border Grid.Column="3">
                                <StackPanel>
                                    <TextBlock Text="AVG GROSS MARGIN %" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                                    <TextBlock Text="{Binding DepotMarginPercent, StringFormat='{}{0:F1}%'}" FontSize="18" FontWeight="Bold" Foreground="#D2A8FF" Margin="0,2,0,0" />
                                    <TextBlock Text="Depot inventory profitability" FontSize="9" Foreground="#8B949E" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 1: Refurbishment Invoice Builder & Vyapar Suite -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                    <!-- Left: Invoice Draft Table + Settlement + History -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Box 1: Current Invoice Draft -->
                        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ ACTIVE INVOICE DRAFT" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" />
                                        <Border Background="#21262D" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CurrentInvoiceItems.Count, StringFormat='{}{0} line items'}" FontSize="11" Foreground="#58A6FF" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <Button DockPanel.Dock="Right" Content="🗑 Clear Draft" Command="{Binding ClearInvoiceDraftCommand}"
                                            Background="#21262D" Foreground="#F85149" BorderBrush="#30363D" Padding="8,4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Draft Items DataGrid -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentInvoiceItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22" Foreground="#F0F6FC" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="35" />
                                        <DataGridTemplateColumn Header="TYPE" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding BadgeColorHex, Converter={StaticResource HexBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding ItemBadge}" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ITEM / SPECIFICATION" Binding="{Binding Model}" FontWeight="SemiBold" Width="*" />
                                        <DataGridTextColumn Header="SERIAL / REF" Binding="{Binding SerialNumber}" Width="105" />
                                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="45" />
                                        <DataGridTextColumn Header="RATE" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Width="85" />
                                        <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, StringFormat='₹{0:N2}'}" FontWeight="Bold" Width="90" />
                                        <DataGridTemplateColumn Header="" Width="45">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Command="{Binding DataContext.RemoveInvoiceItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            Background="Transparent" Foreground="#F85149" BorderThickness="0" FontWeight="Bold" Cursor="Hand" ToolTip="Remove Item" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Box 2: Customer Attributions & Grand Total Settlement -->
                        <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>

                                <!-- Customer Details -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CUSTOMER &amp; SETTLEMENT DETAILS" FontSize="11" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding DraftPartyName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Customer Name" />
                                        <TextBox Grid.Column="2" Text="{Binding DraftPartyPhone, UpdateSourceTrigger=PropertyChanged}" ToolTip="Phone / Mobile" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding DraftPartyAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="Billing Address" />
                                        <TextBox Grid.Column="2" Text="{Binding DraftPaymentMode, UpdateSourceTrigger=PropertyChanged}" ToolTip="Payment Mode (UPI/Cash/Bank/Card)" />
                                    </Grid>
                                    <TextBox Text="{Binding DraftNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Warranty &amp; Terms Memo" />
                                </StackPanel>

                                <!-- Calculations & Finalize Button -->
                                <Border Grid.Column="2" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Subtotal:" FontSize="11" Foreground="#8B949E" />
                                            <TextBlock Text="{Binding DraftSubTotal, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="GST (" FontSize="11" Foreground="#8B949E" />
                                                <TextBox Text="{Binding DraftTaxPercent, UpdateSourceTrigger=PropertyChanged}" Width="30" FontSize="11" Padding="2,0" Background="#161B22" BorderBrush="#30363D" Foreground="#58A6FF" HorizontalContentAlignment="Center" />
                                                <TextBlock Text="%):" FontSize="11" Foreground="#8B949E" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DraftTaxAmount, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <Border BorderBrush="#30363D" BorderThickness="0,1,0,0" Margin="0,4,0,6" />
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="TOTAL:" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DraftGrandTotal, StringFormat='₹{0:N2}'}" FontWeight="Bold" FontSize="18" Foreground="#3FB950" HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <CheckBox Content="Deduct stock / Mark unit SOLD" IsChecked="{Binding MarkAsSoldOnInvoice}" Foreground="#3FB950" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,8" />

                                        <Button Content="{Binding GenerateInvoiceButtonText}" Command="{Binding GenerateInvoiceCommand}"
                                                Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043" FontWeight="Bold" Padding="10,8" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Box 3: Generated History -->
                        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="PREVIOUS GENERATED INVOICES &amp; BILLS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,8" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22" Foreground="#F0F6FC" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" FontWeight="Bold" Width="130" />
                                        <DataGridTemplateColumn Header="TYPE" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Type, Converter={StaticResource InvTypeBrush}}" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource InvTypeString}}" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" Width="85" />
                                        <DataGridTextColumn Header="PARTY" Binding="{Binding PartyName}" Width="*" />
                                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat='₹{0:N2}'}" FontWeight="Bold" Width="95" />
                                        <DataGridTemplateColumn Header="" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="📄 Preview" Command="{Binding DataContext.PreviewInvoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" Padding="4,2" FontSize="10" FontWeight="SemiBold" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right Column: Refurbishment Component Selector (Vyapar Style) -->
                    <Border Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="HARDWARE MODIFICATION &amp; STOCK SELECTOR" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,12" />

                                <!-- SECTION 1: BASE MACHINE -->
                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="1. SELECT BASE MACHINE (CHASSIS / UNIT)" FontSize="11" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,6" />
                                        <TextBlock Text="Pick a tested base laptop/desktop from stock:" FontSize="10" Foreground="#8B949E" Margin="0,0,0,6" />

                                        <ComboBox ItemsSource="{Binding AvailableBaseUnits}" SelectedItem="{Binding SelectedInvoiceBaseAsset}" Margin="0,0,0,8">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SerialNumber}" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding ModelName}" Foreground="#F0F6FC" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding SalePrice, StringFormat='(₹{0:N0})'}" Foreground="#3FB950" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Button Content="➕ Attach Base Unit to Invoice" Command="{Binding AddBaseToDraftCommand}"
                                                Background="#1F6FEB" Foreground="#FFF" BorderBrush="#388BFD" FontWeight="Bold" Padding="10,6" FontSize="11" />

                                        <Button Content="📥 Import Fitted Upgrades to Draft" Command="{Binding ImportFittedToInvoiceCommand}"
                                                Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" FontWeight="SemiBold" Padding="8,5" FontSize="10" Margin="0,6,0,0"
                                                ToolTip="Automatically import any recorded fitted upgrades (RAM/SSD) into this invoice draft" />
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 2: COMPONENT UPGRADES / DEGRADES / SPARES -->
                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="2. ATTACH COMPONENT / UPGRADE / SPARE" FontSize="11" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,6" />
                                        <TextBlock Text="Select from live inventory (RAM, SSD, Charger, Peripheral, Spare):" FontSize="10" Foreground="#8B949E" Margin="0,0,0,6" />

                                        <ComboBox ItemsSource="{Binding ComponentStock}" SelectedItem="{Binding SelectedComponentForInvoice}" Margin="0,0,0,8">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CategoryIcon}" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding ModelName}" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Quantity, StringFormat='Stock: {0}'}" Foreground="#D29922" Margin="0,0,8,0" FontSize="10" />
                                                        <TextBlock Text="{Binding SalePrice, StringFormat='₹{0:N0}'}" Foreground="#3FB950" FontWeight="Bold" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="ACTION / MODIFICATION TYPE" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding ComponentActionOptions}" SelectedItem="{Binding SelectedComponentAction}" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="QTY" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ComponentItemQty, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="RATE / PRICE (₹)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ComponentItemPrice, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="CUSTOM LINE SPEC / NOTE" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ComponentItemNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                        <Button Content="➕ Attach Component to Invoice" Command="{Binding AddComponentToDraftCommand}"
                                                Background="#238636" Foreground="#FFF" BorderBrush="#2EA043" FontWeight="Bold" Padding="10,6" FontSize="11" />
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 3: CUSTOM ITEM / LABOR / DISCOUNT -->
                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="3. CUSTOM SERVICE / LABOR / DISCOUNT" FontSize="11" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,6" />
                                        <TextBlock Text="Description (e.g. Deep Clean &amp; Repaste, or -₹500 Discount):" FontSize="10" Foreground="#8B949E" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding CustomLineDesc, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="QTY" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding CustomLineQty, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="PRICE / DEDUCTION (₹)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding CustomLinePrice, UpdateSourceTrigger=PropertyChanged}" ToolTip="Use negative numbers for discounts" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="➕ Add Service / Custom Line" Command="{Binding AddCustomLineItemCommand}"
                                                Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" FontWeight="Bold" Padding="10,6" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- TAB 4: SETTINGS & LAN MIRROR SERVER                                 -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="⚙ SETTINGS &amp; LAN SERVER">
                <Grid Margin="16">
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="20" MaxWidth="600" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="VELOX DEPOT CONFIGURATION" FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,14" />

                            <TextBlock Text="CLOUD API ENDPOINT" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
                                <TextBlock Text="https://velox-api-production.up.railway.app" Foreground="#58A6FF" FontWeight="Bold" />
                            </Border>

                            <TextBlock Text="PRIMARY API KEY" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
                                <TextBlock Text="vx-2fe1479ad70dffd3017a0aa8c67b1c270fc9dd00bb9d4bdf" Foreground="#8B949E" FontFamily="Consolas, monospace" />
                            </Border>

                            <TextBlock Text="LOCAL LAN MIRROR SERVER" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,8,0,4" />
                            <TextBlock Text="Listens on Port 9000 for zero-latency local bench synchronization. Bench clients on the same local network push tests here sub-millisecond, which are then synchronized to Railway Cloud."
                                       FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <Button Content="Toggle LAN Mirror Server" Command="{Binding ToggleLanServerCommand}"
                                    Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" FontWeight="SemiBold" Padding="12,8" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ── FOOTER STATUS BAR ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Velox Platform: " FontSize="11" Foreground="#8B949E" />
                    <TextBlock Text="Railway Cloud Active + Local LAN Mirror Active" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,16,0" />
                    <TextBlock Text="Event Stream: " FontSize="11" Foreground="#8B949E" />
                    <TextBlock Text="Real-Time Zero-Click Active" FontSize="11" FontWeight="SemiBold" Foreground="#3FB950" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VeloxManager 1.0.0 — Velox Depot Operations" FontSize="10" Foreground="#8B949E" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
