<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font Families with clean fallbacks -->
    <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New, monospace</FontFamily>
    <FontFamily x:Key="FontSans">Source Sans 3, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>

    <!-- Text Styles with Dynamic Theme Adaptivity -->
    <Style x:Key="TextHeaderBrand" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TokenTextMutedBrush}"/>
    </Style>

    <Style x:Key="TextCardHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TokenTextMutedBrush}"/>
    </Style>

    <Style x:Key="TextCardValueLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextBadgeMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="TextTableMonoTag" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TokenBrandBrush}"/>
    </Style>

    <Style x:Key="TextTableMonoSerial" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TokenTextMutedBrush}"/>
    </Style>

</ResourceDictionary>
