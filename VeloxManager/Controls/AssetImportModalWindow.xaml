<Window x:Class="VeloxManager.Controls.AssetImportModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeloxManager — Excel &amp; CSV Asset Database Importer"
        Height="720" Width="1060"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#F0F6FC"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Dark Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D" />
                    <Setter Property="BorderBrush" Value="#8B949E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- KPI Metric Style -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: File Selection & Options -->
            <RowDefinition Height="Auto" />
            <!-- 2: Metrics Strip -->
            <RowDefinition Height="Auto" />
            <!-- 3: Preview DataGrid -->
            <RowDefinition Height="*" />
            <!-- 4: Upload Progress Bar -->
            <RowDefinition Height="Auto" />
            <!-- 5: Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── HEADER ────────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EXCEL &amp; CSV ASSET IMPORTER" FontSize="18" FontWeight="Bold" Foreground="#58A6FF" />
                            <Border Background="#238636" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BULK DB INTAKE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Import device lists, SuperAutoMater backup sheets, or supplier inventory manifests directly into the database."
                                   FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── FILE PICKER & DEFAULTS ────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: File Picker -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtFilePath" IsReadOnly="True" Background="#0D1117" Foreground="#F0F6FC"
                             BorderBrush="#30363D" BorderThickness="1" Padding="10,8" FontSize="13"
                             Text="Select an Excel (.xlsx) or CSV (.csv) file to import, or drag &amp; drop it here..." />

                    <Button Grid.Column="1" x:Name="BtnBrowse" Click="BtnBrowse_Click" Margin="10,0,0,0"
                            Background="#1F6FEB" BorderBrush="#388BFD" Foreground="#FFFFFF" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,6,0" />
                            <TextBlock Text="Browse File..." FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 1: Fallback Defaults -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Category Default -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Default Category (if not in sheet):" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbDefaultCategory" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="8,5">
                            <ComboBoxItem Content="Laptop" IsSelected="True" />
                            <ComboBoxItem Content="Desktop" />
                            <ComboBoxItem Content="Workstation" />
                            <ComboBoxItem Content="Server" />
                            <ComboBoxItem Content="AllInOne" />
                            <ComboBoxItem Content="Tablet" />
                            <ComboBoxItem Content="Monitor" />
                            <ComboBoxItem Content="Ram" />
                            <ComboBoxItem Content="Storage" />
                            <ComboBoxItem Content="Charger" />
                            <ComboBoxItem Content="Spares" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Location Default -->
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Default Location / Shelf:" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbDefaultLocation" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="8,5" IsEditable="True">
                            <ComboBoxItem Content="IntakeStaging" IsSelected="True" />
                            <ComboBoxItem Content="Warehouse-Shelf-A" />
                            <ComboBoxItem Content="Warehouse-Shelf-B" />
                            <ComboBoxItem Content="Bench-01" />
                            <ComboBoxItem Content="Floor Pool" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Status / Queue Default -->
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="Default Lifecycle Queue:" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbDefaultQueue" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="8,5">
                            <ComboBoxItem Content="IntakeStaging" IsSelected="True" />
                            <ComboBoxItem Content="ReadyForSale" />
                            <ComboBoxItem Content="ActiveTesting" />
                            <ComboBoxItem Content="AwaitingParts" />
                            <ComboBoxItem Content="ExternalRepair" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── METRICS STRIP ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" x:Name="PanelMetrics" Visibility="Collapsed">
            <Border Style="{StaticResource MetricCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Rows: " Foreground="#8B949E" />
                    <TextBlock x:Name="TxtTotalRows" Text="0" FontWeight="Bold" Foreground="#F0F6FC" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Valid to Import: " Foreground="#8B949E" />
                    <TextBlock x:Name="TxtValidRows" Text="0" FontWeight="Bold" Foreground="#3FB950" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Invalid / Skipped: " Foreground="#8B949E" />
                    <TextBlock x:Name="TxtInvalidRows" Text="0" FontWeight="Bold" Foreground="#F85149" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Detected Columns: " Foreground="#8B949E" />
                    <TextBlock x:Name="TxtDetectedCols" Text="None" FontWeight="SemiBold" Foreground="#58A6FF" TextTrimming="CharacterEllipsis" MaxWidth="450" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── DATA GRID PREVIEW ─────────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="1" Margin="0,0,0,12">
            <Grid>
                <DataGrid x:Name="GridPreview" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                          Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22"
                          Foreground="#F0F6FC" CanUserSortColumns="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="45" />
                        <DataGridTextColumn Header="SERIAL NUMBER" Binding="{Binding SerialNumber}" Width="150" />
                        <DataGridTextColumn Header="ASSET TAG" Binding="{Binding AssetTag}" Width="130" />
                        <DataGridTextColumn Header="MODEL / PROCESSOR" Binding="{Binding Model}" Width="200" />
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="90" />
                        <DataGridTextColumn Header="GRADE" Binding="{Binding Grade}" Width="65" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding LifecycleQueue}" Width="110" />
                        <DataGridTextColumn Header="BATT %" Binding="{Binding BatteryHealth}" Width="65" />
                        <DataGridTextColumn Header="SSD %" Binding="{Binding StorageHealth}" Width="65" />
                        <DataGridTextColumn Header="PRICE" Binding="{Binding SalePrice, StringFormat=C2}" Width="80" />
                        <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Supplier}" Width="120" />
                        <DataGridTextColumn Header="NOTES / WIP" Binding="{Binding Notes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Prompt -->
                <StackPanel x:Name="PanelEmptyPrompt" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#8B949E" />
                    <TextBlock Text="No manifest file loaded yet" FontSize="15" FontWeight="Bold" Foreground="#F0F6FC" HorizontalAlignment="Center" />
                    <TextBlock Text="Click 'Browse File...' or drag and drop an .xlsx / .csv file here to preview assets."
                               FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── UPLOAD PROGRESS BAR ───────────────────────────────────────────── -->
        <Border Grid.Row="4" x:Name="PanelProgress" Visibility="Collapsed" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="TxtProgressStatus" Text="Uploading assets to database..." FontWeight="SemiBold" Foreground="#58A6FF" FontSize="12" />
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#3FB950" FontSize="12" />
                </Grid>
                <ProgressBar x:Name="PbUpload" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#238636" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" />
            </StackPanel>
        </Border>

        <!-- ── FOOTER ACTIONS ────────────────────────────────────────────────── -->
        <Grid Grid.Row="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFooterHint" Text="Ready to upload." FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Click="BtnCancel_Click" Margin="0,0,10,0" Padding="16,8">
                    <TextBlock Text="Cancel" />
                </Button>

                <Button x:Name="BtnUpload" Click="BtnUpload_Click" IsEnabled="False"
                        Background="#238636" BorderBrush="#2EA043" Foreground="#FFFFFF" Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtUploadBtn" Text="Upload to Database" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
