<Window x:Class="VeloxManager.Controls.QualityGateModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velox Quality Gate — Mandatory RTS Certification Check"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#F0F6FC"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Overall Status Banner -->
            <RowDefinition Height="Auto" />
            <!-- 2: Checklist Items -->
            <RowDefinition Height="*" />
            <!-- 3: Footer Warning / Note -->
            <RowDefinition Height="Auto" />
            <!-- 4: Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="DEPOT QUALITY GATE AUDIT" FontSize="16" FontWeight="Bold" Foreground="#58A6FF" />
                    <TextBlock x:Name="TxtAssetSubheader" Text="TAG-000000 • Model Description" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status Banner -->
        <Border Grid.Row="1" x:Name="BannerStatus" Margin="0,0,0,16" Padding="14,10" CornerRadius="6" Background="#21262D" BorderThickness="1" BorderBrush="#30363D">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusIcon" Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock x:Name="TxtStatusTitle" Text="QUALITY AUDIT IN PROGRESS" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC" />
                    <TextBlock x:Name="TxtStatusDesc" Text="Evaluating hardware diagnostics and cosmetic grading against RTS standards." FontSize="11" Foreground="#8B949E" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4-Point Checklist -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">

                <!-- 1. Cosmetic Grade Check -->
                <Border Margin="0,0,0,12" Padding="10" Background="#0D1117" CornerRadius="6" BorderThickness="1" x:Name="BorderGrade">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IconGrade" Text="❓" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Cosmetic Grade Evaluated" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" />
                            <TextBlock x:Name="TxtGradeDetail" Text="Grade A assigned" FontSize="11" Foreground="#8B949E" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="BadgeGrade" Text="PENDING" FontWeight="Bold" FontSize="10" Padding="8,3" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 2. Battery Health Check -->
                <Border Margin="0,0,0,12" Padding="10" Background="#0D1117" CornerRadius="6" BorderThickness="1" x:Name="BorderBattery">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IconBattery" Text="❓" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Battery Health Integrity (Threshold >= 70%)" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" />
                            <TextBlock x:Name="TxtBatteryDetail" Text="Tested battery health" FontSize="11" Foreground="#8B949E" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="BadgeBattery" Text="PENDING" FontWeight="Bold" FontSize="10" Padding="8,3" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 3. Storage Health Check -->
                <Border Margin="0,0,0,12" Padding="10" Background="#0D1117" CornerRadius="6" BorderThickness="1" x:Name="BorderStorage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IconStorage" Text="❓" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Storage Drive Health Integrity (Threshold >= 80%)" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" />
                            <TextBlock x:Name="TxtStorageDetail" Text="NVMe/SSD S.M.A.R.T. health" FontSize="11" Foreground="#8B949E" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="BadgeStorage" Text="PENDING" FontWeight="Bold" FontSize="10" Padding="8,3" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 4. BOM Missing Components Check -->
                <Border Padding="10" Background="#0D1117" CornerRadius="6" BorderThickness="1" x:Name="BorderComponents">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IconComponents" Text="❓" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="BOM Component Completeness" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" />
                            <TextBlock x:Name="TxtComponentsDetail" Text="Zero missing parts flagged" FontSize="11" Foreground="#8B949E" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="BadgeComponents" Text="PENDING" FontWeight="Bold" FontSize="10" Padding="8,3" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </Border>

        <!-- Warning / Note -->
        <TextBlock Grid.Row="3" x:Name="TxtQualityNote" Margin="0,0,0,16" FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"
                   Text="Units marked Ready for Sale appear in VeloxShowroom catalog and can be reserved or invoiced. Ensure physical hardware matches certified specifications." />

        <!-- Footer Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TxtResultSummary" FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#8B949E" />

            <Button Grid.Column="1" x:Name="BtnCancel" Content="Keep in WIP" Click="BtnCancel_Click"
                    Padding="16,8" Background="Transparent" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                    Cursor="Hand" Margin="0,0,10,0" />

            <Button Grid.Column="2" x:Name="BtnConfirmOrOverride" Content="Confirm RTS Promotion" Click="BtnConfirmOrOverride_Click"
                    Padding="18,8" FontWeight="Bold" Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043" BorderThickness="1"
                    Cursor="Hand" />
        </Grid>
    </Grid>
</Window>
