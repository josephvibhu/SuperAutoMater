<Window x:Class="VeloxManager.Controls.MassAssetUpdateModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeloxManager — Mass Asset Batch Update Tool"
        Height="780" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#F0F6FC"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Content Split: Input on left, Update Settings on right -->
            <RowDefinition Height="*" />
            <!-- 2: Progress Strip -->
            <RowDefinition Height="Auto" />
            <!-- 3: Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── HEADER ────────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#58A6FF" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MASS ASSET BATCH UPDATE" FontSize="18" FontWeight="Bold" Foreground="#58A6FF" />
                        <Border Background="#1F6FEB" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MULTI-TARGET ENGINE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Quickly mass update lifecycle status (SOLD, RTS, WIP), shelf location, cosmetic grade, customer, or notes across any list of asset numbers or serials."
                               FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── MAIN SPLIT CONTENT ────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <!-- Left: Asset list input & Matched Assets Preview -->
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <!-- Right: Fields to Update -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT COLUMN: ASSET INPUT & PREVIEW ────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="1. ENTER / PASTE ASSET NUMBERS, TAGS, OR SERIALS:" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />

                <!-- Asset Numbers Input Box -->
                <TextBox Grid.Row="1" x:Name="TxtAssetInputs" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="12"
                         Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="8"
                         ToolTip="Paste tags (e.g. HP001, HP002, DL01) or scan barcodes one after another"
                         TextChanged="TxtAssetInputs_TextChanged" />

                <!-- Action / Preset Buttons Bar -->
                <Grid Grid.Row="2" Margin="0,8,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnMatchNow" Content="🔍 Match &amp; Verify" Click="BtnMatchNow_Click"
                            Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" Padding="12,5" FontWeight="SemiBold" FontSize="11" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Presets:" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Content="⚡ Mark SOLD" Click="BtnPresetSold_Click" Margin="0,0,4,0" Padding="8,4" FontSize="11" Background="#21262D" Foreground="#8B949E" />
                        <Button Content="✅ Mark RTS" Click="BtnPresetRts_Click" Margin="0,0,4,0" Padding="8,4" FontSize="11" Background="#21262D" Foreground="#3FB950" />
                        <Button Content="🔧 Mark WIP" Click="BtnPresetWip_Click" Padding="8,4" FontSize="11" Background="#21262D" Foreground="#58A6FF" />
                    </StackPanel>
                </Grid>

                <!-- Matched Assets Grid -->
                <Border Grid.Row="3" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Counter bar -->
                        <Border Grid.Row="0" Background="#21262D" Padding="10,6" CornerRadius="7,7,0,0">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="TARGET ASSETS: " FontSize="11" FontWeight="Bold" Foreground="#8B949E" />
                                    <TextBlock x:Name="TxtMatchedCount" Text="0 Matched" FontWeight="Bold" FontSize="11" Foreground="#3FB950" Margin="4,0,0,0" />
                                    <TextBlock x:Name="TxtUnmatchedCount" Text="" FontWeight="SemiBold" FontSize="11" Foreground="#F85149" Margin="12,0,0,0" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Clear List" Click="BtnClearList_Click"
                                        Background="Transparent" Foreground="#8B949E" BorderThickness="0" Padding="4,0" FontSize="11" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="GridMatchedAssets" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22"
                                  Foreground="#F0F6FC" BorderThickness="0" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TAG" Binding="{Binding AssetTag}" FontWeight="Bold" Width="90" />
                                <DataGridTextColumn Header="SERIAL" Binding="{Binding SerialNumber}" Width="120" />
                                <DataGridTextColumn Header="MODEL" Binding="{Binding ModelName}" Width="*" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding StatusBadge}" FontWeight="SemiBold" Width="100" />
                                <DataGridTextColumn Header="LOC" Binding="{Binding CurrentLocation}" Width="85" />
                                <DataGridTextColumn Header="GRADE" Binding="{Binding GradeBadge}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── RIGHT COLUMN: TARGET UPDATE SETTINGS ─────────────────────── -->
            <Border Grid.Column="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="2. CHOOSE DATAPOINTS TO MASS UPDATE:" FontSize="11" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,12" />

                        <!-- Status / Queue Option -->
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="ChkUpdateStatus" Content="Update Lifecycle Status" FontWeight="SemiBold" Foreground="#F0F6FC"
                                          IsChecked="True" Checked="ChkUpdateStatus_Changed" Unchecked="ChkUpdateStatus_Changed" />
                                <TextBlock Text="Change asset pipeline state (e.g. mark batch as Sold or RTS)" FontSize="10" Foreground="#8B949E" Margin="22,2,0,6" />
                                <ComboBox x:Name="CmbTargetStatus" Margin="22,0,0,0" Padding="8,5">
                                    <ComboBoxItem Content="Sold" IsSelected="True" />
                                    <ComboBoxItem Content="ReadyForSale" />
                                    <ComboBoxItem Content="ActiveTesting" />
                                    <ComboBoxItem Content="OnHold" />
                                    <ComboBoxItem Content="AwaitingParts" />
                                    <ComboBoxItem Content="ExternalRepair" />
                                    <ComboBoxItem Content="IntakeStaging" />
                                    <ComboBoxItem Content="Disposed" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Location Option -->
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="ChkUpdateLocation" Content="Update Shelf / Bench Location" FontWeight="SemiBold" Foreground="#F0F6FC"
                                          Checked="ChkUpdateLocation_Changed" Unchecked="ChkUpdateLocation_Changed" />
                                <TextBlock Text="Relocate batch to a shelf, bench, or showroom" FontSize="10" Foreground="#8B949E" Margin="22,2,0,6" />
                                <ComboBox x:Name="CmbTargetLocation" Margin="22,0,0,0" Padding="8,5" IsEditable="True" IsEnabled="False">
                                    <ComboBoxItem Content="SHWRM-A" IsSelected="True" />
                                    <ComboBoxItem Content="SHWRM-B" />
                                    <ComboBoxItem Content="Warehouse-Shelf-A" />
                                    <ComboBoxItem Content="Warehouse-Shelf-B" />
                                    <ComboBoxItem Content="A3" />
                                    <ComboBoxItem Content="BENCH-01" />
                                    <ComboBoxItem Content="Floor Pool" />
                                    <ComboBoxItem Content="Dispatched / Delivered" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Grade Option -->
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="ChkUpdateGrade" Content="Update Cosmetic Grade" FontWeight="SemiBold" Foreground="#F0F6FC"
                                          Checked="ChkUpdateGrade_Changed" Unchecked="ChkUpdateGrade_Changed" />
                                <TextBlock Text="Standardize condition grade across the batch" FontSize="10" Foreground="#8B949E" Margin="22,2,0,6" />
                                <ComboBox x:Name="CmbTargetGrade" Margin="22,0,0,0" Padding="8,5" IsEnabled="False">
                                    <ComboBoxItem Content="A+" IsSelected="True" />
                                    <ComboBoxItem Content="A" />
                                    <ComboBoxItem Content="B" />
                                    <ComboBoxItem Content="C" />
                                    <ComboBoxItem Content="Faulty" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Customer Option -->
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="ChkUpdateCustomer" Content="Assign Customer Name" FontWeight="SemiBold" Foreground="#F0F6FC"
                                          Checked="ChkUpdateCustomer_Changed" Unchecked="ChkUpdateCustomer_Changed" />
                                <TextBlock Text="Buyer / client name (especially when mass marking Sold)" FontSize="10" Foreground="#8B949E" Margin="22,2,0,6" />
                                <TextBox x:Name="TxtTargetCustomer" Margin="22,0,0,0" Padding="8,5" IsEnabled="False"
                                         ToolTip="Enter buyer or client company name" />
                            </StackPanel>
                        </Border>

                        <!-- Out Date Option -->
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="ChkUpdateOutDate" Content="Set Dispatch / Out Date" FontWeight="SemiBold" Foreground="#F0F6FC"
                                          Checked="ChkUpdateOutDate_Changed" Unchecked="ChkUpdateOutDate_Changed" />
                                <TextBlock Text="Date sold or dispatched (YYYY-MM-DD)" FontSize="10" Foreground="#8B949E" Margin="22,2,0,6" />
                                <TextBox x:Name="TxtTargetOutDate" Margin="22,0,0,0" Padding="8,5" IsEnabled="False" />
                            </StackPanel>
                        </Border>

                        <!-- Notes Append Option -->
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <CheckBox x:Name="ChkUpdateNotes" Content="Append to Notes / Remarks" FontWeight="SemiBold" Foreground="#F0F6FC"
                                          Checked="ChkUpdateNotes_Changed" Unchecked="ChkUpdateNotes_Changed" />
                                <TextBlock Text="Appends text to existing asset notes without overwriting" FontSize="10" Foreground="#8B949E" Margin="22,2,0,6" />
                                <TextBox x:Name="TxtTargetNotes" Margin="22,0,0,0" Padding="8,5" IsEnabled="False"
                                         ToolTip="Remarks to append to the assets" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── PROGRESS STRIP ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" x:Name="PanelProgress" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="TxtProgressStatus" Text="Applying mass update..." FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF" />
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#F0F6FC" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="PbMassProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                             Foreground="#1F6FEB" Background="#0D1117" BorderBrush="#30363D" />
            </StackPanel>
        </Border>

        <!-- ── FOOTER ACTIONS ────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Padding="0,12,0,0" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFooterHint" Text="Ready. Paste asset numbers or scan barcodes to begin."
                           FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" />

                <Button Grid.Column="1" x:Name="BtnCancel" Content="Close" Click="BtnCancel_Click"
                        Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="0,0,10,0" Padding="16,8" />

                <Button Grid.Column="2" x:Name="BtnApply" Click="BtnApply_Click"
                        Background="#1F6FEB" BorderBrush="#388BFD" Foreground="#FFFFFF" Padding="20,8" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtApplyBtn" Text="Execute Mass Update" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
