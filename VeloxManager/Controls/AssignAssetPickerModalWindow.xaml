<Window x:Class="VeloxManager.Controls.AssignAssetPickerModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeloxManager — Dispatch Depot Asset to Technician"
        Height="600" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#F0F6FC"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Search & Filter Strip -->
            <RowDefinition Height="Auto" />
            <!-- 2: Unassigned Assets Table -->
            <RowDefinition Height="*" />
            <!-- 3: Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📥" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DISPATCH DEPOT ASSET TO: " FontSize="15" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock x:Name="TxtTechHeader" Text="Technician Name" FontSize="15" FontWeight="Bold" Foreground="#58A6FF" />
                    </StackPanel>
                    <TextBlock Text="Select any unassigned or staging unit from depot inventory to assign to this operator's hardware bench."
                               FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search Strip -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"
                     Padding="10,6" FontSize="12"
                     ToolTip="Filter by Asset Tag, Serial Number, Model, or Rack Location..." />

            <TextBlock Grid.Column="1" x:Name="TxtAvailableCount" Text="0 Available Assets"
                       FontSize="11" Foreground="#8B949E" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>

        <!-- Assets Table -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="1" Margin="0,0,0,12">
            <DataGrid x:Name="GridAssets" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#0D1117" RowBackground="#0D1117" AlternatingRowBackground="#161B22"
                      Foreground="#F0F6FC" BorderThickness="0" SelectionMode="Single"
                      MouseDoubleClick="GridAssets_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ASSET TAG" Binding="{Binding AssetTag}" FontWeight="Bold" Width="130" />
                    <DataGridTextColumn Header="SERIAL NUMBER" Binding="{Binding SerialNumber}" Width="140" />
                    <DataGridTextColumn Header="MODEL" Binding="{Binding ModelName}" FontWeight="SemiBold" Width="*" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryBadge}" Width="100" />
                    <DataGridTextColumn Header="LOCATION" Binding="{Binding CurrentLocation}" Width="110" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="GRADE" Binding="{Binding GradeBadge}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="0,8,0,0" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtFeedback" Text="Double-click an asset or click 'Assign Selected' to dispatch."
                           FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="BtnCancel_Click"
                            Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                            Padding="16,8" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0" />
                    <Button x:Name="BtnAssign" Content="⚡ Dispatch to Technician" Click="BtnAssign_Click"
                            Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043" BorderThickness="1"
                            Padding="18,8" FontWeight="Bold" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
