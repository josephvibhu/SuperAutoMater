<Window x:Class="VeloxManager.Controls.ReassignAssetModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeloxManager — Reassign / Dispatch Asset"
        Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#F0F6FC"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Target Asset Info Card -->
            <RowDefinition Height="Auto" />
            <!-- 2: Destination Technician / Station Selector -->
            <RowDefinition Height="*" />
            <!-- 3: Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔄" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="ASSIGN / REASSIGN BENCH PRODUCT" FontSize="16" FontWeight="Bold" Foreground="#58A6FF" />
                    <TextBlock Text="Dispatch unit to a technician bench or unassign to depot general pool." FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Asset Info Card -->
        <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtAssetTag" Text="TAG-0000" FontSize="15" FontWeight="Bold" Foreground="#58A6FF" />
                        <TextBlock Text=" • " Foreground="#8B949E" />
                        <TextBlock x:Name="TxtSerialNumber" Text="SN-000000" FontSize="13" Foreground="#8B949E" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TxtModel" Text="Model Description" FontSize="13" Foreground="#F0F6FC" Margin="0,4,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Current Station / Tech: " FontSize="11" Foreground="#8B949E" />
                        <TextBlock x:Name="TxtCurrentAssigned" Text="Unassigned" FontSize="11" FontWeight="SemiBold" Foreground="#D29922" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" x:Name="BadgeStatus" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtQueueStatus" Text="ActiveTesting" FontSize="11" FontWeight="Bold" Foreground="#3FB950" />
                </Border>
            </Grid>
        </Border>

        <!-- Assignment Form -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="SELECT TARGET TECHNICIAN / DESTINATION:" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
            <ComboBox x:Name="CmbTechnician" Margin="0,0,0,14" Height="36" VerticalContentAlignment="Center" />

            <TextBlock Text="BENCH INSTRUCTIONS / DISPATCH NOTE (OPTIONAL):" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6" />
            <TextBox x:Name="TxtDispatchNote" Height="50" TextWrapping="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                     ToolTip="Add priority instructions for the technician (e.g. 'Priority customer order - upgrade to 16GB RAM')" />
        </StackPanel>

        <!-- Footer Buttons -->
        <Border Grid.Row="3" Padding="0,12,0,0" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtFeedback" Text="" FontSize="11" Foreground="#58A6FF" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="BtnCancel_Click"
                            Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                            Padding="16,8" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0" />
                    <Button x:Name="BtnConfirm" Content="✓ Apply Assignment" Click="BtnConfirm_Click"
                            Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043" BorderThickness="1"
                            Padding="18,8" FontWeight="Bold" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
