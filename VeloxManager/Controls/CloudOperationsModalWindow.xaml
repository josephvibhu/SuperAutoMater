<Window x:Class="VeloxManager.Controls.CloudOperationsModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Railway Cloud Database Operations"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="18" Foreground="#58A6FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="CLOUD DATABASE OPERATIONS" FontWeight="Bold" FontSize="16" Foreground="#F0F6FC" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Manage live database backups, restore archives, or wipe test devices on Railway"
                               FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Click="CloseButton_Click"
                        Background="Transparent" Foreground="#8B949E" BorderThickness="0"
                        FontSize="15" FontWeight="Bold" Padding="8,4" Cursor="Hand" />
            </Grid>

            <!-- Cloud Connection Status Banner -->
            <Border Grid.Row="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CLOUD API ENDPOINT" FontSize="9" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock x:Name="TxtApiUrl" Text="https://velox-api-production.up.railway.app" FontWeight="SemiBold" FontSize="12" Foreground="#58A6FF" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#238636" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCloudStatus" Text="● RAILWAY LIVE" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" />
                    </Border>
                </Grid>
            </Border>

            <!-- 3 Major Action Cards -->
            <StackPanel Grid.Row="2">
                <!-- Card 1: Backup / Export -->
                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Create Cloud Database Backup" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Export all assets, fitted BOM items, technician work logs, and depot data into a single .json backup file."
                                       FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="💾 Export Backup (.json)" Click="BtnBackup_Click"
                                Background="#21262D" Foreground="#F0F6FC" BorderBrush="#388BFD" BorderThickness="1"
                                FontWeight="Bold" FontSize="11" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Card 2: Restore Backup -->
                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="📥" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Restore Cloud Database from Backup" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Upload a previously saved .json backup file to Railway cloud to restore your assets and configuration."
                                       FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="📥 Restore Backup (.json)" Click="BtnRestore_Click"
                                Background="#1F6FEB" Foreground="#FFFFFF" BorderBrush="#388BFD" BorderThickness="1"
                                FontWeight="Bold" FontSize="11" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Card 3: Purge Stale / Test Data -->
                <Border Background="#0D1117" BorderBrush="#DA3633" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Delete Previous Entries (Purge Stale Test Data)" FontWeight="Bold" FontSize="13" Foreground="#F85149" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Wipe test assets and history logs from Railway to start clean with real inventory. Employee logins, stations, and API keys are preserved."
                                       FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="🗑️ Purge Test Assets" Click="BtnPurge_Click"
                                Background="#DA3633" Foreground="#FFFFFF" BorderBrush="#F85149" BorderThickness="1"
                                FontWeight="Bold" FontSize="11" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Status Message Bar -->
            <Border Grid.Row="3" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <TextBlock x:Name="TxtStatus" Text="Ready. All operations run directly on Railway Cloud."
                           FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
