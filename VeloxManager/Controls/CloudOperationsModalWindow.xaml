<Window x:Class="VeloxManager.Controls.CloudOperationsModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AWS Cloud Database Operations"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontSans}">

    <Border Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="18" Foreground="{DynamicResource TokenBrandBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="AWS CLOUD DATABASE OPERATIONS" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TokenTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Manage live database backups, restore archives, or wipe test devices on AWS Lightsail"
                               FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Click="CloseButton_Click"
                        Background="Transparent" Foreground="{DynamicResource TokenTextMutedBrush}" BorderThickness="0"
                        FontSize="15" FontWeight="Bold" Padding="8,4" Cursor="Hand" />
            </Grid>

            <!-- Cloud Connection Status Banner -->
            <Border Grid.Row="1" Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CLOUD API ENDPOINT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TokenTextMutedBrush}" />
                        <TextBlock x:Name="TxtApiUrl" Text="http://13.206.106.146" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TokenBrandBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource TokenSuccessBgBrush}" BorderBrush="{DynamicResource TokenSuccessBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCloudStatus" Text="● AWS CLOUD LIVE" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TokenSuccessBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 3 Major Action Cards -->
            <StackPanel Grid.Row="2">
                <!-- Card 1: Backup / Export -->
                <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Create Cloud Database Backup" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TokenTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Export all assets, fitted BOM items, technician work logs, and depot data into a single .json backup file."
                                       FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="💾 Export Backup (.json)" Click="BtnBackup_Click"
                                Background="{DynamicResource TokenBgCardBrush}" Foreground="{DynamicResource TokenTextPrimaryBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1"
                                FontWeight="Bold" FontSize="11" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Card 2: Restore Backup -->
                <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="📥" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Restore Cloud Database from Backup" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TokenTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Upload a previously saved .json backup file to AWS Cloud to restore your assets and configuration."
                                       FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="📥 Restore Backup (.json)" Click="BtnRestore_Click"
                                Background="{DynamicResource TokenBrandSolidBrush}" Foreground="#FFFFFF" BorderThickness="0"
                                FontWeight="Bold" FontSize="11" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Card 3: Purge Stale / Test Data -->
                <Border Background="{DynamicResource TokenDangerBgBrush}" BorderBrush="{DynamicResource TokenDangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Delete Previous Entries (Purge Stale Test Data)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TokenDangerBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Wipe test assets and history logs from AWS Cloud to start clean with real inventory. Employee logins, stations, and API keys are preserved."
                                       FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="🗑️ Purge Test Assets" Click="BtnPurge_Click"
                                Background="{DynamicResource TokenDangerBrush}" Foreground="#FFFFFF" BorderThickness="0"
                                FontWeight="Bold" FontSize="11" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Status Message Bar -->
            <Border Grid.Row="3" Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <TextBlock x:Name="TxtStatus" Text="Ready. All operations run directly on AWS Lightsail."
                           FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
