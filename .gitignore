# ====================================================================
# AutoMater Diagnostic Tool — Git Ignore Rules
# ====================================================================

# Build & Compilation Output
[Bb]in/
[Oo]bj/
out/
publish/

# Local Compiled Releases
# Note: Standalone single-file EXEs (~150MB-205MB) exceed GitHub's 100MB file limit.
# Releases are stored locally in the Releases/ folders and distributed via USB/network drive.
**/Releases/
[Rr]eleases/

# Local Diagnostic Telemetry & Workstation Caches
offline_sync_queue.json
*.log
CrashDump/
*.tmp
scratch/

# Visual Studio & IDE Configuration
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Windows System Files
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
