<Application x:Class="VeloxHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Global Theme Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#070a12"/>
        <SolidColorBrush x:Key="BgCard" Color="#0e1526"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#152038"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#1e293b"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563eb"/>
        <SolidColorBrush x:Key="PrimaryBlueLight" Color="#3b82f6"/>
        <SolidColorBrush x:Key="TextMain" Color="#f8fafc"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94a3b8"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10b981"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#f59e0b"/>
        <SolidColorBrush x:Key="DangerRed" Color="#ef4444"/>
    </Application.Resources>
</Application>
