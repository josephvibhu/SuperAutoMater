<Application x:Class="VeloxHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/TokensDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Typography & Font Families -->
            <FontFamily x:Key="FontUi">Source Sans 3, Segoe UI, Inter, sans-serif</FontFamily>
            <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Courier New, monospace</FontFamily>

            <!-- Semantic Token Aliases for Backward Compatibility -->
            <SolidColorBrush x:Key="BgDark" Color="{DynamicResource ColorBgApp}"/>
            <SolidColorBrush x:Key="BgCard" Color="{DynamicResource ColorBgCard}"/>
            <SolidColorBrush x:Key="BgCardHover" Color="{DynamicResource ColorBgHover}"/>
            <SolidColorBrush x:Key="BorderBrushColor" Color="{DynamicResource ColorBorderSubtle}"/>
            <SolidColorBrush x:Key="PrimaryBlue" Color="{DynamicResource ColorBrandSolid}"/>
            <SolidColorBrush x:Key="PrimaryBlueLight" Color="{DynamicResource ColorBrand}"/>
            <SolidColorBrush x:Key="TextMain" Color="{DynamicResource ColorTextPrimary}"/>
            <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource ColorTextMuted}"/>
            <SolidColorBrush x:Key="SuccessGreen" Color="{DynamicResource ColorSuccess}"/>
            <SolidColorBrush x:Key="WarningAmber" Color="{DynamicResource ColorWarning}"/>
            <SolidColorBrush x:Key="DangerRed" Color="{DynamicResource ColorDanger}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
