<Window x:Class="VeloxHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velox Hub — Refurbishing &amp; Diagnostics Application Suite" 
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#070a12"
        Foreground="#f8fafc"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#141f36"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="700"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3b82f6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="#64748b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- Top Header -->
            <RowDefinition Height="*"/>   <!-- Workspace -->
        </Grid.RowDefinitions>

        <!-- ── TOP GLOBAL HEADER ── -->
        <Border Grid.Row="0" Background="#0b101d" BorderBrush="#1e293b" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563eb" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VELOX " FontWeight="800" FontSize="18" Foreground="#ffffff"/>
                            <TextBlock Text="HUB" FontWeight="800" FontSize="18" Foreground="#3b82f6"/>
                        </StackPanel>
                        <TextBlock Text="Creative Cloud for Refurbishers" FontSize="10" Foreground="#64748b" FontWeight="600"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Banner / Status -->
                <TextBlock Grid.Column="1" x:Name="TxtStatusBanner" Text="Connecting to Velox Cloud..." 
                           Foreground="#94a3b8" FontSize="13" FontWeight="500" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Right Actions: License Pill & Change Key -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#141f36" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="#10b981" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtLicensePill" Text="Verified License" FontSize="12" FontWeight="700" Foreground="#f8fafc"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Change Key" Click="BtnChangeKey_Click" Style="{StaticResource SidebarBtn}" Padding="10,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── MAIN WORKSPACE ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Left Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Apps Catalog -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT SIDEBAR ── -->
            <Border Grid.Column="0" Background="#090e1a" BorderBrush="#1e293b" BorderThickness="0,0,1,0" Padding="16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="APPLICATIONS" FontSize="11" FontWeight="800" Foreground="#64748b" Margin="10,0,0,10"/>
                        <Button x:Name="BtnNavAll" Content="⚡ All Applications" Click="BtnNavAll_Click" Style="{StaticResource SidebarBtn}" Background="#141f36" Foreground="#ffffff"/>
                        <Button x:Name="BtnNavInstalled" Content="✓ Installed" Click="BtnNavInstalled_Click" Style="{StaticResource SidebarBtn}"/>
                        <Button x:Name="BtnNavRefresh" Content="🔄 Refresh Status" Click="BtnNavRefresh_Click" Style="{StaticResource SidebarBtn}"/>
                    </StackPanel>

                    <!-- Bottom Depot Workstation Info -->
                    <Border Grid.Row="2" Background="#0e1526" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="WORKSTATION ID" FontSize="10" FontWeight="800" Foreground="#64748b" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMachineGuid" Text="BENCH-QC-01" FontSize="12" FontWeight="700" Foreground="#f8fafc" Margin="0,0,0,8"/>
                            <TextBlock Text="CLOUD CLUSTER" FontSize="10" FontWeight="800" Foreground="#64748b" Margin="0,0,0,4"/>
                            <TextBlock Text="13.206.106.146 (ap-south-1)" FontSize="11" Foreground="#38bdf8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── APPS CATALOG VIEW (CREATIVE CLOUD STYLE) ── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30">
                <StackPanel>
                    <TextBlock Text="Apps in Your Depot Suite" FontSize="26" FontWeight="800" Foreground="#ffffff" Margin="0,0,0,6"/>
                    <TextBlock Text="Install, launch, and update applications entitled by your organization's subscription key." FontSize="14" Foreground="#94a3b8" Margin="0,0,0,24"/>

                    <!-- Items Control for Apps -->
                    <ItemsControl x:Name="AppsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0e1526" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- App Icon Box -->
                                        <Border Grid.Column="0" Background="#141f36" CornerRadius="10" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding IconSymbol}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- App Details -->
                                        <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="800" Foreground="#ffffff" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding LocalVersion}" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- Entitlement Pill -->
                                                <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEntitled}" Value="True">
                                                                    <Setter Property="Background" Value="#2610b981"/>
                                                                    <Setter Property="BorderBrush" Value="#10b981"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEntitled}" Value="False">
                                                                    <Setter Property="Background" Value="#26ef4444"/>
                                                                    <Setter Property="BorderBrush" Value="#ef4444"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding EntitlementBadge}" FontSize="10" FontWeight="800">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEntitled}" Value="True">
                                                                        <Setter Property="Foreground" Value="#10b981"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEntitled}" Value="False">
                                                                        <Setter Property="Foreground" Value="#ef4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Tagline}" FontSize="13" FontWeight="600" Foreground="#60a5fa" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="18"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#64748b" FontWeight="600"/>
                                        </StackPanel>

                                        <!-- Action Column (Install/Launch Button) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button Content="{Binding ActionButtonText}" 
                                                    IsEnabled="{Binding CanInstallOrLaunch}" 
                                                    Click="BtnAppAction_Click" 
                                                    Style="{StaticResource ActionBtn}"
                                                    Width="160"/>
                                            
                                            <!-- Progress Bar (shown when installing) -->
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,8,0,0"
                                                         Foreground="#3b82f6" Background="#141f36" BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Installing">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── LICENSE KEY INPUT & ACTIVATION MODAL (OVERLAY) ── -->
        <Grid x:Name="LicenseModal" Grid.RowSpan="2" Background="#D9070a12" Visibility="Collapsed">
            <Border Background="#0e1526" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="16" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#2563eb" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="🔑" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Depot License Activation" FontSize="20" FontWeight="800" Foreground="#ffffff" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Enter your organization subscription key to unlock entitled applications and bind this workstation to your depot cloud cluster." 
                               FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18"/>

                    <!-- Key Input Box -->
                    <TextBox x:Name="TxtModalKeyInput" 
                             Background="#070a12" Foreground="#ffffff" 
                             BorderBrush="#2563eb" BorderThickness="1.5" 
                             Padding="12,10" FontSize="15" FontWeight="700" 
                             FontFamily="Consolas, monospace"
                             Margin="0,0,0,12"/>

                    <!-- Status / Feedback Message -->
                    <TextBlock x:Name="TxtModalStatus" 
                               Text="" 
                               FontSize="12" FontWeight="600" 
                               Foreground="#f59e0b" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,16"/>

                    <!-- Success Details Card (Hidden until verified) -->
                    <Border x:Name="PnlModalSuccess" Background="#141f36" BorderBrush="#10b981" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✓ LICENSE VERIFIED" FontSize="12" FontWeight="800" Foreground="#10b981"/>
                                <TextBlock x:Name="TxtSuccessTier" Text=" • Starter Depot Plan" FontSize="12" FontWeight="800" Foreground="#38bdf8"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSuccessCompany" Text="Abzard Electronics Depot" FontSize="14" FontWeight="700" Foreground="#ffffff" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSuccessQuota" Text="Monthly Quota: 100 laptops (1,000 onboarding allowance)" FontSize="12" Foreground="#94a3b8" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtSuccessSeats" Text="Workstations: 1 of 5 active seats" FontSize="12" Foreground="#94a3b8"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnModalCancel" Content="Cancel" Click="BtnModalCancel_Click" Style="{StaticResource SidebarBtn}" Margin="0,0,10,0" Padding="16,8"/>
                        <Button x:Name="BtnModalActivate" Content="Activate Key" Click="BtnModalActivate_Click" Style="{StaticResource ActionBtn}" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>