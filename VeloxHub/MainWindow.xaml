<Window x:Class="VeloxHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velox Hub — Unified Diagnostic Platform Suite" 
        Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TokenBgAppBrush}"
        Foreground="{DynamicResource TokenTextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}">

    <Window.Resources>
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TokenBgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Brand Violet per Handoff) -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TokenBrandSolidBrush}"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="700"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TokenBrandBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource TokenBgInsetBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TokenTextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TokenBgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- Top Header -->
            <RowDefinition Height="*"/>   <!-- Workspace -->
        </Grid.RowDefinitions>

        <!-- ── TOP GLOBAL HEADER ── -->
        <Border Grid.Row="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand: Official Velox Hub Vector Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="38" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Canvas Width="50" Height="44">
                            <!-- Outlined V Shape (Neutral Surface Color) -->
                            <Path Data="M7 5L22 39L32 16" Stroke="{DynamicResource TokenTextPrimaryBrush}" StrokeThickness="9" StrokeLineJoin="Bevel"/>
                            <!-- Right Tip Accent (Hub Magenta) -->
                            <Path Data="M27 27.5L32 16" Stroke="{DynamicResource TokenAppHubBrush}" StrokeThickness="9"/>
                            <!-- Official App Letter H (Hub Magenta) -->
                            <Path Data="M37.65 1.5V14.5M46.55 1.5V14.5M37.65 8H46.55" Stroke="{DynamicResource TokenAppHubBrush}" StrokeThickness="2.9" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VELOX" FontWeight="800" FontSize="18" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="HUB" FontWeight="400" FontSize="18" Foreground="{DynamicResource TokenAppHubBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Creative Cloud for Refurbishing Depots" FontSize="10" Foreground="{DynamicResource TokenTextMutedBrush}" FontWeight="600"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Banner / Status -->
                <TextBlock Grid.Column="1" x:Name="TxtStatusBanner" Text="Connecting to Velox Cloud..." 
                           Foreground="{DynamicResource TokenTextSecondaryBrush}" FontSize="13" FontWeight="500" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Right Actions: Theme Toggle, License Pill & Change Key -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Quick Theme Toggle -->
                    <Button x:Name="BtnThemeToggle" Content="🌙 Dark" Click="BtnThemeToggle_Click" Style="{StaticResource GhostBtn}" Margin="0,0,12,0" ToolTip="Switch Theme (Dark / Light / System)"/>

                    <!-- Verified License Pill -->
                    <Border Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="{DynamicResource TokenSuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtLicensePill" Text="Verified License" FontSize="12" FontWeight="700" Foreground="{DynamicResource TokenTextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Change Key" Click="BtnChangeKey_Click" Style="{StaticResource GhostBtn}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── MAIN WORKSPACE ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/> <!-- Left Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Apps Catalog -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT SIDEBAR ── -->
            <Border Grid.Column="0" Background="{DynamicResource TokenBgPanelBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="APPLICATIONS" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="800" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="8,0,0,12"/>
                        <Button x:Name="BtnNavAll" Content="⚡ All Applications" Click="BtnNavAll_Click" Style="{StaticResource SidebarBtn}" Background="{DynamicResource TokenBgHoverBrush}" Foreground="{DynamicResource TokenTextPrimaryBrush}"/>
                        <Button x:Name="BtnNavInstalled" Content="✓ Installed" Click="BtnNavInstalled_Click" Style="{StaticResource SidebarBtn}"/>
                        <Button x:Name="BtnNavRefresh" Content="🔄 Refresh Status" Click="BtnNavRefresh_Click" Style="{StaticResource SidebarBtn}"/>
                    </StackPanel>

                    <!-- Bottom Depot Workstation Info -->
                    <Border Grid.Row="2" Background="{DynamicResource TokenBgCardBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="WORKSTATION ID" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="800" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMachineGuid" Text="BENCH-QC-01" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="700" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="CLOUD CLUSTER" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="800" Foreground="{DynamicResource TokenTextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="13.206.106.146 (ap-south-1)" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TokenBrandBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── APPS CATALOG VIEW (CREATIVE CLOUD STYLE) ── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
                <StackPanel>
                    <TextBlock Text="Apps in Your Depot Suite" FontSize="26" FontWeight="800" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Install, launch, and update applications entitled by your organization's subscription key." FontSize="14" Foreground="{DynamicResource TokenTextSecondaryBrush}" Margin="0,0,0,24"/>

                    <!-- Items Control for Apps -->
                    <ItemsControl x:Name="AppsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource TokenBgCardBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- App Icon Box with App Letter Badge -->
                                        <Border Grid.Column="0" Background="{DynamicResource TokenBgInsetBrush}" BorderBrush="{DynamicResource TokenBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Width="52" Height="52" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppLetter}" FontSize="24" FontWeight="900" Foreground="{Binding AccentColorHex}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- App Details -->
                                        <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="800" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding LocalVersion}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- Entitlement Pill -->
                                                <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEntitled}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource TokenSuccessBgBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource TokenSuccessBorderBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEntitled}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource TokenDangerBgBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource TokenDangerBorderBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding EntitlementBadge}" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="800">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEntitled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TokenSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEntitled}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TokenDangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Tagline}" FontSize="13" FontWeight="600" Foreground="{DynamicResource TokenBrandBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TokenTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="18"/>
                                            <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TokenTextMutedBrush}" FontWeight="600"/>
                                        </StackPanel>

                                        <!-- Action Column (Install/Launch + Uninstall Buttons) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="{Binding ActionButtonText}" 
                                                        IsEnabled="{Binding CanInstallOrLaunch}" 
                                                        Click="BtnAppAction_Click" 
                                                        Style="{StaticResource ActionBtn}"
                                                        Width="120"/>

                                                <!-- Uninstall Button (Visible only when installed and action is EXE) -->
                                                <Button Content="Uninstall" 
                                                        Click="BtnAppUninstall_Click" 
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TokenDangerBrush}"
                                                        BorderBrush="{DynamicResource TokenDangerBorderBrush}"
                                                        BorderThickness="1"
                                                        FontSize="12"
                                                        FontWeight="600"
                                                        Padding="10,6"
                                                        Margin="8,0,0,0"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource TokenDangerBgBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding State}" Value="Installed"/>
                                                                        <Condition Binding="{Binding ActionType}" Value="EXE"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                            
                                            <!-- Progress Bar (shown when installing) -->
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,8,0,0"
                                                         Foreground="{DynamicResource TokenBrandBrush}" Background="{DynamicResource TokenBgInsetBrush}" BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Installing">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── LICENSE KEY INPUT & ACTIVATION MODAL (OVERLAY) ── -->
        <Grid x:Name="LicenseModal" Grid.RowSpan="2" Background="#D90B0D11" Visibility="Collapsed">
            <Border Background="{DynamicResource TokenBgCardBrush}" BorderBrush="{DynamicResource TokenBorderStrongBrush}" BorderThickness="1" CornerRadius="12" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{DynamicResource TokenBrandSubtleBrush}" BorderBrush="{DynamicResource TokenBrandBrush}" BorderThickness="1" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                            <TextBlock Text="🔑" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtModalTitle" Text="Depot License Activation" FontSize="20" FontWeight="800" Foreground="{DynamicResource TokenTextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtModalSubtitle" Text="Enter your organization subscription key to unlock entitled applications and bind this workstation to your depot cloud cluster." 
                               FontSize="13" Foreground="{DynamicResource TokenTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18"/>

                    <!-- Key Input Box -->
                    <TextBox x:Name="TxtModalKeyInput" 
                             Background="{DynamicResource TokenBgInsetBrush}" Foreground="{DynamicResource TokenTextPrimaryBrush}" 
                             BorderBrush="{DynamicResource TokenBrandBrush}" BorderThickness="1.5" 
                             Padding="12,10" FontSize="15" FontWeight="700" 
                             FontFamily="{StaticResource FontMono}"
                             Margin="0,0,0,12"/>

                    <!-- Status / Feedback Message -->
                    <TextBlock x:Name="TxtModalStatus" 
                               Text="" 
                               FontSize="12" FontWeight="600" 
                               Foreground="{DynamicResource TokenWarningBrush}" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,16"/>

                    <!-- Success Details Card (Hidden until verified) -->
                    <Border x:Name="PnlModalSuccess" Background="{DynamicResource TokenSuccessBgBrush}" BorderBrush="{DynamicResource TokenSuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✓ LICENSE VERIFIED" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="800" Foreground="{DynamicResource TokenSuccessBrush}"/>
                                <TextBlock x:Name="TxtSuccessTier" Text=" • Starter Depot Plan" FontSize="12" FontWeight="800" Foreground="{DynamicResource TokenBrandBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSuccessCompany" Text="Abzard Electronics Depot" FontSize="14" FontWeight="700" Foreground="{DynamicResource TokenTextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSuccessQuota" Text="Monthly Quota: 100 laptops (1,000 onboarding allowance)" FontSize="12" Foreground="{DynamicResource TokenTextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtSuccessSeats" Text="Workstations: 1 of 5 active seats" FontSize="12" Foreground="{DynamicResource TokenTextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnModalCancel" Content="Cancel" Click="BtnModalCancel_Click" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Padding="16,8"/>
                        <Button x:Name="BtnModalActivate" Content="Activate Key" Click="BtnModalActivate_Click" Style="{StaticResource ActionBtn}" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
