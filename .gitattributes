# Auto-detect text files and normalize line endings
* text=auto

# Source code files
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.xml text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.gs text eol=crlf

# Binary files
*.ico binary
*.exe binary
*.dll binary
*.h text eol=crlf
