    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ItamService</AssemblyName>
    <Product>SuperAutoMater ITAM Service</Product>
    <Version>1.6.7</Version>
