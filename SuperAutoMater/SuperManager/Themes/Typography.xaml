<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontSans">Segoe UI, -apple-system, Roboto, Helvetica Neue, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <Style x:Key="TextHeaderLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
    </Style>

    <Style x:Key="TextKpiValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource BrushAccentBlue}"/>
    </Style>

    <Style x:Key="TextKpiLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSubdued}"/>
    </Style>

    <Style x:Key="TextBadgeMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

</ResourceDictionary>
