<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral Obsidian Void Dark Palette -->
    <Color x:Key="ColorObsidianVoid">#0B0C10</Color>
    <Color x:Key="ColorObsidianMid">#101217</Color>
    <Color x:Key="ColorObsidianTop">#14171F</Color>

    <!-- Functional Accent Colors -->
    <Color x:Key="ColorAccentEmerald">#2EA043</Color>
    <Color x:Key="ColorAccentEmeraldLight">#3FB950</Color>
    <Color x:Key="ColorAccentBlue">#58A6FF</Color>
    <Color x:Key="ColorAccentCyan">#58A6FF</Color>
    <Color x:Key="ColorAccentAmber">#D29922</Color>
    <Color x:Key="ColorAccentRed">#F85149</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushObsidianVoid" Color="#0B0C10"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="#161B22"/>
    <SolidColorBrush x:Key="BrushActiveCard" Color="#21262D"/>
    <SolidColorBrush x:Key="BrushBorderDark" Color="#30363D"/>
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="#262C36"/>

    <!-- High-Contrast Text Brushes -->
    <SolidColorBrush x:Key="BrushTextWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#C9D1D9"/>
    <SolidColorBrush x:Key="BrushTextSubdued" Color="#8B949E"/>
    <SolidColorBrush x:Key="BrushAccentBlue" Color="#58A6FF"/>
    <SolidColorBrush x:Key="BrushAccentCyan" Color="#58A6FF"/>
    <SolidColorBrush x:Key="BrushAccentEmerald" Color="#3FB950"/>
    <SolidColorBrush x:Key="BrushAccentAmber" Color="#D29922"/>
    <SolidColorBrush x:Key="BrushAccentRed" Color="#F85149"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="BrushTopBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#12151C" Offset="0.0"/>
        <GradientStop Color="#181D26" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPassButton" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2EA043" Offset="0.0"/>
        <GradientStop Color="#238636" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
