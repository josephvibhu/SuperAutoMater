<Window x:Class="SuperManager.Views.BenchDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bench Remote Telemetry &amp; Diagnostics Inspection"
        Height="540" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#0E1116"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Header -->
            <RowDefinition Height="*"/>    <!-- Telemetry Cards -->
            <RowDefinition Height="Auto"/> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BrushTopBarGradient}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="💻 " FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtMachineName" Text="BENCH-01" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="14" Foreground="{StaticResource BrushTextWhite}"/>
                            <Border Background="#21262D" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtIpBadge" Text="192.168.1.50:8443" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtModelSerial" Text="ThinkPad T14 Gen 2 · S/N: PF2X89" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextSubdued}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1C261D" BorderBrush="#3FB950" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <TextBlock x:Name="TxtGradeBadge" Text="GRADE A+" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#3FB950"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. TELEMETRY DETAILS -->
        <Border Grid.Row="1" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Progress Bar -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="DIAGNOSTIC PIPELINE PROGRESS" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextSubdued}"/>
                        <TextBlock x:Name="TxtProgressText" DockPanel.Dock="Right" Text="9/11 PASSED" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#58A6FF"/>
                    </DockPanel>
                    <ProgressBar x:Name="ProgBarPipeline" Height="8" Minimum="0" Maximum="100" Value="81" Foreground="#3FB950" Background="#0D1117" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"/>
                </StackPanel>

                <!-- 2x3 Spec Matrix -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CPU -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="PROCESSOR &amp; THERMALS" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                            <TextBlock x:Name="TxtCpuSpec" Text="Intel Core i7-1185G7 @ 3.00GHz" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextWhite}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtCpuThermals" Text="48°C · Load: 12%" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#58A6FF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM -->
                    <Border Grid.Row="0" Grid.Column="2" Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="MEMORY &amp; CHANNEL TOPOLOGY" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                            <TextBlock x:Name="TxtRamSpec" Text="16GB DDR4 @ 3200MHz" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextWhite}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtRamTopology" Text="Dual-Channel Symmetric" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#3FB950" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- BATTERY -->
                    <Border Grid.Row="2" Grid.Column="0" Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="BATTERY PACK INTEGRITY" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                            <TextBlock x:Name="TxtBatteryCharge" Text="88% (Discharging on Battery)" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextWhite}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtBatteryHealth" Text="94% Health · 51,200 mWh" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#3FB950" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- STORAGE -->
                    <Border Grid.Row="2" Grid.Column="2" Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="NVME / SSD STORAGE" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                            <TextBlock x:Name="TxtStorageSpec" Text="Samsung PM981a 512GB NVMe" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextWhite}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtStorageHealth" Text="100% Health (0 Bad Sectors)" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#3FB950" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ACTIVE TEST -->
                    <Border Grid.Row="4" Grid.Column="0" Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="ACTIVE BENCH WORKLOAD" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                            <TextBlock x:Name="TxtActiveTest" Text="Controlled Drain Mode" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="#58A6FF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- STATUS & ALERT -->
                    <Border Grid.Row="4" Grid.Column="2" Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="HEARTBEAT / CONNECTION" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                            <TextBlock x:Name="TxtHeartbeat" Text="Connected · 2s ago" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="11" Foreground="#3FB950" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. ACTIONS FOOTER -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="📍 PING / IDENTIFY" Style="{StaticResource StyleWarningActionBtn}" Click="BtnPing_Click" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="🖥️ REMOTE DESKTOP" Style="{StaticResource StylePrimaryActionBtn}" Click="BtnRemoteDesktop_Click" Margin="0,0,8,0" Padding="12,6" ToolTip="Open live interactive Remote Desktop mirror"/>
                    <Button Content="📄 ARCHIVE CERT" Style="{StaticResource StyleDarkActionBtn}" Click="BtnDownloadCert_Click" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="🌐 OPEN WEB HUD" Style="{StaticResource StyleDarkActionBtn}" Click="BtnOpenWeb_Click" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="✓ REMOTE PASS" Style="{StaticResource StylePassActionBtn}" Click="BtnRemotePass_Click" Padding="12,6"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕ CLOSE [ESC]" Style="{StaticResource StyleDarkActionBtn}" Click="BtnClose_Click" Padding="16,6"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
