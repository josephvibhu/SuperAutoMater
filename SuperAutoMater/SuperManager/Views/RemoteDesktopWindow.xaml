<Window x:Class="SuperManager.Views.RemoteDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Bench Desktop — SuperManager"
        Height="760" Width="1180"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#0B0C10"
        Foreground="#F0F6FC"
        Icon="pack://application:,,,/app.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Action Header -->
            <RowDefinition Height="*"/>    <!-- Live Screen Viewport -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP ACTION HEADER -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <!-- Left: Bench Info -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="💻 " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMachineName" Text="BENCH-01" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#1F324D" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtIpPort" Text="192.168.1.105:8443" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF"/>
                    </Border>
                    <CheckBox x:Name="ChkInteractive" Content="Interactive Mouse &amp; Keyboard" IsChecked="True" Foreground="#3FB950" FontFamily="{StaticResource FontSans}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </StackPanel>

                <!-- Right: Quick Commands -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="📁 CMD" Style="{StaticResource StyleDarkActionBtn}" Click="BtnCmd_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10" ToolTip="Launch CMD prompt on laptop"/>
                    <Button Content="⚙️ TaskMgr" Style="{StaticResource StyleDarkActionBtn}" Click="BtnTaskMgr_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10" ToolTip="Open Task Manager"/>
                    <Button Content="🪟 Desktop" Style="{StaticResource StyleDarkActionBtn}" Click="BtnShowDesktop_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10" ToolTip="Minimize all windows (Win+D)"/>
                    <Button Content="↵ Enter" Style="{StaticResource StyleDarkActionBtn}" Click="BtnEnter_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                    <Button Content="ESC" Style="{StaticResource StyleDarkActionBtn}" Click="BtnEsc_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                    <Button Content="✓ Remote Pass" Style="{StaticResource StylePassActionBtn}" Click="BtnPass_Click" Margin="0,0,10,0" Padding="10,4" FontSize="10" ToolTip="Mark active QC test as passed"/>
                    <Button Content="✕ Disconnect" Style="{StaticResource StyleDarkActionBtn}" Click="BtnClose_Click" Padding="10,4" FontSize="10"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. SCREEN VIEWPORT -->
        <Border Grid.Row="1" Background="#000000" ClipToBounds="True">
            <Grid x:Name="GridScreen" Focusable="True" Background="#000000">
                <Image x:Name="ImgScreen"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="LowQuality"
                       MouseDown="ImgScreen_MouseDown"
                       MouseUp="ImgScreen_MouseUp"
                       MouseMove="ImgScreen_MouseMove"
                       MouseWheel="ImgScreen_MouseWheel"/>

                <!-- Connecting / Error Overlay -->
                <StackPanel x:Name="OverlayConnecting" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="🔄 Connecting to live desktop stream..." FontFamily="{StaticResource FontSans}" FontSize="14" Foreground="#8B949E" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtOverlayHint" Text="Connecting to bench..." FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="TxtStatus" Text="● Connected" Foreground="#3FB950" FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text=" · Click screen to interact · Keystrokes pass through when window is focused" Foreground="#8B949E" FontFamily="{StaticResource FontSans}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="TxtFps" Text="-- FPS" Foreground="#58A6FF" FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
