<Window x:Class="SuperManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuperManager — Master Warehouse Fleet Server &amp; Diagnostics Cockpit"
        Height="840" Width="1360"
        MinHeight="520" MinWidth="850"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Top Avionics Header & KPIs -->
            <RowDefinition Height="Auto"/> <!-- 2. Filter & Actions Bar -->
            <RowDefinition Height="*"/>    <!-- 3. Master Fleet Grid -->
            <RowDefinition Height="Auto"/> <!-- 4. Bottom Avionics Status Bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP AVIONICS HEADER & WAREHOUSE FLOOR KPIS                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushTopBarGradient}"
                BorderBrush="{StaticResource BrushBorderDark}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title & Subnet Info -->
                    <ColumnDefinition Width="*"/>    <!-- 5 KPI Cards Row -->
                    <ColumnDefinition Width="Auto"/> <!-- Mobile Web Server Pill -->
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SUPERMANAGER" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="17" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                        <Border Background="#1F324D" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MASTER FLEET SERVER" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Autonomous Subnet Discovery · Real-Time Telemetry · Central Archiving" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushTextSubdued}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Center: 5 KPI Bento Cards -->
                <!-- Center: 5 KPI Bento Cards -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Active Benches -->
                    <Border Grid.Column="0" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ONLINE BENCHES" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TotalActiveBenches}" Style="{StaticResource TextKpiValue}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Testing Now -->
                    <Border Grid.Column="2" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TESTING NOW" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TotalTesting}" Style="{StaticResource TextKpiValue}" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Completed Today -->
                    <Border Grid.Column="4" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="COMPLETED TODAY" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TotalCompletedToday}" Style="{StaticResource TextKpiValue}" Foreground="#3FB950" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: First Time Pass Rate -->
                    <Border Grid.Column="6" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PASS RATE" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Kpi.FirstTimePassRate}" Style="{StaticResource TextKpiValue}" Foreground="#3FB950"/>
                                <TextBlock Text="%" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="14" Foreground="#3FB950" VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KPI 5: Alerts -->
                    <Border Grid.Column="8" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="FLEET ALERTS" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TotalAlerts}" Style="{StaticResource TextKpiValue}" Foreground="#F85149" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>


                <!-- Right: Mobile Web Dashboard Link -->
                <Border Grid.Column="2" Background="#161B22" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="WEB / MOBILE HUD" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextSubdued}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="🌐 OPEN HUD" Style="{StaticResource StylePrimaryActionBtn}" Click="BtnCopyWebUrl_Click" Padding="8,4" FontSize="10" ToolTip="Open Central Web HUD in browser &amp; copy link"/>
                            <Button Content="📋 COPY" Style="{StaticResource StyleDarkActionBtn}" Click="BtnCopyOnlyUrl_Click" Padding="8,4" FontSize="10" Margin="4,0,0,0" ToolTip="Copy HUD URL to clipboard"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. FILTER & QUICK ACTIONS TOOLBAR                              -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <!-- Search Input -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="28" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" Padding="6,3" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalContentAlignment="Center"/>

                    <!-- Filter Pills -->
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                        <Button Content="ALL" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFilter_Click" Tag="ALL" Margin="0,0,4,0" Padding="10,4"/>
                        <Button Content="TESTING" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFilter_Click" Tag="TESTING" Margin="0,0,4,0" Padding="10,4"/>
                        <Button Content="PASSED" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFilter_Click" Tag="PASSED" Margin="0,0,4,0" Padding="10,4"/>
                        <Button Content="ALERTS" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFilter_Click" Tag="ALERTS" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="📊 EXPORT FLEET CSV" Style="{StaticResource StylePrimaryActionBtn}" Click="BtnExportCsv_Click" Margin="0,0,8,0" Padding="12,5" ToolTip="Export full warehouse intake log to CSV on Desktop"/>
                    <Button Content="📱 MOBILE QR CODE" Style="{StaticResource StyleDarkActionBtn}" Click="BtnShowQr_Click" Margin="0,0,8,0" Padding="10,5"/>
                    <Button Content="🔄 RE-SCAN SUBNET" Style="{StaticResource StyleDarkActionBtn}" Click="BtnRefresh_Click" Padding="10,5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- 3. MASTER FLEET & WAREHOUSE JOURNEY TABS                       -->
        <!-- ============================================================== -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#161B22"/>
                    <Setter Property="Foreground" Value="#8B949E"/>
                    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#1F242C"/>
                                        <Setter Property="Foreground" Value="#58A6FF"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#58A6FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Active Fleet Telemetry -->
            <TabItem Header="🖥️ FLEET BENCHES">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding FilteredDevices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="380" Background="{StaticResource BrushCardBg}" BorderBrush="{Binding AccentHex}" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,14,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Name & Status -->
                                        <DockPanel Grid.Row="0" LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💻 " FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MachineName}" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushTextWhite}"/>
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right" Background="#0D1117" BorderBrush="{Binding AccentHex}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding StatusBadge}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="{Binding AccentHex}"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- Row 1: Model & Serial -->
                                        <TextBlock Grid.Row="1" Text="{Binding Model}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C9D1D9" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Serial}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushTextSubdued}" HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                        <!-- Row 2: Pipeline Progress Bar -->
                                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                            <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Status}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#58A6FF"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="{Binding AccentHex}"/>
                                            </DockPanel>
                                            <ProgressBar Height="6" Minimum="0" Maximum="{Binding TotalCount}" Value="{Binding PassedCount}" Foreground="{Binding AccentHex}" Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"/>
                                        </StackPanel>

                                        <!-- Row 3: Live Telemetry Chips 2x2 -->
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Thermals -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="#0D1117" CornerRadius="4" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="CPU: " FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                                                    <TextBlock Text="{Binding CpuTemp}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="9" Foreground="{StaticResource BrushTextWhite}"/>
                                                    <TextBlock Text="°C" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Battery -->
                                            <Border Grid.Row="0" Grid.Column="2" Background="#0D1117" CornerRadius="4" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="BAT: " FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                                                    <TextBlock Text="{Binding Battery}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="9" Foreground="{StaticResource BrushTextWhite}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Grade -->
                                            <Border Grid.Row="2" Grid.Column="0" Background="#0D1117" CornerRadius="4" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Grade}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="9" Foreground="#3FB950"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- IP & Heartbeat -->
                                            <Border Grid.Row="2" Grid.Column="2" Background="#0D1117" CornerRadius="4" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding LastSeenSummary}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 4: Quick Action Buttons -->
                                        <Grid Grid.Row="4" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="📍 PING" Style="{StaticResource StyleWarningActionBtn}" Click="BtnBenchPing_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Trigger acoustic chime on laptop"/>
                                            <Button Grid.Column="2" Content="🖥️ REMOTE" Style="{StaticResource StyleDarkActionBtn}" Click="BtnBenchRemote_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Open live interactive Remote Desktop mirror"/>
                                            <Button Grid.Column="4" Content="🌐 HUD" Style="{StaticResource StyleDarkActionBtn}" Click="BtnBenchHud_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Open Bench Web Telemetry HUD in browser"/>
                                            <Button Grid.Column="6" Content="🔍 INSPECT" Style="{StaticResource StyleDarkActionBtn}" Click="BtnBenchInspect_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Open full hardware inspection modal"/>
                                            <Button Grid.Column="8" Content="📄 CERT" Style="{StaticResource StylePrimaryActionBtn}" Click="BtnBenchCert_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Download official PDF certificate to archive"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Warehouse WIP Board (10 Lanes - 3 Zones) -->
            <TabItem Header="📋 WAREHOUSE WIP BOARD (10 QUEUES — 3 ZONES)">
                <Grid DataContext="{Binding WipBoard}" Margin="0,8,0,0">
                    <Grid.Resources>
                        <!-- ListBox Item Container Style (removes default selection rectangle) -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Common High-Visibility Drag-and-Drop WipCard DataTemplate -->
                        <DataTemplate x:Key="WipCardTemplate">
                            <Border x:Name="CardBorder" Background="#1F242D" BorderBrush="#384252" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                                    Cursor="Hand"
                                    PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Card_PreviewMouseMove"
                                    ToolTip="💡 Drag to move between queues, or right-click to quick-move">
                                <Border.ContextMenu>
                                    <ContextMenu Background="#161B22" BorderBrush="#388BFD" BorderThickness="1">
                                        <MenuItem Header="📥 Move to INTAKE STAGING" Click="MenuItemMoveQueue_Click" Tag="IntakeStaging" Foreground="#58A6FF" FontWeight="Bold"/>
                                        <MenuItem Header="⚡ Move to ACTIVE TESTING" Click="MenuItemMoveQueue_Click" Tag="ActiveTesting" Foreground="#79B8FF" FontWeight="Bold"/>
                                        <MenuItem Header="🔁 Move to READY FOR RETEST" Click="MenuItemMoveQueue_Click" Tag="ReadyForRetest" Foreground="#56D364" FontWeight="Bold"/>
                                        <Separator Background="#30363D"/>
                                        <MenuItem Header="⏸️ Move to AWAITING PARTS" Click="MenuItemMoveQueue_Click" Tag="AwaitingParts" Foreground="#F2CC60" FontWeight="Bold"/>
                                        <MenuItem Header="🔧 Move to IN-HOUSE REPAIR" Click="MenuItemMoveQueue_Click" Tag="InHouseRepair" Foreground="#FF7B72" FontWeight="Bold"/>
                                        <MenuItem Header="🔬 Move to ADVANCED IC EXTERNAL" Click="MenuItemMoveQueue_Click" Tag="AdvancedIcExternal" Foreground="#D2A8FF" FontWeight="Bold"/>
                                        <Separator Background="#30363D"/>
                                        <MenuItem Header="🛒 Release to READY FOR SALE (RTS)" Click="MenuItemMoveQueue_Click" Tag="ReadyForSale" Foreground="#3FB950" FontWeight="Bold"/>
                                        <MenuItem Header="🏢 Release to READY FOR RENTAL (RFR)" Click="MenuItemMoveQueue_Click" Tag="ReadyForRental" Foreground="#388BFD" FontWeight="Bold"/>
                                        <MenuItem Header="🏷️ Move to DEMO STOCK" Click="MenuItemMoveQueue_Click" Tag="DemoStock" Foreground="#E3B341" FontWeight="Bold"/>
                                        <Separator Background="#30363D"/>
                                        <MenuItem Header="🗑️ Move to SCRAP / HARVEST" Click="MenuItemMoveQueue_Click" Tag="ScrapHarvest" Foreground="#8B949E"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <!-- Header Row: Drag Handle + Asset Tag + Grade Badge -->
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="⠿" Foreground="#6E7681" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AssetTag}" Foreground="#FFFFFF" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Background="#12161E" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LatestRunGrade, TargetNullValue='INSPECT'}" Foreground="#58A6FF" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="9"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Model Row -->
                                    <TextBlock Text="{Binding Model}" Foreground="#E6EDF3" FontFamily="{StaticResource FontSans}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>

                                    <!-- Serial Number & Missing Serial Badge Row -->
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding SerialNumber}" Foreground="#8B949E" FontFamily="{StaticResource FontMono}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                        <Border DockPanel.Dock="Right" Background="#2E1A1A" BorderBrush="#F85149" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSerialMissing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="[NO SERIAL]" Foreground="#F85149" FontFamily="{StaticResource FontMono}" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Technician & Metadata Pills Row -->
                                    <WrapPanel Margin="0,0,0,4">
                                        <!-- Assigned Tech Pill -->
                                        <Border Background="#162B3D" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AssignedTo}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AssignedTo}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤 " FontSize="8" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AssignedTo}" Foreground="#58A6FF" FontFamily="{StaticResource FontMono}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Missing Components Warning Tag -->
                                        <Border Background="#2E230B" BorderBrush="#D29922" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MissingComponents}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MissingComponents}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠️ " FontSize="8" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MissingComponents}" Foreground="#F2CC60" FontFamily="{StaticResource FontMono}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- External Vendor Tag -->
                                        <Border Background="#271836" BorderBrush="#A371F7" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExternalVendor}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ExternalVendor}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔬 " FontSize="8" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ExternalVendor}" Foreground="#D2A8FF" FontFamily="{StaticResource FontMono}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Footer: Location & WorkInProgress / Health -->
