<Window x:Class="SuperManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuperManager — Master Warehouse Fleet Server &amp; Diagnostics Cockpit"
        Height="840" Width="1360"
        MinHeight="600" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Top Avionics Header & KPIs -->
            <RowDefinition Height="Auto"/> <!-- 2. Filter & Actions Bar -->
            <RowDefinition Height="*"/>    <!-- 3. Master Fleet Grid -->
            <RowDefinition Height="Auto"/> <!-- 4. Bottom Avionics Status Bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP AVIONICS HEADER & WAREHOUSE FLOOR KPIS                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushTopBarGradient}"
                BorderBrush="{StaticResource BrushBorderDark}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title & Subnet Info -->
                    <ColumnDefinition Width="*"/>    <!-- 5 KPI Cards Row -->
                    <ColumnDefinition Width="Auto"/> <!-- Mobile Web Server Pill -->
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SUPERMANAGER" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="17" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                        <Border Background="#1F324D" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MASTER FLEET SERVER" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Autonomous Subnet Discovery · Real-Time Telemetry · Central Archiving" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushTextSubdued}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Center: 5 KPI Bento Cards -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Active Benches -->
                    <Border Grid.Column="0" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ONLINE BENCHES" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TotalActiveBenches}" Style="{StaticResource TextKpiValue}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Testing Now -->
                    <Border Grid.Column="2" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TESTING NOW" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TotalTesting}" Style="{StaticResource TextKpiValue}" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Completed Today -->
                    <Border Grid.Column="4" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="COMPLETED TODAY" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TotalCompletedToday}" Style="{StaticResource TextKpiValue}" Foreground="#3FB950" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: First Time Pass Rate -->
                    <Border Grid.Column="6" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PASS RATE" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Kpi.FirstTimePassRate}" Style="{StaticResource TextKpiValue}" Foreground="#3FB950"/>
                                <TextBlock Text="%" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="14" Foreground="#3FB950" VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KPI 5: Alerts -->
                    <Border Grid.Column="8" Background="#161B22" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="FLEET ALERTS" Style="{StaticResource TextKpiLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Kpi.TotalAlerts}" Style="{StaticResource TextKpiValue}" Foreground="#F85149" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>


                <!-- Right: Mobile Web Dashboard Link -->
                <Border Grid.Column="2" Background="#161B22" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="WEB / MOBILE HUD" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextSubdued}" HorizontalAlignment="Center"/>
                        <Button Content="{Binding ManagerWebUrl}" Style="{StaticResource StyleDarkActionBtn}" Click="BtnCopyWebUrl_Click" Padding="8,4" FontSize="10" Margin="0,3,0,0" ToolTip="Click to copy Mobile Dashboard URL"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. FILTER & QUICK ACTIONS TOOLBAR                              -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <!-- Search Input -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="28" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" Padding="6,3" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalContentAlignment="Center"/>

                    <!-- Filter Pills -->
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                        <Button Content="ALL" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFilter_Click" Tag="ALL" Margin="0,0,4,0" Padding="10,4"/>
                        <Button Content="TESTING" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFilter_Click" Tag="TESTING" Margin="0,0,4,0" Padding="10,4"/>
                        <Button Content="PASSED" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFilter_Click" Tag="PASSED" Margin="0,0,4,0" Padding="10,4"/>
                        <Button Content="ALERTS" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFilter_Click" Tag="ALERTS" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="📊 EXPORT FLEET CSV" Style="{StaticResource StylePrimaryActionBtn}" Click="BtnExportCsv_Click" Margin="0,0,8,0" Padding="12,5" ToolTip="Export full warehouse intake log to CSV on Desktop"/>
                    <Button Content="📱 MOBILE QR CODE" Style="{StaticResource StyleDarkActionBtn}" Click="BtnShowQr_Click" Margin="0,0,8,0" Padding="10,5"/>
                    <Button Content="🔄 RE-SCAN SUBNET" Style="{StaticResource StyleDarkActionBtn}" Click="BtnRefresh_Click" Padding="10,5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- 3. MASTER FLEET & WAREHOUSE JOURNEY TABS                       -->
        <!-- ============================================================== -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#161B22"/>
                    <Setter Property="Foreground" Value="#8B949E"/>
                    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#1F242C"/>
                                        <Setter Property="Foreground" Value="#58A6FF"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#58A6FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Active Fleet Telemetry -->
            <TabItem Header="🖥️ FLEET BENCHES">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding FilteredDevices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="380" Background="{StaticResource BrushCardBg}" BorderBrush="{Binding AccentHex}" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,14,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Name & Status -->
                                        <DockPanel Grid.Row="0" LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💻 " FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MachineName}" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushTextWhite}"/>
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right" Background="#0D1117" BorderBrush="{Binding AccentHex}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding StatusBadge}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="{Binding AccentHex}"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- Row 1: Model & Serial -->
                                        <TextBlock Grid.Row="1" Text="{Binding Model}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C9D1D9" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Serial}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushTextSubdued}" HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                        <!-- Row 2: Pipeline Progress Bar -->
                                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                            <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Status}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#58A6FF"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="{Binding AccentHex}"/>
                                            </DockPanel>
                                            <ProgressBar Height="6" Minimum="0" Maximum="{Binding TotalCount}" Value="{Binding PassedCount}" Foreground="{Binding AccentHex}" Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"/>
                                        </StackPanel>

                                        <!-- Row 3: Live Telemetry Chips 2x2 -->
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Thermals -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="#0D1117" CornerRadius="4" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="CPU: " FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                                                    <TextBlock Text="{Binding CpuTemp}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="9" Foreground="{StaticResource BrushTextWhite}"/>
                                                    <TextBlock Text="°C" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Battery -->
                                            <Border Grid.Row="0" Grid.Column="2" Background="#0D1117" CornerRadius="4" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="BAT: " FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                                                    <TextBlock Text="{Binding Battery}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="9" Foreground="{StaticResource BrushTextWhite}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Grade -->
                                            <Border Grid.Row="2" Grid.Column="0" Background="#0D1117" CornerRadius="4" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Grade}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="9" Foreground="#3FB950"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- IP & Heartbeat -->
                                            <Border Grid.Row="2" Grid.Column="2" Background="#0D1117" CornerRadius="4" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding LastSeenSummary}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushTextSubdued}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 4: Quick Action Buttons -->
                                        <Grid Grid.Row="4" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="📍 PING" Style="{StaticResource StyleWarningActionBtn}" Click="BtnBenchPing_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Trigger acoustic chime on laptop"/>
                                            <Button Grid.Column="2" Content="🖥️ REMOTE" Style="{StaticResource StyleDarkActionBtn}" Click="BtnBenchRemote_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Open live interactive Remote Desktop mirror"/>
                                            <Button Grid.Column="4" Content="🔍 INSPECT" Style="{StaticResource StyleDarkActionBtn}" Click="BtnBenchInspect_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Open full hardware inspection modal"/>
                                            <Button Grid.Column="6" Content="📄 CERT" Style="{StaticResource StylePrimaryActionBtn}" Click="BtnBenchCert_Click" Tag="{Binding}" Padding="2,4" FontSize="9" ToolTip="Download official PDF certificate to archive"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Warehouse WIP Board (7 Lanes) -->
            <TabItem Header="📋 WAREHOUSE WIP BOARD (7 QUEUES)">
                <Grid DataContext="{Binding WipBoard}" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- WIP Action Bar -->
                    <Border Grid.Row="0" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Total Active WIP: " Foreground="{StaticResource BrushTextSubdued}" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalAssets}" Foreground="#58A6FF" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                <TextBlock Text="{Binding ActionMessage}" Foreground="#3FB950" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="🔄 REFRESH WIP" Style="{StaticResource StyleDarkActionBtn}" Click="BtnRefreshWip_Click" Padding="10,4" FontSize="10"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 7 Kanban Lanes ScrollViewer -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: ReadyForTest -->
                            <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#21262D" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="READY FOR TEST" Foreground="#8B949E" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding ReadyForTestLane.Count}" DockPanel.Dock="Right" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding ReadyForTestLane}" Background="Transparent" BorderThickness="0" SelectedItem="{Binding SelectedAsset}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AssetTag}" Foreground="#58A6FF" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#C9D1D9" FontSize="10" FontFamily="{StaticResource FontMono}"/>
                                                        <TextBlock Text="{Binding Model}" Foreground="#8B949E" FontSize="10"/>
                                                        <TextBlock Text="{Binding CurrentLocation}" Foreground="#D29922" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Column 2: InTest -->
                            <Border Grid.Column="2" Background="#161B22" BorderBrush="#1F6FEB" BorderThickness="1" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#1F6FEB22" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="IN TEST" Foreground="#58A6FF" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding InTestLane.Count}" DockPanel.Dock="Right" Foreground="#58A6FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding InTestLane}" Background="Transparent" BorderThickness="0" SelectedItem="{Binding SelectedAsset}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D1117" BorderBrush="#1F6FEB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AssetTag}" Foreground="#58A6FF" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#C9D1D9" FontSize="10" FontFamily="{StaticResource FontMono}"/>
                                                        <TextBlock Text="{Binding Model}" Foreground="#8B949E" FontSize="10"/>
                                                        <TextBlock Text="{Binding CurrentLocation}" Foreground="#D29922" FontSize="9" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Column 4: Hold -->
                            <Border Grid.Column="4" Background="#161B22" BorderBrush="#D29922" BorderThickness="1" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#D2992222" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="HOLD" Foreground="#D29922" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding HoldLane.Count}" DockPanel.Dock="Right" Foreground="#D29922" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding HoldLane}" Background="Transparent" BorderThickness="0" SelectedItem="{Binding SelectedAsset}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D1117" BorderBrush="#D29922" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AssetTag}" Foreground="#D29922" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#C9D1D9" FontSize="10" FontFamily="{StaticResource FontMono}"/>
                                                        <TextBlock Text="{Binding CurrentLocation}" Foreground="#8B949E" FontSize="9"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Column 6: Repair -->
                            <Border Grid.Column="6" Background="#161B22" BorderBrush="#F85149" BorderThickness="1" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#F8514922" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="REPAIR" Foreground="#F85149" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding RepairLane.Count}" DockPanel.Dock="Right" Foreground="#F85149" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding RepairLane}" Background="Transparent" BorderThickness="0" SelectedItem="{Binding SelectedAsset}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D1117" BorderBrush="#F85149" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AssetTag}" Foreground="#F85149" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#C9D1D9" FontSize="10" FontFamily="{StaticResource FontMono}"/>
                                                        <TextBlock Text="{Binding Model}" Foreground="#8B949E" FontSize="10"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Column 8: Retest -->
                            <Border Grid.Column="8" Background="#161B22" BorderBrush="#A371F7" BorderThickness="1" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#A371F722" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="RETEST" Foreground="#A371F7" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding RetestLane.Count}" DockPanel.Dock="Right" Foreground="#A371F7" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding RetestLane}" Background="Transparent" BorderThickness="0" SelectedItem="{Binding SelectedAsset}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D1117" BorderBrush="#A371F7" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AssetTag}" Foreground="#A371F7" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#C9D1D9" FontSize="10" FontFamily="{StaticResource FontMono}"/>
                                                        <TextBlock Text="{Binding CurrentLocation}" Foreground="#8B949E" FontSize="9"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Column 10: ReadyForRelease -->
                            <Border Grid.Column="10" Background="#161B22" BorderBrush="#238636" BorderThickness="1" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#23863622" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="READY RELEASE" Foreground="#3FB950" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding ReadyForReleaseLane.Count}" DockPanel.Dock="Right" Foreground="#3FB950" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding ReadyForReleaseLane}" Background="Transparent" BorderThickness="0" SelectedItem="{Binding SelectedAsset}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D1117" BorderBrush="#238636" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AssetTag}" Foreground="#3FB950" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#C9D1D9" FontSize="10" FontFamily="{StaticResource FontMono}"/>
                                                        <TextBlock Text="{Binding LatestRunGrade}" Foreground="#58A6FF" FontWeight="Bold" FontSize="10"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Column 12: Disposed -->
                            <Border Grid.Column="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#30363D22" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="DISPOSED" Foreground="#8B949E" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding DisposedLane.Count}" DockPanel.Dock="Right" Foreground="#8B949E" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding DisposedLane}" Background="Transparent" BorderThickness="0" SelectedItem="{Binding SelectedAsset}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AssetTag}" Foreground="#8B949E" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#8B949E" FontSize="10" FontFamily="{StaticResource FontMono}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Tab 3: Scan-First Intake -->
            <TabItem Header="📦 SCAN-FIRST INTAKE &amp; TRIAGE">
                <Grid DataContext="{Binding WipBoard}" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Intake Form -->
                    <Border Grid.Column="0" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="NEW DEVICE INTAKE" Foreground="{StaticResource BrushTextWhite}" FontWeight="ExtraBold" FontSize="14" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="Asset Tag / Barcode:" Foreground="{StaticResource BrushTextSubdued}" FontSize="11" Margin="0,4,0,2"/>
                            <TextBox Text="{Binding IntakeTag, UpdateSourceTrigger=PropertyChanged}" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" Padding="6,4" FontFamily="{StaticResource FontMono}"/>

                            <TextBlock Text="Serial Number (Win32_BIOS):" Foreground="{StaticResource BrushTextSubdued}" FontSize="11" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding IntakeSerial, UpdateSourceTrigger=PropertyChanged}" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" Padding="6,4" FontFamily="{StaticResource FontMono}"/>

                            <TextBlock Text="Model:" Foreground="{StaticResource BrushTextSubdued}" FontSize="11" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding IntakeModel, UpdateSourceTrigger=PropertyChanged}" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" Padding="6,4"/>

                            <TextBlock Text="Intake Batch ID:" Foreground="{StaticResource BrushTextSubdued}" FontSize="11" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding IntakeBatch, UpdateSourceTrigger=PropertyChanged}" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" Padding="6,4" FontFamily="{StaticResource FontMono}"/>

                            <TextBlock Text="Initial Staging Location:" Foreground="{StaticResource BrushTextSubdued}" FontSize="11" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding IntakeLocation, UpdateSourceTrigger=PropertyChanged}" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" Padding="6,4" FontFamily="{StaticResource FontMono}"/>

                            <Button Content="📥 CONFIRM INTAKE &amp; ASSIGN QUEUE" Style="{StaticResource StylePrimaryActionBtn}" Click="BtnConfirmIntake_Click" Margin="0,16,0,0" Padding="12,8" FontWeight="Bold"/>

                            <TextBlock Text="{Binding ActionMessage}" Foreground="#3FB950" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Selected Asset Timeline & Journey -->
                    <Border Grid.Column="2" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="DEVICE JOURNEY &amp; CUSTODY TIMELINE" Foreground="{StaticResource BrushTextWhite}" FontWeight="ExtraBold" FontSize="14" Margin="0,0,0,12"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedJourney.CustodyEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding EventType}" Foreground="#58A6FF" FontWeight="Bold" Width="120"/>
                                                        <TextBlock Text="{Binding Location}" Foreground="#D29922" Width="140"/>
                                                        <TextBlock Text="{Binding Actor}" Foreground="#8B949E" Width="100"/>
                                                        <TextBlock Text="{Binding ReasonCode}" Foreground="#F85149" Width="140"/>
                                                        <TextBlock Text="{Binding RecordedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#8B949E" HorizontalAlignment="Right"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 4: Depot Analytics & Aging WIP -->
            <TabItem Header="📈 DEPOT ANALYTICS &amp; AGING WIP">
                <Grid DataContext="{Binding WipBoard}" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top KPI Cards -->
                        <RowDefinition Height="*"/>    <!-- Aging WIP Table & Root Cause Pareto -->
                    </Grid.RowDefinitions>

                    <!-- Top KPI Summary Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- First-Time Pass Rate (FTPR) -->
                        <Border Grid.Column="0" Background="#161B22" BorderBrush="#3FB950" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="FIRST-TIME PASS RATE (FTPR)" Foreground="#8B949E" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding FirstTimePassRate}" Foreground="#3FB950" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="20"/>
                                    <TextBlock Text="%" Foreground="#3FB950" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                </StackPanel>
                                <TextBlock Text="Strict Initial Run (No Retests)" Foreground="#6E7681" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Daily Throughput -->
                        <Border Grid.Column="2" Background="#161B22" BorderBrush="#58A6FF" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="24H QC THROUGHPUT" Foreground="#8B949E" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding DailyThroughput}" Foreground="#58A6FF" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="20" Margin="0,4,0,0"/>
                                <TextBlock Text="Passed Bench Units Today" Foreground="#6E7681" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Depot WIP -->
                        <Border Grid.Column="4" Background="#161B22" BorderBrush="#D29922" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="TOTAL DEPOT WIP" Foreground="#8B949E" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding TotalAssets}" Foreground="#D29922" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="20" Margin="0,4,0,0"/>
                                <TextBlock Text="Units Across Active Queues" Foreground="#6E7681" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Active Exceptions -->
                        <Border Grid.Column="6" Background="#161B22" BorderBrush="#F85149" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="ACTIVE EXCEPTIONS" Foreground="#8B949E" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding ActiveExceptionsCount}" Foreground="#F85149" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="20" Margin="0,4,0,0"/>
                                <TextBlock Text="Holds + Overrides Pending" Foreground="#6E7681" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Max WIP Age -->
                        <Border Grid.Column="8" Background="#161B22" BorderBrush="#A371F7" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="OLDEST WIP DWELL" Foreground="#8B949E" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding OldestWipAgeDisplay}" Foreground="#A371F7" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="20" Margin="0,4,0,0"/>
                                <TextBlock Text="Maximum Lane Stagnation" Foreground="#6E7681" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Main Panel: 10 Oldest Units & Blocker Defect Diagnostics -->
                    <Border Grid.Row="1" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="⏱️ TOP 10 OLDEST WIP UNITS &amp; BOTTLENECK BLOCKERS" Foreground="{StaticResource BrushTextWhite}" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text=" (Prioritize to prevent SLA breach)" Foreground="{StaticResource BrushTextSubdued}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Button Content="🔄 REFRESH ANALYTICS" Style="{StaticResource StyleDarkActionBtn}" Click="BtnRefreshWip_Click" DockPanel.Dock="Right" Padding="10,4" FontSize="10"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding TenOldestWipUnits}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="#0D1117" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                      RowBackground="#161B22" AlternatingRowBackground="#0D1117" Foreground="#C9D1D9"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Asset Tag" Binding="{Binding AssetTag}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#58A6FF"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="130" FontFamily="{StaticResource FontMono}"/>
                                    <DataGridTextColumn Header="Model / Hardware" Binding="{Binding Model}" Width="160"/>
                                    <DataGridTextColumn Header="Queue" Binding="{Binding LifecycleQueue}" Width="100"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding CurrentLocation}" Width="110"/>
                                    <DataGridTextColumn Header="Dwell Time" Binding="{Binding DwellDisplay}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#F85149"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Identified Defect / Blocker" Binding="{Binding PrimaryBlocker}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E3B341"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Technician" Binding="{Binding Technician}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================================================== -->
        <!-- 4. BOTTOM AVIONICS STATUS BAR                                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="● " Foreground="#3FB950" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="UDP 9876 MESH · WEB SERVER PORT 9000 ACTIVE" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushTextSubdued}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
