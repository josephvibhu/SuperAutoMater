<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>SuperManager</AssemblyName>
		<Product>SuperManager — Warehouse Fleet Server &amp; Cockpit</Product>
		<Company>SuperAutoMater Fleet Systems</Company>
		<Version>1.6.9</Version>
		<AssemblyVersion>1.6.9.0</AssemblyVersion>
		<FileVersion>1.6.9.0</FileVersion>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<NoWarn>NU1701;WFO1000;NU1903</NoWarn>

		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishReadyToRunComposite>true</PublishReadyToRunComposite>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
		<TieredCompilation>true</TieredCompilation>
		<Optimize>true</Optimize>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="app.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="QRCoder" Version="1.8.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SuperAutoMater\SuperAutoMater.csproj" />
	</ItemGroup>

</Project>
