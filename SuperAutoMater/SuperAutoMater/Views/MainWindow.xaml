                                            <TextBlock Text="{Binding Grade}" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextEmerald}" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Interactive Cosmetic Defect Matrix Checklist -->
                                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="🎨 " FontSize="10"/>
                                                    <TextBlock Text="DEFECT MATRIX" Style="{StaticResource TextBadgeMono}" Foreground="#58A6FF" FontWeight="Bold"/>
                                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding DefectCountBadge}" Style="{StaticResource TextBadgeMono}" Foreground="{Binding DefectBadgeColor}" FontWeight="Bold" FontSize="9"/>
                                                    </Border>
                                                </StackPanel>
