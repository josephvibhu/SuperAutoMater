                                                     <ColumnDefinition Width="*"/>
                                                 </Grid.ColumnDefinitions>

                                                 <!-- Left: QR Mobile Radar Scanner -->
                                                 <Border Grid.Column="0" Background="#0E1116" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                                     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                         <TextBlock Text="MOBILE RADAR HUD" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
