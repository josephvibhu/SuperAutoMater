                                                <CheckBox Grid.Row="1" Grid.Column="0" Content="Lid Scuffs" IsChecked="{Binding DefectLidScuffs}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#8B949E" Margin="0,2,2,2"/>
                                                <CheckBox Grid.Row="1" Grid.Column="1" Content="Corner Dent" IsChecked="{Binding DefectCornerDent}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#8B949E" Margin="2,2,0,2"/>

                                                <CheckBox Grid.Row="2" Grid.Column="0" Content="Shiny Keys" IsChecked="{Binding DefectShinyKeys}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#8B949E" Margin="0,2,2,2"/>
