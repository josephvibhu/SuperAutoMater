<Window x:Class="SuperAutoMater.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SuperAutoMater.Wpf.Controls"
        xmlns:vm="clr-namespace:SuperAutoMater.Wpf.ViewModels"
        Title="SuperAutoMater v1.6 — Hardware Diagnostic &amp; QC Cockpit"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushObsidianRadial}"
        Icon="pack://application:,,,/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Avionics Status Bar -->
            <RowDefinition Height="*"/>    <!-- Main Cockpit Workspace -->
            <RowDefinition Height="Auto"/> <!-- Bottom Avionics Command Bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- AVIONICS LIVE FEEDBACK TOAST NOTIFICATION BANNER               -->
        <!-- ============================================================== -->
        <Border x:Name="ToastBanner"
                Grid.Row="0"
                Background="#1C2128"
                BorderBrush="#388BFD"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="16,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                Panel.ZIndex="1000"
                Visibility="Collapsed"
                Effect="{StaticResource EffectCardShadow}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtToastIcon" Text="✓" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="14" Foreground="#3FB950" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtToastMessage" Text="Action Feedback" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- 1. TOP AVIONICS STATUS BAR (Neutral Dark Slate & Clean Logo)    -->
        <!-- ============================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushTopBarGradient}"
                BorderBrush="{StaticResource BrushHairlineViolet}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,10"
                Margin="0,0,0,10"
                Effect="{StaticResource EffectBarShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand & Bay Info -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Telemetry Chips & Express QC -->
                </Grid.ColumnDefinitions>

                <!-- Left Zone: Brand & Operational State (Purple isolated to Logo ONLY) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pulsing Live Dot (Purple ONLY) -->
                    <Grid Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource BrushLogoPurple}" Opacity="0.4"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrushLogoPurpleLight}" Effect="{StaticResource EffectGlowPurpleSm}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SUPER" Style="{StaticResource TextHeaderBrand}" Foreground="{StaticResource BrushTextWhite}"/>
                        <TextBlock Text="AUTOMATER" Style="{StaticResource TextHeaderBrand}" Foreground="{StaticResource BrushLogoPurpleLight}"/>
                    </StackPanel>

                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.6.0" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                    </Border>

                    <Rectangle Width="1" Height="16" Fill="#30363D" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Bay: QC-TERMINAL-01 | Operator: Senior Refurb Tech">
                        <TextBlock Text="● BENCH ONLINE" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextEmerald}" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="|" Style="{StaticResource TextBadgeMono}" Foreground="#30363D" Margin="0,0,8,0"/>
                        <TextBlock Text="QC-01" Style="{StaticResource TextBadgeMono}" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}"/>
                    </StackPanel>

                    <!-- Technician Operator Badge Pill [Alt+T] -->
                    <Border x:Name="BtnTechnicianPill" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,3" Cursor="Hand" MouseLeftButtonUp="BtnTechnicianPill_Click" ToolTip="Click to change Technician or scan QR/Barcode badge [Alt+T]" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TechnicianDisplayBadge}" Style="{StaticResource TextBadgeMono}" FontWeight="Bold" Foreground="#58A6FF"/>
                            <TextBlock Text=" 📷" FontSize="9" Foreground="#8B949E" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Advance Pipeline Mode Toggle Pill -->
                    <Border x:Name="BtnToggleAutoAdvance" Background="#161B22" BorderBrush="{Binding AutoAdvanceBadgeColor}" BorderThickness="1" CornerRadius="6" Padding="8,3" Cursor="Hand" MouseLeftButtonUp="BtnToggleAutoAdvance_Click" ToolTip="Click to toggle Pass Auto-Advance sequence on/off" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏩ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AutoAdvanceStatusText}" Style="{StaticResource TextBadgeMono}" FontWeight="Bold" Foreground="{Binding AutoAdvanceBadgeColor}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Zone: Telemetry Chips & Action Button -->
                <DockPanel Grid.Column="2" LastChildFill="False" VerticalAlignment="Center">
                    <!-- 1-Click Express QC Button (Anchored to the absolute right, guaranteed never to wrap) -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource StylePrimaryExpressQcButton}" Click="BtnExpressQc_Click" Margin="8,0,0,0" MinWidth="175" ToolTip="Run Autonomous 8-Subsystem Express Hardware Certification [F5]">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ 1-CLICK EXPRESS QC " TextWrapping="NoWrap" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextWhite}"/>
                            <Border Background="#40000000" CornerRadius="4" Padding="4,1">
                                <TextBlock Text="[F5]" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletLight}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Warehouse Fleet LAN HUD Button -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource StyleDarkActionBtn}" Click="BtnFleetHud_Click" Margin="8,0,0,0" Padding="10,6" ToolTip="Open Warehouse Fleet Mesh &amp; Mobile Remote Cockpit [F11]">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📡 FLEET HUD " TextWrapping="NoWrap" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="11" Foreground="#58A6FF"/>
                            <Border Background="#21262D" CornerRadius="4" Padding="4,1">
                                <TextBlock Text="[F11]" Style="{StaticResource TextBadgeMono}" Foreground="#BC8CFF"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Missing Drivers Chip -->
                    <Border DockPanel.Dock="Right" Style="{StaticResource StyleTelemetryChip}" Margin="6,0,0,0" ToolTip="{Binding MissingDriversSummary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DRIVERS " Style="{StaticResource TextAvionicsChip}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                            <TextBlock Text="{Binding MissingDriversBadge}" Style="{StaticResource TextAvionicsChip}" FontWeight="Bold" Foreground="{Binding MissingDriversAccentHex}"/>
                        </StackPanel>
                    </Border>

                    <!-- Wi-Fi Chip -->
                    <Border DockPanel.Dock="Right" Style="{StaticResource StyleTelemetryChip}" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WI-FI " Style="{StaticResource TextAvionicsChip}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                            <TextBlock Text="{Binding WifiSummary}" Style="{StaticResource TextAvionicsChip}" FontWeight="Bold" Foreground="{StaticResource BrushTextVioletLight}"/>
                        </StackPanel>
                    </Border>

                    <!-- CPU Freq Chip -->
                    <Border DockPanel.Dock="Right" Style="{StaticResource StyleTelemetryChip}" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU FREQ " Style="{StaticResource TextAvionicsChip}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                            <TextBlock Text="{Binding ClockSummary}" Style="{StaticResource TextAvionicsChip}" FontWeight="Bold" Foreground="{StaticResource BrushTextVioletLight}"/>
                            <TextBlock Text=" TURBO" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextEmerald}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Battery Chip -->
                    <Border DockPanel.Dock="Right" Style="{StaticResource StyleTelemetryChip}" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BATTERY " Style="{StaticResource TextAvionicsChip}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                            <TextBlock Text="{Binding BatteryCharge, StringFormat='{}{0}%'}" Style="{StaticResource TextAvionicsChip}" FontWeight="Bold" Foreground="{StaticResource BrushTextEmerald}"/>
                            <TextBlock Text="{Binding BatteryFlowWatts, StringFormat=' ({0})'}" Style="{StaticResource TextAvionicsChip}" Foreground="{StaticResource BrushTextVioletSubdued}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. MAIN COCKPIT WORKSPACE (Grid 12-Cols)                         -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="250" MaxWidth="300"/> <!-- Left Rail (Col 1-3) -->
                <ColumnDefinition Width="*"/>                                  <!-- Bento Arena (Col 4-12) -->
            </Grid.ColumnDefinitions>

            <!-- LEFT RAIL: DIAGNOSTIC MATRIX -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrushCardVioletGlass}"
                    BorderBrush="{StaticResource BrushHairlineViolet}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,10,0"
                    Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Pipeline Header -->
                        <RowDefinition Height="*"/>    <!-- Test Runners List -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrushAccentBlue}" Margin="0,0,6,0"/>
                            <TextBlock Text="TEST SUITE PIPELINE" Style="{StaticResource TextCardHeader}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="6" Background="#1B4D3E" BorderBrush="#34D399" BorderThickness="1" Padding="6,2">
                            <TextBlock Text="{Binding PipelineStatusText}" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextEmerald}" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>

                    <!-- Test Runner Buttons List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TestPipeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7" CornerRadius="10" Padding="10,8" Cursor="Hand" MouseLeftButtonUp="TestRow_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#161B22"/>
                                                <Setter Property="BorderBrush" Value="#262C36"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <!-- Passed State -->
                                                    <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                        <Setter Property="Background" Value="#12261C"/>
                                                        <Setter Property="BorderBrush" Value="#2EA043"/>
                                                    </DataTrigger>
                                                    <!-- Active State -->
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#21262D"/>
                                                        <Setter Property="BorderBrush" Value="#388BFD"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#58A6FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <DockPanel LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBadgeMono}">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextVioletMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextEmerald}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCardHeader}">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextVioletLight}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextEmerald}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock DockPanel.Dock="Right" Text="{Binding HotkeyText}" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletSubdued}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Rail Action Controls -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Style="{StaticResource StyleDarkActionBtn}" Click="BtnPrintLabel_Click" Margin="0,0,0,6">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="🖨 PRINT CHASSIS LABEL" Style="{StaticResource TextCardHeader}" Foreground="{StaticResource BrushTextVioletLight}"/>
                                <TextBlock DockPanel.Dock="Right" Text="[Ctrl+P]" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletSubdued}" Margin="10,0,0,0"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource StyleDarkActionBtn}" Click="BtnRetailPrep_Click" Margin="0,0,0,6" ToolTip="1-Click Enterprise Retail Prep &amp; Sanitizer [F12]">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="🧹 1-CLICK RETAIL PREP" Style="{StaticResource TextCardHeader}" Foreground="#58A6FF"/>
                                <TextBlock DockPanel.Dock="Right" Text="[F12]" Style="{StaticResource TextBadgeMono}" Foreground="#79C0FF" Margin="10,0,0,0"/>
                            </DockPanel>
                        </Button>

                        <Button Style="{StaticResource StyleCloudPassButton}" Click="BtnOpenSyncMenu_Click">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="🔏 PASS QC &amp; SYNC CLOUD" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="11" Foreground="#FFFFFF"/>
                                <Border DockPanel.Dock="Right" Background="#40000000" CornerRadius="4" Padding="4,1" Margin="10,0,0,0">
                                    <TextBlock Text="[Enter]" Style="{StaticResource TextBadgeMono}" Foreground="#FFFFFF" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN BENTO TELEMETRY ARENA (Col 4-12) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top 4 Bento Metric Tiles -->
                    <RowDefinition Height="*"/>    <!-- Main Interactive Arena (KB Matrix + USB/Cloud) -->
                </Grid.RowDefinitions>

                <!-- Top 4 Bento Metric Tiles -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:BentoCard Grid.Column="0" Title="CHASSIS IDENTITY" SubtitleBadge="{Binding Manufacturer}" Margin="0,0,6,0">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding Model}" Style="{StaticResource TextCardValueLarge}" TextTrimming="CharacterEllipsis"/>
                            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="SN: " Style="{StaticResource TextCardSubtle}"/>
                                    <TextBlock Text="{Binding Serial}" FontWeight="Bold" Style="{StaticResource TextCardSubtle}" Foreground="{StaticResource BrushTextWhite}"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#1E10B981" BorderBrush="#34D399" BorderThickness="1" CornerRadius="8" Padding="6,1">
                                    <TextBlock Text="{Binding Grade}" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextEmerald}" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                        </StackPanel>
                    </controls:BentoCard>

                    <!-- CARD 2: CPU & THERMALS -->
                    <controls:BentoCard Grid.Column="1" Title="CPU &amp; THERMALS" SubtitleBadge="{Binding TempBadge}" Margin="4,0,4,0">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource TextCardValueLarge}" TextTrimming="CharacterEllipsis"/>
                            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding CoreSummary}" Style="{StaticResource TextCardSubtle}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ThrottlingStatus}" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletLight}"/>
                            </DockPanel>
                        </StackPanel>
                    </controls:BentoCard>

                    <!-- CARD 3: STORAGE & RAM -->
                    <controls:BentoCard Grid.Column="2" Title="STORAGE &amp; RAM" SubtitleBadge="{Binding HealthBadge}" Margin="4,0,4,0">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding SpecHeader}" Style="{StaticResource TextCardValueLarge}" TextTrimming="CharacterEllipsis"/>
                            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding PrimaryDriveModel}" Style="{StaticResource TextCardSubtle}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                <TextBlock DockPanel.Dock="Right" Text="100% HEALTH" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextEmerald}" FontWeight="Bold"/>
                            </DockPanel>
                        </StackPanel>
                    </controls:BentoCard>

                    <!-- CARD 4: BATTERY TELEMETRY -->
                    <controls:BentoCard Grid.Column="3" Title="BATTERY POWER" SubtitleBadge="{Binding BatteryIntegrityBadge}" Margin="6,0,0,0">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding BatteryFlowWatts}" Style="{StaticResource TextCardValueLarge}"/>
                            <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding BatteryWearSummary}" Style="{StaticResource TextCardSubtle}" Foreground="{StaticResource BrushTextAmber}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BatteryTimeRemaining}" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletLight}"/>
                            </DockPanel>
                        </StackPanel>
                    </controls:BentoCard>
                </Grid>

                <!-- Main Interactive Arena (Row 1) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8.2*"/> <!-- Dynamic Diagnostic Workbench -->
                        <ColumnDefinition Width="3.8*"/> <!-- Avionics QC Audit & Inventory Console -->
                    </Grid.ColumnDefinitions>

                    <!-- INTEGRATED MULTI-TEST WORKBENCH (Col 1-8) -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushCardVioletGlass}"
                            BorderBrush="{StaticResource BrushHairlineViolet}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14"
                            Margin="0,0,6,0"
                            Effect="{StaticResource EffectCardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Workspace Header -->
                                <RowDefinition Height="*"/>    <!-- Workspace Dynamic Viewport -->
                            </Grid.RowDefinitions>

                            <!-- Top Workspace Navigation Bar -->
                            <Border Grid.Row="0" Background="#161B22" BorderBrush="#262C36" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                                <DockPanel LastChildFill="False">
                                    <!-- Left: Workspace Mode Indicator -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Ellipse x:Name="WkStatusDot" Width="7" Height="7" Fill="{StaticResource BrushAccentEmerald}" Margin="0,0,8,0"/>
                                        <TextBlock Text="HARDWARE WORKSPACE:" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletSubdued}" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtWorkspaceActiveTitle" Text="BENCH READY · STANDBY" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold"/>
                                        <Border x:Name="PillAutopilot" Background="#1B4D3E" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="TxtAutopilotStatus" Text="⚡ AUTOPILOT QC: STAGE 1/5 [ESC TO STOP]" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="#3FB950"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: Quick Reset / Status Badge -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button x:Name="BtnStandbyReset" Content="◈ STANDBY HUB" Style="{StaticResource StyleWorkspaceTabInactive}" Click="BtnStandbyReset_Click" Margin="0,0,6,0" ToolTip="Return to Ready Standby Hub"/>
                                        <Border CornerRadius="4" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Padding="6,2">
                                            <TextBlock x:Name="TxtActiveViewBadge" Text="INTEGRATED BENCH" Style="{StaticResource TextBadgeMono}" Foreground="#58A6FF" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Dynamic View Area -->
                            <Grid Grid.Row="1">
                                <!-- VIEW 0: STANDBY / READY BENCH HUB (DEFAULT STARTUP) -->
                                <Grid x:Name="ViewStandbyWorkspace" Visibility="Visible">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="60" Height="60" CornerRadius="30" Background="#1B2230" BorderBrush="#388BFD" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <TextBlock Text="⚡" FontSize="26" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="DIAGNOSTIC WORKBENCH ONLINE" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushTextWhite}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click any test on the left sideline or press [F1]-[F7] to run its hardware inspection here." Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletSubdued}" HorizontalAlignment="Center" Margin="0,6,0,16"/>

                                        <!-- Autopilot Hero Launcher -->
                                        <Button Content="⚡ 1-CLICK AUTOPILOT QC [F10]" Style="{StaticResource StyleCloudPassButton}" Click="BtnStartAutopilot_Click" Margin="0,0,0,18" Padding="20,9" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>

                                        <!-- Quick Launch Grid -->
                                        <WrapPanel HorizontalAlignment="Center" MaxWidth="620">
                                            <Button Content="⌨ KEYBOARD &amp; TRACKPAD" Style="{StaticResource StyleDarkActionBtn}" Click="QuickLaunch_Keyboard" Margin="4" Padding="12,7"/>
                                            <Button Content="📷 WEBCAM &amp; MIC ARRAY" Style="{StaticResource StyleDarkActionBtn}" Click="QuickLaunch_CamMic" Margin="4" Padding="12,7"/>
                                            <Button Content="⚡ CPU &amp; RAM STRESS" Style="{StaticResource StyleDarkActionBtn}" Click="QuickLaunch_Cpu" Margin="4" Padding="12,7"/>
                                            <Button Content="🔋 BATTERY HEALTH &amp; POWER" Style="{StaticResource StyleDarkActionBtn}" Click="QuickLaunch_Battery" Margin="4" Padding="12,7"/>
                                            <Button Content="🎮 GPU 3D BENCHMARK" Style="{StaticResource StyleDarkActionBtn}" Click="QuickLaunch_Gpu" Margin="4" Padding="12,7"/>
                                            <Button Content="👆 FINGERPRINT SENSOR" Style="{StaticResource StyleDarkActionBtn}" Click="QuickLaunch_Fingerprint" Margin="4" Padding="12,7"/>
                                            <Button Content="💾 3-SOURCE SSD HEALTH" Style="{StaticResource StyleDarkActionBtn}" Click="QuickLaunch_Storage" Margin="4" Padding="12,7"/>
