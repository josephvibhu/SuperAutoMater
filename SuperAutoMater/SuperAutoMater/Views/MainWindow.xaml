                            </controls:BentoCard>

                            <!-- CARD 3: WAREHOUSE INVENTORY PIPELINE -->
                            <controls:BentoCard Grid.Row="2" Title="WAREHOUSE INVENTORY PIPELINE" SubtitleBadge="CONNECTED">
                                <StackPanel Margin="0,4,0,0">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="CLOUD SHEET:" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Refurb_Inventory_2026" Style="{StaticResource TextBadgeMono}" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}"/>
                                    </DockPanel>

                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="OFFLINE QUEUE:" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OfflineQueueText}" Style="{StaticResource TextBadgeMono}" FontWeight="Bold" Foreground="{StaticResource BrushTextEmerald}"/>
                                    </DockPanel>

                                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Left" Text="LABEL PRINTER:" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Zebra ZD420 (ESC/POS)" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletLight}"/>
                                    </DockPanel>

                                    <!-- Cloud & QC Action Buttons -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="☁ SYNC SHEETS" Style="{StaticResource StyleDarkActionBtn}" Click="BtnOpenSyncMenu_Click" Margin="0,0,3,0"/>
                                        <Button Grid.Column="1" Content="🏷️ LABEL PREVIEW" Style="{StaticResource StyleDarkActionBtn}" Click="BtnOpenThermalPreview_Click" Margin="3,0,0,0" ToolTip="Live Thermal Sticker Visual Preview &amp; Direct Print [Ctrl+P]"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔋 BATTERY CALIBRATE" Style="{StaticResource StyleWarningActionBtn}" Click="BtnOpenBatteryDrainModal_Click" Margin="0,0,3,0" Padding="4,4" FontSize="10" ToolTip="Open BMS Battery Recalibration &amp; Controlled Drain Protocol Cockpit"/>
                                        <Button Grid.Column="1" Content="📸 QC PHOTOS" Style="{StaticResource StyleDarkActionBtn}" Click="BtnCaptureQcPhoto_Click" Margin="3,0,0,0" Padding="4,4" FontSize="10"/>
                                    </Grid>
                                </StackPanel>
                            </controls:BentoCard>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- 3. BOTTOM AVIONICS COMMAND & QUICK ACTIONS BAR                 -->
        <!-- ============================================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushTopBarGradient}"
                BorderBrush="{StaticResource BrushHairlineViolet}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,8"
                Margin="0,10,0,0"
                Effect="{StaticResource EffectBarShadow}">
            <DockPanel LastChildFill="False">
                <!-- Left: Hotkeys Quick Reference -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="HOTKEYS: " Style="{StaticResource TextHotkeyFoot}" FontWeight="Bold" Foreground="#58A6FF"/>

                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,4,0">
                        <TextBlock Text="Space" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextWhite}"/>
                    </Border>
                    <TextBlock Text="Pass Test   " Style="{StaticResource TextHotkeyFoot}" Foreground="{StaticResource BrushTextVioletMuted}"/>

                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,4,0">
                        <TextBlock Text="Enter" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextWhite}"/>
                    </Border>
                    <TextBlock Text="Sign-Off QC   " Style="{StaticResource TextHotkeyFoot}" Foreground="{StaticResource BrushTextVioletMuted}"/>

                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,4,0">
                        <TextBlock Text="Ctrl+P" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextWhite}"/>
                    </Border>
                    <TextBlock Text="Thermal Sticker   " Style="{StaticResource TextHotkeyFoot}" Foreground="{StaticResource BrushTextVioletMuted}"/>

                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,4,0">
                        <TextBlock Text="Alt+T" Style="{StaticResource TextBadgeMono}" Foreground="#58A6FF"/>
                    </Border>
                    <TextBlock Text="Tech Badge   " Style="{StaticResource TextHotkeyFoot}" Foreground="{StaticResource BrushTextVioletMuted}"/>

                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,4,0">
                        <TextBlock Text="F1-F7" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextWhite}"/>
                    </Border>
                    <TextBlock Text="Diagnostics   " Style="{StaticResource TextHotkeyFoot}" Foreground="{StaticResource BrushTextVioletMuted}"/>

                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,4,0">
                        <TextBlock Text="F10" Style="{StaticResource TextBadgeMono}" Foreground="#58A6FF" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Autopilot QC" Style="{StaticResource TextHotkeyFoot}" Foreground="#58A6FF" FontWeight="Bold"/>
                </StackPanel>

                <!-- Right: Station Audit & Ratio -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="STATION AUDIT ID: " Style="{StaticResource TextHotkeyFoot}" Foreground="{StaticResource BrushTextVioletMuted}"/>
                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,10,0">
                        <TextBlock Text="#SAM-20260909-001" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="|" Style="{StaticResource TextBadgeMono}" Foreground="#30363D" Margin="0,0,10,0"/>

                    <Border Background="#1E10B981" BorderBrush="#34D399" BorderThickness="1" CornerRadius="4" Padding="6,1">
                        <TextBlock Text="PASS RATIO: 100%" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextEmerald}" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
