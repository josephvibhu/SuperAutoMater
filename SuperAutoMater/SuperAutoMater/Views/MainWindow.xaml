                                                        <TextBox x:Name="TxtFpMfg" Text="--" IsReadOnly="True" Background="#0E1116" Foreground="{StaticResource BrushTextVioletLight}" BorderBrush="#30363D" Padding="8,5" FontFamily="{StaticResource FontMono}" FontSize="10"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
