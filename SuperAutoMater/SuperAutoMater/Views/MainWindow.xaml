                                                         </Border>
                                                         <TextBlock Text="Scan with phone or tablet to view live bench telemetry." 
                                                                    FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#8B949E" TextWrapping="Wrap" TextAlignment="Center"/>
