                                                     <TextBlock Text="WAREHOUSE FLEET LAN RADAR" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                                     <Border Background="#1A58A6FF" BorderBrush="#58A6FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                         <TextBlock x:Name="TxtFleetIpBadge" Text="PORT 8443 · UDP 9876" Style="{StaticResource TextBadgeMono}" Foreground="#58A6FF" FontWeight="Bold"/>
                                                     </Border>
                                                 </StackPanel>
                                                 <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
