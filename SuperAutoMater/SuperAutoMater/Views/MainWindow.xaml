                                                <CheckBox Grid.Row="3" Grid.Column="0" Content="Loose Hinges" IsChecked="{Binding DefectLooseHinges}" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#8B949E" Margin="0,2,2,2"/>
