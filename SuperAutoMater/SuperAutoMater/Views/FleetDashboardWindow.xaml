<Window x:Class="SuperAutoMater.Wpf.Views.FleetDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuperAutoMater — Warehouse Fleet LAN HUD &amp; Mobile Matrix"
        Height="720" Width="1140"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushObsidianRadial}"
        Icon="pack://application:,,,/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="Window_KeyDown">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Avionics Header -->
            <RowDefinition Height="*"/>    <!-- Main Body: QR Connect + Fleet Matrix -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP AVIONICS HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushTopBarGradient}"
                BorderBrush="{StaticResource BrushHairlineViolet}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,12"
                Margin="0,0,0,14"
                Effect="{StaticResource EffectBarShadow}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WAREHOUSE FLEET LAN HUD" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="15" Foreground="{StaticResource BrushTextWhite}"/>
                            <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="UDP 9876 MESH" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Multi-Bench Real-Time Telemetry Matrix · Mobile Browser Remote Monitoring" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1B4D3E" BorderBrush="#3FB950" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBenchesOnlineCount" Text="1 BENCH ONLINE (THIS NODE)" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#3FB950"/>
                    </Border>
                    <Button Content="✕ CLOSE [ESC]" Style="{StaticResource StyleDarkActionBtn}" Click="BtnClose_Click" Padding="12,5" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/> <!-- Left: Mobile QR Connect -->
                <ColumnDefinition Width="14"/>  <!-- Gutter -->
                <ColumnDefinition Width="*"/>   <!-- Right: Fleet Benches Matrix -->
            </Grid.ColumnDefinitions>

            <!-- LEFT ZONE: MOBILE QR CODE CONNECT -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#262C36" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="📱" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="MOBILE DASHBOARD" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextWhite}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#21262D" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="PORT 8443" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#BC8CFF" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>

                    <!-- QR Code Display Box -->
                    <Border Background="#0E1116" BorderBrush="#388BFD" BorderThickness="1.5" CornerRadius="12" Padding="12" Margin="0,0,0,14" HorizontalAlignment="Center" Effect="{StaticResource EffectCardShadow}">
                        <Image x:Name="ImgQrCode" Width="200" Height="200" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <!-- URL Display Box -->
                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="BENCH LAN DASHBOARD URL:" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDashboardUrl" Text="http://192.168.1.100:8443" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#58A6FF" Background="Transparent" BorderThickness="0" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📋 COPY URL" Style="{StaticResource StyleDarkActionBtn}" Click="BtnCopyUrl_Click" Padding="8,6" FontSize="11"/>
                        <Button Grid.Column="2" Content="🌐 OPEN BROWSER" Style="{StaticResource StyleDarkActionBtn}" Click="BtnOpenBrowser_Click" Padding="8,6" FontSize="11"/>
                    </Grid>

                    <!-- Tech Instructions -->
                    <Border Background="#0E1116" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="⚡ TECHNICIAN ZERO-SETUP" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="#3FB950" Margin="0,0,0,4"/>
                            <TextBlock Text="Scan this QR code with any phone or tablet on the warehouse Wi-Fi. It streams real-time CPU load, battery drain, storage health, and test pass/fail results as you walk the benches."
                                       TextWrapping="Wrap" FontFamily="{StaticResource FontSans}" FontSize="11" Foreground="#8B949E" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- RIGHT ZONE: MULTI-BENCH FLEET MATRIX -->
            <Border Grid.Column="2" Background="#161B22" BorderBrush="#262C36" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Matrix Header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="💻" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="ACTIVE SUBNET BENCHES" FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextWhite}"/>
                            <TextBlock Text=" (UDP Peer Discovery)" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="🔄 FORCE BEACON" Style="{StaticResource StyleDarkActionBtn}" Click="BtnForceBeacon_Click" Padding="10,4" FontSize="10" Margin="0,0,8,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Peer Benches Scroll List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- This Bench Tile (Always Present as Leader) -->
                            <Border x:Name="CardLocalBench" Background="#1C2128" BorderBrush="#388BFD" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#1B4D3E" BorderBrush="#3FB950" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="LOCAL NODE" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="#3FB950"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtLocalHostName" Text="WORKSTATION-01" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock Text=" · " Foreground="#8B949E"/>
                                            <TextBlock x:Name="TxtLocalModel" Text="Dell Latitude 5420" FontFamily="{StaticResource FontSans}" FontWeight="SemiBold" FontSize="13" Foreground="#58A6FF"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TxtLocalSerial" Text="S/N: ABC1234" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8B949E" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="TxtLocalIp" Text="IP: 192.168.1.100:8443" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8B949E"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                                            <TextBlock x:Name="TxtLocalPassCount" Text="10/10 PASSED" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#3FB950"/>
                                        </Border>
                                        <Border Background="#BC8CFF" CornerRadius="4" Padding="8,4">
                                            <TextBlock x:Name="TxtLocalGrade" Text="GRADE A+" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Peer Nodes ItemsControl -->
                            <ItemsControl x:Name="ItemsPeerBenches" ItemsSource="{Binding OnlineBenches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="REMOTE" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="#58A6FF"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding MachineName}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                        <TextBlock Text=" · " Foreground="#8B949E"/>
                                                        <TextBlock Text="{Binding Model}" FontFamily="{StaticResource FontSans}" FontWeight="SemiBold" FontSize="13" Foreground="#58A6FF"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Serial, StringFormat='S/N: {0}'}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8B949E" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding Url, StringFormat='URL: {0}'}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8B949E" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding LastSeenSummary, StringFormat='Seen: {0}'}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#3FB950"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="{Binding AccentHex}"/>
                                                    </Border>
                                                    <Border Background="#BC8CFF" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Grade}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                                    </Border>
                                                    <Button Content="🌐" Style="{StaticResource StyleDarkActionBtn}" Tag="{Binding Url}" Click="BtnOpenPeer_Click" Padding="8,4" FontSize="11" ToolTip="Open Peer Dashboard"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Subnet Listening Hint -->
                            <Border x:Name="CardMeshHint" Background="#0E1116" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="●" Foreground="#58A6FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Listening on UDP 9876. Other laptops running SuperAutoMater on this warehouse subnet will appear here automatically."
                                               FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#262C36" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Shortcuts: [Esc] Close · [F5] Re-Scan Mesh · [O] Open Web Dashboard in Browser" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="SUPERAUTOMATER v1.2 · WAREHOUSE FLEET PROTOCOL" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="#58A6FF" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
