<Window x:Class="SuperAutoMater.Wpf.Views.CpuStressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU &amp; Memory Stress Benchmark"
        Height="420" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0E1116"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <TextBlock Text="⚡ MULTI-CORE CPU &amp; RAM STRESS TEST" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtThreads" Text="Threads: 8" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#58A6FF" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Central Telemetry Card -->
        <Border Grid.Row="1" Background="#161B22" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="STRESS BENCHMARK RUNNING" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="14" Foreground="#3FB950" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtCpuPct" Text="100% LOAD" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="36" Foreground="{StaticResource BrushTextWhite}" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <ProgressBar x:Name="ProgBarStress" Height="10" Width="360" Background="#21262D" Foreground="#2EA043" Margin="0,14,0,0" Value="0" Maximum="10"/>

                <TextBlock x:Name="TxtTimer" Text="Elapsed: 0s / 10s" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextVioletSubdued}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="CANCEL / STOP [ESC]" Style="{StaticResource StyleDarkActionBtn}" Click="BtnCancel_Click" Width="170"/>
                <Button x:Name="BtnPass" Content="✓ PASS CPU TEST [ENTER]" Style="{StaticResource StyleCloudPassButton}" Click="BtnPass_Click" Width="220" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
