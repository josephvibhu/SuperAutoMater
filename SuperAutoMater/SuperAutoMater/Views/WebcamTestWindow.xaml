<Window x:Class="SuperAutoMater.Wpf.Views.WebcamTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="Webcam &amp; Sensor Diagnostic Test"
        Height="620" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0E1116"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Selector -->
            <RowDefinition Height="*"/>    <!-- Video Feed -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Top Header & Device Selector -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource BrushAccentEmerald}" Margin="0,0,8,0"/>
                    <TextBlock Text="WEBCAM &amp; CAMERA SENSOR" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="CAMERA: " FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextVioletSubdued}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbCameras" Width="280" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#2D333B" SelectionChanged="CmbCameras_SelectionChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Video Viewport -->
        <Border Grid.Row="1" Background="#000000" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <WindowsFormsHost x:Name="WfHostCamera">
                    <wf:PictureBox x:Name="PicCameraFeed" BackColor="Black" SizeMode="Zoom"/>
                </WindowsFormsHost>

                <!-- No Camera / Loading Overlay -->
                <StackPanel x:Name="StackNoCamera" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtNoCameraMsg" Text="Searching for camera sensor..." FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="#C9D1D9" HorizontalAlignment="Center"/>
                    <TextBlock Text="Check physical privacy shutter switch on laptop bezel" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="● SENSOR CONNECTED" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextEmerald}" FontWeight="Bold"/>
                    <TextBlock Text=" | " FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#30363D"/>
                    <TextBlock x:Name="TxtResolution" Text="1280x720 @ 30 FPS" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextVioletSubdued}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="CANCEL / CLOSE [ESC]" Style="{StaticResource StyleDarkActionBtn}" Click="BtnCancel_Click" Margin="0,0,8,0" Width="170"/>
                    <Button Content="✓ PASS CAMERA TEST [ENTER]" Style="{StaticResource StyleCloudPassButton}" Click="BtnPass_Click" Width="230"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
