<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Velox Deploy Electric Orange Tokens (Dark Theme) -->
    <Color x:Key="BrandOrangeColor">#FF7B00</Color>
    <Color x:Key="BrandOrangeHoverColor">#FF9426</Color>
    <Color x:Key="BrandOrangePressedColor">#E66E00</Color>
    <Color x:Key="BrandOrangeMutedColor">#33200B</Color>

    <SolidColorBrush x:Key="BrandOrangeBrush" Color="{StaticResource BrandOrangeColor}" />
    <SolidColorBrush x:Key="BrandOrangeHoverBrush" Color="{StaticResource BrandOrangeHoverColor}" />
    <SolidColorBrush x:Key="BrandOrangePressedBrush" Color="{StaticResource BrandOrangePressedColor}" />
    <SolidColorBrush x:Key="BrandOrangeMutedBrush" Color="{StaticResource BrandOrangeMutedColor}" />

    <!-- Surfaces & Backgrounds -->
    <Color x:Key="SurfaceBgColor">#0A0B0E</Color>
    <Color x:Key="SurfaceCardColor">#12141A</Color>
    <Color x:Key="SurfaceCardHoverColor">#181B24</Color>
    <Color x:Key="SurfacePanelColor">#0E1015</Color>

    <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHoverColor}" />
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}" />

    <!-- Borders -->
    <Color x:Key="BorderBaseColor">#212530</Color>
    <Color x:Key="BorderSubtleColor">#191C25</Color>
    <Color x:Key="BorderOrangeColor">#7A3F05</Color>

    <SolidColorBrush x:Key="BorderBaseBrush" Color="{StaticResource BorderBaseColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderOrangeBrush" Color="{StaticResource BorderOrangeColor}" />

    <!-- Typography Colors -->
    <Color x:Key="TextPrimaryColor">#F2F4F8</Color>
    <Color x:Key="TextSecondaryColor">#949EAE</Color>
    <Color x:Key="TextMutedColor">#586274</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Status Indicators -->
    <Color x:Key="StatusGreenColor">#00E599</Color>
    <Color x:Key="StatusYellowColor">#FFB800</Color>
    <Color x:Key="StatusRedColor">#FF4B55</Color>
    <Color x:Key="StatusBlueColor">#3B82F6</Color>

    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreenColor}" />
    <SolidColorBrush x:Key="StatusYellowBrush" Color="{StaticResource StatusYellowColor}" />
    <SolidColorBrush x:Key="StatusRedBrush" Color="{StaticResource StatusRedColor}" />
    <SolidColorBrush x:Key="StatusBlueBrush" Color="{StaticResource StatusBlueColor}" />

</ResourceDictionary>
