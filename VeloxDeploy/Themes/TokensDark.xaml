<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Velox Deploy Exact Build Spec Tokens (Dark) -->
    <!-- Surfaces -->
    <Color x:Key="AppBgColor">#0F1115</Color>
    <Color x:Key="PanelBgColor">#161922</Color>
    <Color x:Key="CardBgColor">#1D212C</Color>
    <Color x:Key="HoverBgColor">#262B38</Color>
    <Color x:Key="InsetBgColor">#0B0D11</Color>

    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBgColor}" />
    <SolidColorBrush x:Key="InsetBgBrush" Color="{StaticResource InsetBgColor}" />

    <!-- Borders -->
    <Color x:Key="BorderColor">#2A2F3C</Color>
    <Color x:Key="Border2Color">#3B4152</Color>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Border2Brush" Color="{StaticResource Border2Color}" />

    <!-- Typography -->
    <Color x:Key="Text1Color">#E8EAF0</Color>
    <Color x:Key="Text2Color">#A4ABBA</Color>
    <Color x:Key="Text3Color">#8A92A3</Color>

    <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1Color}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}" />

    <!-- Brand (Violet) -->
    <Color x:Key="BrandColor">#9279FF</Color>
    <Color x:Key="BrandBtnColor">#6F4FF2</Color>
    <Color x:Key="BrandSubtleColor">#241E3D</Color> <!-- rgba(146,121,255,.14) over #0F1115 -->

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandBtnBrush" Color="{StaticResource BrandBtnColor}" />
    <SolidColorBrush x:Key="BrandSubtleBrush" Color="{StaticResource BrandSubtleColor}" />

    <!-- Success (OK) -->
    <Color x:Key="OkColor">#3DD68C</Color>
    <Color x:Key="OkBgColor">#152B25</Color> <!-- rgba(61,214,140,.13) -->
    <Color x:Key="OkBdColor">#255943</Color> <!-- rgba(61,214,140,.35) -->
    <Color x:Key="OkBtnColor">#1B8A5A</Color>

    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkBgBrush" Color="{StaticResource OkBgColor}" />
    <SolidColorBrush x:Key="OkBdBrush" Color="{StaticResource OkBdColor}" />
    <SolidColorBrush x:Key="OkBtnBrush" Color="{StaticResource OkBtnColor}" />

    <!-- Warning (Warn) -->
    <Color x:Key="WarnColor">#F5B94A</Color>
    <Color x:Key="WarnBgColor">#2D271B</Color> <!-- rgba(245,185,74,.13) -->
    <Color x:Key="WarnBdColor">#5C4927</Color> <!-- rgba(245,185,74,.35) -->

    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}" />
    <SolidColorBrush x:Key="WarnBdBrush" Color="{StaticResource WarnBdColor}" />

    <!-- Danger / Error (Err) -->
    <Color x:Key="ErrColor">#FF6B6B</Color>
    <Color x:Key="ErrBgColor">#2E1D21</Color> <!-- rgba(255,107,107,.13) -->
    <Color x:Key="ErrBdColor">#5F3238</Color> <!-- rgba(255,107,107,.35) -->
    <Color x:Key="ErrBtnColor">#D13B3B</Color>

    <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource ErrColor}" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="{StaticResource ErrBgColor}" />
    <SolidColorBrush x:Key="ErrBdBrush" Color="{StaticResource ErrBdColor}" />
    <SolidColorBrush x:Key="ErrBtnBrush" Color="{StaticResource ErrBtnColor}" />

    <!-- Info (Blue) -->
    <Color x:Key="InfoColor">#4DA3FF</Color>
    <Color x:Key="InfoBgColor">#172535</Color> <!-- rgba(77,163,255,.13) -->
    <Color x:Key="InfoBdColor">#25486B</Color> <!-- rgba(77,163,255,.35) -->

    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}" />
    <SolidColorBrush x:Key="InfoBdBrush" Color="{StaticResource InfoBdColor}" />

    <!-- Logo Lime -->
    <Color x:Key="ColorDeployLogo">#A3D63D</Color>
    <SolidColorBrush x:Key="DeployLogoBrush" Color="{StaticResource ColorDeployLogo}" />

</ResourceDictionary>
