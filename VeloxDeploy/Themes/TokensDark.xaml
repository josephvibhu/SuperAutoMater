<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Velox Deploy Semantic Color Tokens (Dark Theme per Handoff Spec) -->
    
    <!-- Surfaces -->
    <Color x:Key="BgAppColor">#0A0B0E</Color>
    <Color x:Key="BgPanelColor">#12141A</Color>
    <Color x:Key="BgCardColor">#161922</Color>
    <Color x:Key="BgInsetColor">#07080B</Color>
    <Color x:Key="BgHoverColor">#1E2330</Color>

    <SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource BgAppColor}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgInsetBrush" Color="{StaticResource BgInsetColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />

    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#1E232E</Color>
    <Color x:Key="BorderStrongColor">#2D3546</Color>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <!-- Typography -->
    <Color x:Key="TextPrimaryColor">#F0F2F8</Color>
    <Color x:Key="TextSecondaryColor">#9AA2B5</Color>
    <Color x:Key="TextMutedColor">#5F677A</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Semantic Statuses -->
    <Color x:Key="InfoBlueColor">#3B82F6</Color>
    <Color x:Key="InfoBlueBgColor">#162544</Color>
    <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource InfoBlueColor}" />
    <SolidColorBrush x:Key="InfoBlueBgBrush" Color="{StaticResource InfoBlueBgColor}" />

    <Color x:Key="SuccessGreenColor">#00E599</Color>
    <Color x:Key="SuccessGreenBgColor">#0C291F</Color>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
    <SolidColorBrush x:Key="SuccessGreenBgBrush" Color="{StaticResource SuccessGreenBgColor}" />

    <Color x:Key="WarningAmberColor">#FFB800</Color>
    <Color x:Key="WarningAmberBgColor">#302206</Color>
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />
    <SolidColorBrush x:Key="WarningAmberBgBrush" Color="{StaticResource WarningAmberBgColor}" />

    <Color x:Key="DangerRedColor">#FF4B55</Color>
    <Color x:Key="DangerRedBgColor">#331317</Color>
    <Color x:Key="DangerRedButtonColor">#D13B3B</Color>
    <Color x:Key="DangerRedButtonHoverColor">#B52B2B</Color>
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}" />
    <SolidColorBrush x:Key="DangerRedBgBrush" Color="{StaticResource DangerRedBgColor}" />
    <SolidColorBrush x:Key="DangerRedButtonBrush" Color="{StaticResource DangerRedButtonColor}" />
    <SolidColorBrush x:Key="DangerRedButtonHoverBrush" Color="{StaticResource DangerRedButtonHoverColor}" />

    <!-- Primary Action / Violet CTA -->
    <Color x:Key="BrandVioletColor">#8B6CFF</Color>
    <Color x:Key="BrandVioletHoverColor">#A085FF</Color>
    <Color x:Key="BrandVioletPressedColor">#724FEA</Color>
    <Color x:Key="BrandVioletMutedColor">#2A224D</Color>

    <SolidColorBrush x:Key="BrandVioletBrush" Color="{StaticResource BrandVioletColor}" />
    <SolidColorBrush x:Key="BrandVioletHoverBrush" Color="{StaticResource BrandVioletHoverColor}" />
    <SolidColorBrush x:Key="BrandVioletPressedBrush" Color="{StaticResource BrandVioletPressedColor}" />
    <SolidColorBrush x:Key="BrandVioletMutedBrush" Color="{StaticResource BrandVioletMutedColor}" />

    <!-- Deploy Official Logo Accent: Lime -->
    <Color x:Key="DeployLogoLimeColor">#A3D63D</Color>
    <SolidColorBrush x:Key="DeployLogoLimeBrush" Color="{StaticResource DeployLogoLimeColor}" />

</ResourceDictionary>
