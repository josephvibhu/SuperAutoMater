<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Velox Deploy Electric Orange Tokens (Light Theme) -->
    <Color x:Key="BrandOrangeColor">#D95F00</Color>
    <Color x:Key="BrandOrangeHoverColor">#C25400</Color>
    <Color x:Key="BrandOrangePressedColor">#A84900</Color>
    <Color x:Key="BrandOrangeMutedColor">#FFEBD6</Color>

    <SolidColorBrush x:Key="BrandOrangeBrush" Color="{StaticResource BrandOrangeColor}" />
    <SolidColorBrush x:Key="BrandOrangeHoverBrush" Color="{StaticResource BrandOrangeHoverColor}" />
    <SolidColorBrush x:Key="BrandOrangePressedBrush" Color="{StaticResource BrandOrangePressedColor}" />
    <SolidColorBrush x:Key="BrandOrangeMutedBrush" Color="{StaticResource BrandOrangeMutedColor}" />

    <!-- Surfaces & Backgrounds -->
    <Color x:Key="SurfaceBgColor">#F5F7FA</Color>
    <Color x:Key="SurfaceCardColor">#FFFFFF</Color>
    <Color x:Key="SurfaceCardHoverColor">#F0F3F7</Color>
    <Color x:Key="SurfacePanelColor">#EDF1F7</Color>

    <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHoverColor}" />
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}" />

    <!-- Borders -->
    <Color x:Key="BorderBaseColor">#D8DFEA</Color>
    <Color x:Key="BorderSubtleColor">#E6ECF5</Color>
    <Color x:Key="BorderOrangeColor">#F2B680</Color>

    <SolidColorBrush x:Key="BorderBaseBrush" Color="{StaticResource BorderBaseColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderOrangeBrush" Color="{StaticResource BorderOrangeColor}" />

    <!-- Typography Colors -->
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#4B5563</Color>
    <Color x:Key="TextMutedColor">#9CA3AF</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Status Indicators -->
    <Color x:Key="StatusGreenColor">#059669</Color>
    <Color x:Key="StatusYellowColor">#D97706</Color>
    <Color x:Key="StatusRedColor">#DC2626</Color>
    <Color x:Key="StatusBlueColor">#2563EB</Color>

    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource StatusGreenColor}" />
    <SolidColorBrush x:Key="StatusYellowBrush" Color="{StaticResource StatusYellowColor}" />
    <SolidColorBrush x:Key="StatusRedBrush" Color="{StaticResource StatusRedColor}" />
    <SolidColorBrush x:Key="StatusBlueBrush" Color="{StaticResource StatusBlueColor}" />

</ResourceDictionary>
