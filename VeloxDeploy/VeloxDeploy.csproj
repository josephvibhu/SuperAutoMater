<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AssemblyName>VeloxDeploy</AssemblyName>
		<Product>VeloxDeploy — Rapid OS Imaging &amp; Depot Provisioning Cockpit</Product>
		<Company>Velox Depot Systems</Company>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<NoWarn>NU1701;NU1903;CS8632</NoWarn>

		<!-- Standalone single EXE publish settings for WinPE 11 / Live -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishReadyToRunComposite>true</PublishReadyToRunComposite>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
		<TieredCompilation>true</TieredCompilation>
		<Optimize>true</Optimize>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<ExcludeSatelliteAssemblies>true</ExcludeSatelliteAssemblies>

		<!-- Elevation manifest -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="app.ico" Condition="Exists('app.ico')" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Velox.Shared\Velox.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Management" Version="10.0.0" />
	</ItemGroup>

</Project>
