<Application x:Class="VeloxDeploy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/TokensDark.xaml" />
                <ResourceDictionary Source="Themes/ControlsShared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#1A1D24" />
                <Setter Property="Foreground" Value="#F2F4F8" />
                <Setter Property="BorderBrush" Value="#2D3240" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
