<Window x:Class="VeloxDeploy.ModelBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Driver Vault &amp; Hardware Catalog"
        Height="680" Width="960"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        FontFamily="Source Sans 3, Segoe UI, system-ui, sans-serif"
        FontSize="13.5"
        Foreground="{DynamicResource Text1Brush}"
        Background="{DynamicResource AppBgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Brand Filter Radio Pill Style -->
        <Style x:Key="BrandPillRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource BrandBtnBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Model Card ListBoxItem Style -->
        <Style x:Key="ModelCardListBoxItem" TargetType="ListBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="true" />
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="cardBorder"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,11"
                                Margin="0,0,0,7"
                                SnapsToDevicePixels="true">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource BrandSubtleBrush}" />
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header (60px) -->
            <RowDefinition Height="64" />
            <!-- 1: Search & Filter Toolbar (54px) -->
            <RowDefinition Height="56" />
            <!-- 2: Busy Progress (Auto) -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main Model Catalog List (*) -->
            <RowDefinition Height="*" />
            <!-- 4: Footer Bar (60px) -->
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <!-- 0: HEADER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="📦" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Driver Vault &amp; Hardware Catalog" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Select target laptop or desktop model to stage verified OEM drivers into the deployment image."
                               FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                </StackPanel>

                <!-- Catalog Total Badge -->
                <Border Grid.Column="1" Height="26" CornerRadius="13" Padding="12,0" VerticalAlignment="Center"
                        Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="105+ Models Available" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 1: SEARCH & FILTER TOOLBAR -->
        <Border Grid.Row="1" Background="{DynamicResource AppBgBrush}" Padding="20,10,20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Box -->
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="14" />
                    <!-- Filter Pills -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Height="36" CornerRadius="8" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <TextBox Grid.Column="1" x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Text1Brush}"
                                 CaretBrush="{DynamicResource Text1Brush}"
                                 FontSize="13" VerticalContentAlignment="Center" />

                        <!-- Placeholder Text -->
                        <TextBlock Grid.Column="1" Text="Search model, series, softpaq (e.g. 640 G9, 7490, T14)..."
                                   FontSize="12.5" Foreground="{DynamicResource Text3Brush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Clear Search Button -->
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"
                                Padding="4,0" VerticalAlignment="Center">
                            <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource Text3Brush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Filter Pills -->
                <Border Grid.Column="2" HorizontalAlignment="Right" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Background="{DynamicResource InsetBgBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="All Models" IsChecked="{Binding IsBrandAll, Mode=TwoWay}" Style="{StaticResource BrandPillRadio}" />
                        <RadioButton Content="Dell" IsChecked="{Binding IsBrandDell, Mode=TwoWay}" Style="{StaticResource BrandPillRadio}" />
                        <RadioButton Content="Lenovo" IsChecked="{Binding IsBrandLenovo, Mode=TwoWay}" Style="{StaticResource BrandPillRadio}" />
                        <RadioButton Content="HP" IsChecked="{Binding IsBrandHP, Mode=TwoWay}" Style="{StaticResource BrandPillRadio}" />
                        <RadioButton Content="🟢 Local Vault" IsChecked="{Binding IsBrandVault, Mode=TwoWay}" Style="{StaticResource BrandPillRadio}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2: BUSY PROGRESS BAR (VISIBLE DURING DOWNLOAD / CAPTURE) -->
        <Border Grid.Row="2" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="20,8"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding BusyStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BusyProgress, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Height="4" Value="{Binding BusyProgress}" Minimum="0" Maximum="100"
                             Foreground="{DynamicResource BrandBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- 3: MAIN MODEL CATALOG LIST -->
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding FilteredItems}"
                 SelectedItem="{Binding SelectedItem}"
                 ItemContainerStyle="{StaticResource ModelCardListBoxItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="20,8,20,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="ListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Model Details -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Brand badge, Model Name, Series & Package info -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <!-- Manufacturer Brand Pill -->
                                <Border Height="22" CornerRadius="4" Padding="7,0" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Manufacturer}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                                </Border>

                                <!-- Host Machine Pill (if applicable) -->
                                <Border Height="22" CornerRadius="4" Padding="7,0" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Background="{DynamicResource BrandSubtleBrush}" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1"
                                        Visibility="{Binding IsHostUnit, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="DEPOT BENCH PC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" />
                                </Border>

                                <!-- Model Name -->
                                <TextBlock Text="{Binding ModelName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Sub-details: Series • OS • Package File -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Series}" FontSize="12" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OsVersion}" FontSize="12" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FileName}" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="11.5" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Column: Status Badge & 1-Click Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Status Badge -->
                            <Border Height="26" CornerRadius="13" Padding="12,0" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource InfoBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBdBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCached}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource OkBdBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding StatusBadgeText}" />
                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCached}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Download Button (If not cached) -->
                            <Button Command="{Binding DataContext.DownloadItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                                    Height="30" Padding="10,0" Margin="0,0,8,0" Cursor="Hand"
                                    Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⬇" FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Download" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Select Model Button -->
                            <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Height="30" Padding="14,0" Cursor="Hand"
                                    Background="{DynamicResource BrandBtnBrush}" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Select" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 4: FOOTER ACTION BAR -->
        <Border Grid.Row="4" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Summary Text + Quick Links -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Quick link: Capture PC -->
                    <Button Command="{Binding CaptureHostCommand}"
                            Background="Transparent" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                            Height="28" Padding="10,0" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Capture This PC" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Quick link: Open Vault Folder -->
                    <Button Command="{Binding OpenFolderCommand}"
                            Background="Transparent" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                            Height="28" Padding="10,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Open Vault Folder" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right: Cancel & Select Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Height="34" Padding="16,0" Margin="0,0,10,0" Cursor="Hand"
                            Background="Transparent" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                            Foreground="{DynamicResource Text2Brush}" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Select Model" Command="{Binding SelectCommand}"
                            Height="34" Padding="20,0" Cursor="Hand"
                            Background="{DynamicResource BrandBtnBrush}" BorderThickness="0"
                            Foreground="#FFFFFF" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
