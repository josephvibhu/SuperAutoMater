<Window x:Class="VeloxDeploy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VeloxDeploy.ViewModels"
        mc:Ignorable="d"
        Title="Velox Deploy" 
        Height="700" Width="1240"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Source Sans 3, Segoe UI, system-ui, sans-serif"
        FontSize="14"
        Foreground="{DynamicResource Text1Brush}"
        Background="{DynamicResource AppBgBrush}">

    <Window.DataContext>
        <vm:DeployViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RescanDisksCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveLogCommand}" />
        <KeyBinding Key="Esc" Command="{Binding CancelConfirmationCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Segmented Radio Button Style for Log Filters -->
        <Style x:Key="SegmentedRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style per spec (38x22, radius 11, knob 16px, vertically centered) -->
        <Style x:Key="SpecToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" 
                                    Background="{DynamicResource Border2Brush}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Canvas Width="38" Height="22">
                                    <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#FFFFFF" Canvas.Left="3" Canvas.Top="3" />
                                </Canvas>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandBtnBrush}" />
                                <Setter TargetName="Knob" Property="Canvas.Left" Value="19" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style (height 28, padding 0 8, 13.5px, brand text, no border) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrandSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <!-- MAIN APP GRID: Top Bar (56px), Content (*), Action Bar (76px) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <!-- 1. TOP BAR (56 px) -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Name & Version -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Official SVG Logo (40 by 37, viewBox 0 0 50 46) -->
                        <Viewbox Width="36" Height="33" Margin="0,0,12,0">
                            <Canvas Width="50" Height="46">
                                <Path Data="M7 5L22 39L32 16" Stroke="{DynamicResource Text1Brush}" StrokeThickness="9" StrokeLineJoin="Bevel" />
                                <Path Data="M27 27.5L32 16" Stroke="{DynamicResource DeployLogoBrush}" StrokeThickness="9" />
                                <Path Data="M37.65 1.5V14.5M37.65 2.95H42Q47.3 2.95 47.3 8Q47.3 13.05 42 13.05H37.65" 
                                      Stroke="{DynamicResource DeployLogoBrush}" StrokeThickness="2.9" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="Velox" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                        <TextBlock Text="Deploy" FontSize="17" FontWeight="Normal" Foreground="{DynamicResource Text2Brush}" Margin="6,0,0,0" VerticalAlignment="Center" />

                        <!-- Version Chip -->
                        <Border Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" CornerRadius="12" Height="24" Padding="10,0" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0 Beta" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Center: Depot Unit Chip -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Height="34" CornerRadius="17" Padding="14,0" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Depot unit" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Profile.Model}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="SN" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" Margin="10,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Profile.BiosSerial}" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Right: License Chip, Cloud Chip, Split Theme Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- License Chip -->
                        <Border Height="24" CornerRadius="12" Padding="10,0" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarnBdBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource OkBdBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Windows license key not found" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                    <Setter Property="Text" Value="Windows key detected" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Cloud Chip -->
                        <Border Height="24" CornerRadius="12" Padding="10,0" Margin="0,0,12,0" Background="{DynamicResource OkBgBrush}" BorderBrush="{DynamicResource OkBdBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding CloudStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Theme Toggle Split Circle Button (34 px circle, half dark #14171F, half light #F3F4F7) -->
                        <Button Command="{Binding ToggleThemeCommand}" Width="34" Height="34" Cursor="Hand" ToolTip="Toggle Dark / Light" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="34" Height="34" CornerRadius="17" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#14171F" />
                                            <Rectangle Grid.Column="1" Fill="#F3F4F7" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. CONTENT (Grid with two columns: 400 px and flexible, gap 14 px, padding 14 top/bottom, 20 left/right) -->
            <Grid Grid.Row="1" Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN CARDS (Scrollable vertical stack so no settings are ever clipped) -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,14,0" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- 5.1 TARGET DISK CARD -->
                        <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="TARGET DISK" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                    <Button Content="Rescan (F5)" Command="{Binding RescanDisksCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Select: height 40, radius 8, background -inset, 1 px -bd2, padding 0 12, weight 600 -->
                                <Border Height="40" CornerRadius="8" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" Padding="12,0">
                                    <Grid VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}"
                                                  IsEnabled="{Binding IsIdle}"
                                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text1Brush}" FontWeight="SemiBold" FontSize="13.5">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayText}" Foreground="{DynamicResource Text1Brush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Height="20" CornerRadius="10" Padding="8,0" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHostSystemDisk}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarnBdBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsUsbFlashDrive}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BrandSubtleBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDirectTargetSsd}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource OkBdBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding TargetModeBadge}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHostSystemDisk}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsUsbFlashDrive}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDirectTargetSsd}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Partition Bar (10 px below select: height 22, gap 3, segments radius 4) -->
                                <Grid Height="22" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="78*" />
                                        <ColumnDefinition Width="12*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource InfoBrush}" CornerRadius="4" Margin="0,0,3,0" ToolTip="EFI System Partition (300 MB)" />
                                    <Border Grid.Column="1" Background="{DynamicResource Text3Brush}" CornerRadius="4" Margin="0,0,3,0" ToolTip="Microsoft Reserved Partition (16 MB)" />
                                    <Border Grid.Column="2" Background="{DynamicResource BrandBtnBrush}" CornerRadius="4" Margin="0,0,3,0" ToolTip="Windows OS Partition (NTFS)" />
                                    <Border Grid.Column="3" Background="{DynamicResource Border2Brush}" CornerRadius="4" ToolTip="Windows Recovery Partition (900 MB)" />
                                </Grid>

                                <!-- Legend -->
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource InfoBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="EFI 300 MB" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Text3Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="MSR" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource BrandBtnBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Windows NTFS" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Border2Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="WinRE" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Warning chip -->
                                <Border Height="24" CornerRadius="12" Padding="10,0" Background="{DynamicResource ErrBgBrush}" BorderBrush="{DynamicResource ErrBdBrush}" BorderThickness="1" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="All data on target disk will be erased." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ErrBrush}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 5.2 IMAGE CARD -->
                        <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="IMAGE" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                    <Button Content="Change" Command="{Binding ChangeImageCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding Config.SelectedImageName}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Config.SelectedImageDetails}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- 5.3 DRIVERS AND AUTOMATION CARD (Prominent & Clear) -->
                        <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="DRIVERS AND AUTOMATION" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                    <Border Height="20" CornerRadius="10" Padding="8,0" Background="{DynamicResource OkBgBrush}" BorderBrush="{DynamicResource OkBdBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                        <TextBlock Text="18 Packages Ready" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Driver Match Banner -->
                                <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="OEM Driver Repository" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                            <TextBlock Text="Automatic hardware matching during Windows setup" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Height="22" CornerRadius="11" Padding="8,0" Background="{DynamicResource OkBgBrush}" BorderBrush="{DynamicResource OkBdBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="Matched" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 4 Distinct Automation Setting Rows with High Contrast -->
                                <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                    <StackPanel>
                                        <!-- Row 1: Skip MSA -->
                                        <CheckBox Style="{StaticResource SpecToggleSwitch}" IsChecked="{Binding Config.SkipMicrosoftAccount}" IsEnabled="{Binding IsIdle}" Margin="0,4">
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="Skip Microsoft account (OOBE Bypass)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" />
                                                <TextBlock Text="Install Windows with an offline local administrator" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </CheckBox>

                                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4" />

                                        <!-- Row 2: Auto-logon -->
                                        <CheckBox Style="{StaticResource SpecToggleSwitch}" IsChecked="{Binding Config.AutoLogonUser}" IsEnabled="{Binding IsIdle}" Margin="0,4">
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="Auto-logon default user account" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" />
                                                <TextBlock Text="Sign straight into desktop on first target boot" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </CheckBox>

                                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4" />

                                        <!-- Row 3: Launch Velox Bench -->
                                        <CheckBox Style="{StaticResource SpecToggleSwitch}" IsChecked="{Binding Config.LaunchVeloxBench}" IsEnabled="{Binding IsIdle}" Margin="0,4">
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="Launch Velox Bench on target first boot" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" />
                                                <TextBlock Text="Run automated hardware diagnostics &amp; stress tests" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </CheckBox>

                                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4" />

                                        <!-- Row 4: Safely Eject -->
                                        <CheckBox Style="{StaticResource SpecToggleSwitch}" IsChecked="{Binding Config.SafelyEjectOnComplete}" IsEnabled="{Binding IsIdle}" Margin="0,4">
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="Safely eject drive when deployment finishes" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" />
                                                <TextBlock Text="Unmount partitions safely after writes complete" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 5.4 WORKSTATION HARDWARE (Compact Reference Card) -->
                        <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="WORKSTATION HARDWARE" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                    <Border Height="20" CornerRadius="10" Padding="8,0" Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Host Reference" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Profile.CpuName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0">
                                    <Run Text="{Binding Profile.RamGb, Mode=OneWay}" />
                                    <Run Text=" GB RAM · " />
                                    <Run Text="{Binding Profile.CpuCores}" />
                                    <Run Text="C/" />
                                    <Run Text="{Binding Profile.CpuThreads}" />
                                    <Run Text="T · UEFI 64-bit · " />
                                    <Run Text="{Binding Profile.Manufacturer}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- CENTER COLUMN (Step indicator, Progress card, Preflight, Log fills remaining height) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- 6.1 Step indicator -->
                        <RowDefinition Height="Auto" />
                        <!-- 6.2 Progress card -->
                        <RowDefinition Height="Auto" />
                        <!-- 6.3 Preflight / Summary -->
                        <RowDefinition Height="Auto" />
                        <!-- 6.4 Deployment log fills remaining height -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 6.1 STEP INDICATOR (Card with padding 14 8, 6 equal columns) -->
                    <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Step 1: Probe (Done) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource OkBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="2" Margin="0,0,8,0">
                                    <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Steps[0].Name, FallbackValue='Probe'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                    <TextBlock Text="{Binding Steps[0].Status, FallbackValue='Done, 0:04'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 2: Partition -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="DiskPartitioning">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="WimStreaming">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="2" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Steps[1].Name, FallbackValue='Partition'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                    <TextBlock Text="{Binding Steps[1].Status, FallbackValue='Waiting'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 3: Stream -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="WimStreaming">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="3" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Steps[2].Name, FallbackValue='Stream'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                    <TextBlock Text="{Binding Steps[2].Status, FallbackValue='Waiting'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 4: Drivers -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="4" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Steps[3].Name, FallbackValue='Drivers'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                    <TextBlock Text="{Binding Steps[3].Status, FallbackValue='Waiting'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 5: Unattend -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="5" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Steps[4].Name, FallbackValue='Unattend'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                    <TextBlock Text="{Binding Steps[4].Status, FallbackValue='Waiting'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 6: Ready -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="6" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Steps[5].Name, FallbackValue='Ready'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                    <TextBlock Text="{Binding Steps[5].Status, FallbackValue='Waiting'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 6.2 PROGRESS CARD (Padding 14 by 16 px) -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <!-- Percentage & Activity -->
                                    <ColumnDefinition Width="*" />
                                    <!-- 4 Stat Boxes -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: 52 px percentage, 17 px activity line, mode chip -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F1}}" FontSize="52" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Bottom" />
                                        <TextBlock Text="%" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" Margin="4,0,0,8" VerticalAlignment="Bottom" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding CurrentActionText}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" Margin="0,4,0,0" />

                                    <!-- Target Mode Badge (Rufus USB / Direct SSD) -->
                                    <Border Height="24" CornerRadius="12" Padding="10,0" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Background="{DynamicResource BrandSubtleBrush}" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedDisk.TargetModeBadge, FallbackValue='Rufus Pendrive &amp; SSD Engine'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <!-- Right: Four Stat Boxes (Padding 9 14, radius 10, background -inset, 1 px -bd, min-width 116) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Throughput -->
                                    <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" MinWidth="116" Margin="0,0,10,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="THROUGHPUT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding SpeedMBps, StringFormat={}{0:F1}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                                <TextBlock Text=" MB/s" FontSize="13" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Data Applied -->
                                    <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" MinWidth="116" Margin="0,0,10,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DATA APPLIED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" />
                                            <TextBlock Text="{Binding BytesText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Elapsed -->
                                    <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" MinWidth="116" Margin="0,0,10,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="ELAPSED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" />
                                            <TextBlock Text="{Binding ElapsedText}" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Remaining -->
                                    <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" MinWidth="116">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="REMAINING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" />
                                            <TextBlock Text="{Binding RemainingText}" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Progress Bar (14 px below, height 10, radius 5, track -hv, fill -info) -->
                            <Border Grid.Row="1" Height="10" Background="{DynamicResource HoverBgBrush}" CornerRadius="5" Margin="0,14,0,0">
                                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="10" Background="Transparent" BorderThickness="0">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 6.3 PREFLIGHT CHECKS (Ready state only, 4 equal columns) -->
                    <Border Grid.Row="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12"
                            Visibility="{Binding IsRunning, Converter={x:Null}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PREFLIGHT CHECKS" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                <!-- Chip on the right (e.g. Ready to deploy, 1 warning in amber) -->
                                <Border Height="24" CornerRadius="12" Padding="10,0" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBdBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PreflightSummaryText, FallbackValue='Ready to deploy, 1 warning'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 1. Target Disk Check -->
                                <Border Grid.Column="0" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource OkBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PreflightChecks[0].Name, FallbackValue='Target disk'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                            <TextBlock Text="{Binding PreflightChecks[0].Message, FallbackValue='Disk 0 selected, not boot media'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Image Check -->
                                <Border Grid.Column="1" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="5,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource OkBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PreflightChecks[1].Name, FallbackValue='Image'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                            <TextBlock Text="{Binding PreflightChecks[1].Message, FallbackValue='Reachable, 14.5 GB'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Drivers Check -->
                                <Border Grid.Column="2" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="5,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource OkBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PreflightChecks[2].Name, FallbackValue='Drivers'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                            <TextBlock Text="{Binding PreflightChecks[2].Message, FallbackValue='18 packages matched'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Windows Key Check (Warning) -->
                                <Border Grid.Column="3" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="5,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource OkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="!" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                                <Setter Property="Text" Value="✓" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PreflightChecks[3].Name, FallbackValue='Windows key'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />
                                            <TextBlock Text="{Binding PreflightChecks[3].Message, FallbackValue='Not found, continues unactivated'}" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 6.4 DEPLOYMENT LOG (Card with no padding, fills remaining height) -->
                    <Border Grid.Row="3" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Header: padding 10 16, bottom border 1 px -bd -->
                                <RowDefinition Height="Auto" />
                                <!-- Body: padding 12 16, background -inset, JetBrains Mono 13 px, line height 1.75 -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Deployment log" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />

                                    <!-- Segmented Filter (1 px -bd2, radius 8, items padding 4 12, 13 px weight 600 -t2) -->
                                    <Border Grid.Column="1" HorizontalAlignment="Center" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" CornerRadius="8" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="All" IsChecked="{Binding IsFilterAll, Mode=TwoWay}" GroupName="LogFilterGrp" Style="{StaticResource SegmentedRadio}" Height="26" Padding="12,0" Margin="2,0" />
                                            <RadioButton Content="Warnings" IsChecked="{Binding IsFilterWarnings, Mode=TwoWay}" GroupName="LogFilterGrp" Style="{StaticResource SegmentedRadio}" Height="26" Padding="12,0" Margin="2,0" />
                                            <RadioButton Content="Errors" IsChecked="{Binding IsFilterErrors, Mode=TwoWay}" GroupName="LogFilterGrp" Style="{StaticResource SegmentedRadio}" Height="26" Padding="12,0" Margin="2,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Ghost Buttons: Copy & Save log (Ctrl+S) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Copy" Command="{Binding CopyLogCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                        <Button Content="Save log (Ctrl+S)" Command="{Binding SaveLogCommand}" Style="{StaticResource GhostButton}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Log Body -->
                            <Border Grid.Row="1" Background="{DynamicResource InsetBgBrush}" Padding="16,12" CornerRadius="0,0,12,12">
                                <ListBox x:Name="LogListBox" ItemsSource="{Binding FilteredLogs}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="13" Foreground="{DynamicResource Text3Brush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Source, StringFormat={}[{0}]}" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="13" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="13" Foreground="{DynamicResource Text1Brush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. ACTION BAR (76 px, padding 0 20, gap 16, background -panel, top border 1 px -bd) -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left: Target Device Status Display -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Action Buttons -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Target Device Status Chip -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Height="44" CornerRadius="10" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" Background="{DynamicResource InsetBgBrush}" Padding="14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Status indicator dot -->
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource BrandBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDisk.IsDirectTargetSsd}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedDisk.IsHostSystemDisk}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedDisk}" Value="{x:Null}">
                                                    <Setter Property="Fill" Value="{DynamicResource Text3Brush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Target Drive:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text3Brush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SelectedDisk.DisplayText, FallbackValue='No target disk selected'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" />

                                        <!-- Mode badge -->
                                        <Border Height="20" CornerRadius="10" Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BrandSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedDisk.IsDirectTargetSsd}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource OkBdBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedDisk.IsHostSystemDisk}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarnBdBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectedDisk.TargetModeBadge, FallbackValue='Select Disk'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Destructive writes require typing ERASE to confirm before flashing." FontSize="11.5" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Side Buttons (gap 16, height 40) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Abort / Safe Eject Button -->
                        <Button Content="{Binding SecondaryButtonText}" Command="{Binding SecondaryActionCommand}" Height="40" Padding="18,0" Margin="0,0,16,0"
                                Background="Transparent" Foreground="{DynamicResource ErrBrush}" BorderBrush="{DynamicResource ErrBdBrush}" BorderThickness="1"
                                FontSize="14.5" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource OkBdBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Primary Button (Brand Violet Fill, ERASE safety on click) -->
                        <Button Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryActionCommand}" Height="40" Padding="20,0"
                                FontSize="14.5" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource BrandBtnBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrandBtnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 8. LIVE CONFIRMATION DIALOG (Width 560, background -panel, 1 px -bd2 border, radius 14, shadow, padding 22 24, gap 14) -->
        <Grid Background="#9E05070A" Visibility="{Binding IsConfirmationDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="560" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" CornerRadius="14" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Title Row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource ErrBgBrush}" BorderBrush="{DynamicResource ErrBdBrush}" BorderThickness="1" Margin="0,0,14,0">
                            <TextBlock Text="!" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource ErrBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Erase Target Disk and Deploy?" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDisk.IsUsbFlashDrive}" Value="True">
                                            <Setter Property="Text" Value="Format USB and Create Bootable Media?" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Summary: label and value rows (label column 90 px): Disk, Image, Unit -->
                    <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Disk" FontSize="13" Foreground="{DynamicResource Text3Brush}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDisk.DisplayText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Image" FontSize="13" Foreground="{DynamicResource Text3Brush}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Windows 11 Pro 24H2 (x64)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Unit" FontSize="13" Foreground="{DynamicResource Text3Brush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" Foreground="{DynamicResource Text1Brush}" Margin="0,2">
                                <Run Text="{Binding Profile.Model}" FontWeight="Bold" />
                                <Run Text=", SN " />
                                <Run Text="{Binding Profile.BiosSerial}" FontFamily="JetBrains Mono, Consolas, monospace" FontWeight="Bold" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Warning Box: padding 12, radius 10, -errbg background, 1 px -errbd border, -err text weight 600 -->
                    <Border Background="{DynamicResource ErrBgBrush}" BorderBrush="{DynamicResource ErrBdBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <TextBlock Text="All partitions and data on this disk will be permanently erased. This cannot be undone." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ErrBrush}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Two Check Lines with 18 px green circles -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource OkBrush}" Margin="0,0,8,0">
                                <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Target disk is not host boot/system drive" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource OkBrush}" Margin="0,0,8,0">
                                <TextBlock Text="✓" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Image and drivers are verified" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Field: Type ERASE to confirm (weight 600), then input height 42, radius 8, background -inset, 1 px -bd2, mono 15 px weight 500 -->
                    <TextBlock Text="Type ERASE to confirm" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}" Margin="0,0,0,6" />
                    <Border Height="42" CornerRadius="8" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1" Margin="0,0,0,20">
                        <TextBox Text="{Binding ConfirmationInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                 FontFamily="JetBrains Mono, Consolas, monospace" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource Text1Brush}" Padding="12,10" VerticalAlignment="Center" />
                    </Border>

                    <!-- Buttons: Cancel (secondary, focused by default) and Erase and deploy (-errb fill, disabled until ERASE is typed) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelConfirmationCommand}" Height="40" Padding="18,0" Margin="0,0,10,0"
                                Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource Text1Brush}" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                                FontSize="14.5" FontWeight="SemiBold" Cursor="Hand" />
                        <Button Content="Erase and deploy" Command="{Binding ConfirmLiveDeployCommand}" Height="40" Padding="18,0"
                                Background="{DynamicResource ErrBtnBrush}" Foreground="#FFFFFF" BorderThickness="0"
                                FontSize="14.5" FontWeight="SemiBold" Cursor="Hand" IsEnabled="{Binding CanConfirmLive}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
