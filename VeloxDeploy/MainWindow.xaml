<Window x:Class="VeloxDeploy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VeloxDeploy.ViewModels"
        mc:Ignorable="d"
        Title="Velox Deploy — Developer UI Cockpit" 
        Height="720" Width="1240"
        MinHeight="540" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgAppBrush}">

    <Window.DataContext>
        <vm:DeployViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Toggle Switch Style (Violet on, Grey off) -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#262C38" Padding="2" Margin="0,0,10,0">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#9AA2B5" HorizontalAlignment="Left" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontSize="12" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandVioletBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <!-- Main Application Layout -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Bar (48px) -->
                <RowDefinition Height="48" />
                <!-- Optional Live Armed Warning Banner (30px) -->
                <RowDefinition Height="Auto" />
                <!-- Main Content Area -->
                <RowDefinition Height="*" />
                <!-- Bottom Action Bar (58px) -->
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <!-- 1. TOP BAR (48px) -->
            <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <!-- Logo & Title -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Center Depot Unit Chip -->
                        <ColumnDefinition Width="*" />
                        <!-- Status Chips & Theme Toggle -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Official Deploy Logo (V with Lime D) & App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="32" Height="28" Margin="0,0,12,0">
                            <Canvas Width="50" Height="44">
                                <!-- V Mark in primary text color -->
                                <Path Data="M7 5L22 39L32 16" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="9" StrokeLineJoin="Bevel" />
                                <!-- Lime Accent Stroke -->
                                <Path Data="M27 27.5L32 16" Stroke="{DynamicResource DeployLogoLimeBrush}" StrokeThickness="9" />
                                <!-- Lime D for Deploy -->
                                <Path Data="M37.65 1.5V14.5M37.65 2.95H42Q47.3 2.95 47.3 8Q47.3 13.05 42 13.05H37.65" 
                                      Stroke="{DynamicResource DeployLogoLimeBrush}" StrokeThickness="2.9" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="VELOX" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Black" VerticalAlignment="Center" />
                        <TextBlock Text="Deploy" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="18" FontWeight="Normal" Margin="6,0,0,0" VerticalAlignment="Center" />
                        
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0 Beta" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Center: Depot Unit Chip -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Depot unit" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Profile.Model}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="•" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0" />
                            <TextBlock Text="SN" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Profile.BiosSerial}" FontFamily="Consolas, monospace" Foreground="{DynamicResource BrandVioletBrush}" FontSize="12" FontWeight="Bold" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Right: License, Cloud & Theme Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- License Chip -->
                        <Border CornerRadius="14" Padding="10,5" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource WarningAmberBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningAmberBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessGreenBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource WarningAmberBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Windows key not found" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                    <Setter Property="Text" Value="Windows key detected" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Cloud Chip -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessGreenBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding CloudStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Theme Toggle Button -->
                        <Button Command="{Binding ToggleThemeCommand}" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Toggle Theme">
                            <TextBlock Text="🌓" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. OPTIONAL LIVE ARMED WARNING BANNER (34px) -->
            <Border Grid.Row="1" Background="{DynamicResource DangerRedBgBrush}" BorderBrush="{DynamicResource DangerRedBrush}" BorderThickness="0,0,0,1" Height="34"
                    Visibility="{Binding IsLiveArmedBannerVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠" Foreground="{DynamicResource DangerRedBrush}" FontWeight="Bold" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LiveBannerText}" Foreground="{DynamicResource DangerRedBrush}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. MAIN CONTENT AREA -->
            <Grid Grid.Row="2" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <!-- Left Settings Column (330px) -->
                    <ColumnDefinition Width="330" />
                    <!-- Center Flexible Pipeline Column -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SETTINGS COLUMN -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                    <StackPanel>
                        <!-- 6.1 Hardware Details Card -->
                        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HARDWARE" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />

                                <Grid Margin="0,4">
                                    <TextBlock Text="Processor" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{Binding Profile.CpuName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Cores &amp; threads" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                        <Run Text="{Binding Profile.CpuCores}" FontWeight="Bold" />
                                        <Run Text=" cores, " />
                                        <Run Text="{Binding Profile.CpuThreads}" FontWeight="Bold" />
                                        <Run Text=" threads" />
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Memory" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                        <Run Text="{Binding Profile.RamGb, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text=" GB" />
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Firmware" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <Border Background="{DynamicResource SuccessGreenBgBrush}" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="UEFI 64-bit" Foreground="{DynamicResource SuccessGreenBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Windows key" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource WarningAmberBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningAmberBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessGreenBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Not detected" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                            <Setter Property="Text" Value="Detected" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6.2 Target Disk Card -->
                        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="TARGET DISK" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Content="Rescan (F5)" Command="{Binding RescanDisksCommand}" HorizontalAlignment="Right" FontSize="11" Padding="6,2" Background="Transparent" Foreground="{DynamicResource BrandVioletBrush}" BorderThickness="0" Cursor="Hand" />
                                </Grid>

                                <!-- Styled Select Dropdown (40px) -->
                                <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" DisplayMemberPath="DisplayText" Height="40" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" IsEnabled="{Binding IsRunning, Converter={x:Null}}" Margin="0,0,0,10" />

                                <!-- Partition Layout Bar (22px) -->
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Standard depot GPT partition layout:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,6" />
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="18*" />
                                                <ColumnDefinition Width="4*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- EFI (Blue) -->
                                            <Border Grid.Column="0" Background="{DynamicResource InfoBlueBgBrush}" BorderBrush="{DynamicResource InfoBlueBrush}" BorderThickness="1" Margin="1" CornerRadius="3">
                                                <TextBlock Text="EFI 300M" Foreground="{DynamicResource InfoBlueBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- MSR (Grey) -->
                                            <Border Grid.Column="1" Background="#222834" Margin="1" CornerRadius="3">
                                                <TextBlock Text="MSR" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Windows NTFS (Violet) -->
                                            <Border Grid.Column="2" Background="{DynamicResource BrandVioletMutedBrush}" BorderBrush="{DynamicResource BrandVioletBrush}" BorderThickness="1" Margin="1" CornerRadius="3">
                                                <TextBlock Text="Windows NTFS (W:)" Foreground="{DynamicResource BrandVioletBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- WinRE (Neutral) -->
                                            <Border Grid.Column="3" Background="#2B3242" Margin="1" CornerRadius="3">
                                                <TextBlock Text="WinRE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Live Warning Chip under layout -->
                                <Border Background="{DynamicResource DangerRedBgBrush}" BorderBrush="{DynamicResource DangerRedBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2,0,0"
                                        Visibility="{Binding IsLiveMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="All data on this disk will be erased." Foreground="{DynamicResource DangerRedBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 6.3 Image Selection Card -->
                        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="IMAGE" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBlock Text="Windows 11 Pro 24H2 (x64)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" />
                                    <TextBlock Text="14.5 GB • Streamed from local repository" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Change" Foreground="{DynamicResource BrandVioletBrush}" Background="Transparent" BorderThickness="0" FontSize="11" Cursor="Hand" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 6.4 Drivers and Automation Card -->
                        <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="DRIVERS &amp; AUTOMATION" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />

                                <!-- Driver Match Row -->
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Profile.Model}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                                            <TextBlock Text="18 signed driver packages ready" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource SuccessGreenBgBrush}" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Matched" Foreground="{DynamicResource SuccessGreenBrush}" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Toggle Switches (Violet on, Grey off) -->
                                <CheckBox Style="{StaticResource ModernToggleSwitch}" Content="Skip Microsoft account sign-in" IsChecked="{Binding Config.SkipMicrosoftAccount}" IsEnabled="{Binding IsRunning, Converter={x:Null}}" Margin="0,4" />
                                <CheckBox Style="{StaticResource ModernToggleSwitch}" Content="Auto-logon (User)" IsChecked="{Binding Config.AutoLogonUser}" IsEnabled="{Binding IsRunning, Converter={x:Null}}" Margin="0,4" />
                                <CheckBox Style="{StaticResource ModernToggleSwitch}" Content="Launch Velox Bench after first boot" IsChecked="{Binding Config.LaunchVeloxBench}" IsEnabled="{Binding IsRunning, Converter={x:Null}}" Margin="0,4" />
                                <CheckBox Style="{StaticResource ModernToggleSwitch}" Content="Reboot automatically when done (15 s)" IsChecked="{Binding Config.AutoReboot}" IsEnabled="{Binding IsRunning, Converter={x:Null}}" Margin="0,4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- CENTER PIPELINE COLUMN -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- 7.1 Step Indicator Card (48px) -->
                        <RowDefinition Height="48" />
                        <!-- 7.2 Progress Card (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- 7.3 Preflight / Summary Card (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- 7.4 Deployment Log (*) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 7.1 STEP INDICATOR (Probe, Partition, Stream image, Drivers, Unattend, Ready) -->
                    <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,0,0,8">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Step 1: Probe -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource SuccessGreenBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="✓" Foreground="#000000" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="1. Probe" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                                    <TextBlock Text="Done" Foreground="{DynamicResource SuccessGreenBrush}" FontSize="10" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 2: Partition -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="DiskPartitioning">
                                                    <Setter Property="Background" Value="{DynamicResource InfoBlueBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBlueBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="WimStreaming">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="2" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="2. Partition" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Waiting" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 3: Stream image -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="WimStreaming">
                                                    <Setter Property="Background" Value="{DynamicResource InfoBlueBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBlueBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="3" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="3. Stream" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Waiting" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 4: Drivers -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                    <Setter Property="Background" Value="{DynamicResource InfoBlueBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBlueBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="4" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="4. Drivers" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Waiting" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 5: Unattend -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                    <Setter Property="Background" Value="{DynamicResource InfoBlueBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBlueBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="5" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="5. Unattend" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Waiting" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 6: Ready -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="6" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="6. Ready" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Waiting" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 7.2 PROGRESS CARD -->
                    <Border Grid.Row="1" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Hero Stats Row -->
                                <RowDefinition Height="*" />
                                <!-- 10px Progress Bar -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <!-- Percentage & Current Activity -->
                                    <ColumnDefinition Width="*" />
                                    <!-- 4 Stat Boxes (Throughput, Applied, Elapsed, Remaining) -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: 36px Percentage & Mode Chip -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F1}}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="36" FontWeight="Bold" />
                                        <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="3,0,0,5" VerticalAlignment="Bottom" />
                                        
                                        <!-- Mode Chip -->
                                        <Border CornerRadius="10" Padding="8,3" Margin="12,0,0,8" VerticalAlignment="Bottom">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource InfoBlueBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoBlueBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerRedBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerRedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Dry run, nothing is written" />
                                                        <Setter Property="Foreground" Value="{DynamicResource InfoBlueBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                                                <Setter Property="Text" Value="Live deployment" />
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerRedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Current Activity -->
                                    <TextBlock Text="{Binding CurrentActionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Right: 4 Stat Boxes -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Throughput -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="THROUGHPUT" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding SpeedMBps, StringFormat={}{0:F1}}" Foreground="{DynamicResource InfoBlueBrush}" FontSize="14" FontWeight="Bold" />
                                                <TextBlock Text=" MB/s" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Data Applied -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DATA APPLIED" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Bold" />
                                            <TextBlock Text="{Binding BytesText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Elapsed -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="ELAPSED" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Bold" />
                                            <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Remaining -->
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="REMAINING" Foreground="{DynamicResource TextMutedBrush}" FontSize="8" FontWeight="Bold" />
                                            <TextBlock Text="{Binding RemainingText}" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 10px Progress Bar -->
                            <Border Grid.Row="1" Height="8" Background="{DynamicResource BgCardBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,8,0,0">
                                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="8" Background="Transparent" BorderThickness="0" Margin="1">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Foreground" Value="{DynamicResource InfoBlueBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerRedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 7.3 PREFLIGHT CHECKS CARD (Ready state only) -->
                    <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                        <!-- Swapped to Complete Summary Card when completed -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessGreenBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <!-- Normal Preflight (when not completed) -->
                            <StackPanel Visibility="{Binding IsCompleted, Converter={x:Null}}">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="PREFLIGHT CHECKS" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource SuccessGreenBgBrush}" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding PreflightSummaryText}" Foreground="{DynamicResource SuccessGreenBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding PreflightChecks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✓" Foreground="{DynamicResource SuccessGreenBrush}" FontWeight="Bold" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Complete State Summary (when completed) -->
                            <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✓" Foreground="{DynamicResource SuccessGreenBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,10,0" />
                                        <TextBlock Text="Deployment complete" Foreground="{DynamicResource SuccessGreenBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text="• Windows 11 Pro 24H2 • 18 drivers injected • Velox Bench will start on first boot." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource SuccessGreenBgBrush}" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                                        <TextBlock Text="READY FOR QC" Foreground="{DynamicResource SuccessGreenBrush}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 7.4 DEPLOYMENT LOG (Filter, Copy, Save log, Monospace lines) -->
                    <Border Grid.Row="3" Background="{DynamicResource BgInsetBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Log Header & Filter Toolbar -->
                                <RowDefinition Height="Auto" />
                                <!-- Scrollable Log Items -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DEPLOYMENT LOG" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    
                                    <!-- Filter segmented control -->
                                    <RadioButton Content="All" IsChecked="True" GroupName="LogFilter" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <RadioButton Content="Warnings" GroupName="LogFilter" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <RadioButton Content="Errors" GroupName="LogFilter" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Copy" Command="{Binding CopyLogCommand}" Height="26" Padding="10,0" Margin="0,0,8,0" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" FontSize="11" Cursor="Hand" />
                                    <Button Content="Save log (Ctrl+S)" Command="{Binding SaveLogCommand}" Height="26" Padding="10,0" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" FontSize="11" Cursor="Hand" />
                                </StackPanel>
                            </Grid>

                            <!-- Log List Box -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLogs}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Source, StringFormat={}[{0}]}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource InfoBlueBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. BOTTOM ACTION BAR (58px) -->
            <Border Grid.Row="3" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <!-- Mode Switch & Helper Text -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="*" />
                        <!-- Action Buttons -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Mode Switch (36px) & Helper Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Two-Part Segmented Control (36px) -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Height="36" Padding="2" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Dry run" IsChecked="{Binding IsDryRunMode}" Height="30" Padding="12,0" GroupName="DeployModeGroup"
                                             IsEnabled="{Binding IsRunning, Converter={x:Null}}"
                                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                <RadioButton Content="Live, writes to disk" IsChecked="{Binding IsLiveMode}" Height="30" Padding="12,0" GroupName="DeployModeGroup"
                                             IsEnabled="{Binding IsRunning, Converter={x:Null}}"
                                             Background="Transparent" FontSize="12" FontWeight="SemiBold">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Mode Helper Text -->
                        <TextBlock Text="{Binding ModeHelperText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Secondary Action Button (Abort / Save log) -->
                        <Button Content="{Binding SecondaryButtonText}" Command="{Binding SecondaryActionCommand}" Height="36" Padding="14,0" Margin="0,0,10,0" 
                                Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource DangerRedBrush}" BorderBrush="{DynamicResource DangerRedBrush}" BorderThickness="1" Cursor="Hand"
                                Visibility="{Binding CanExecuteSecondaryAction, Converter={x:Null}}" />

                        <!-- Primary Action Button (Start dry run / Deploy to Disk 0... / Reboot now) -->
                        <Button Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryActionCommand}" Height="36" Padding="20,0" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <!-- Violet for Dry run & Normal actions -->
                                    <Setter Property="Background" Value="{DynamicResource BrandVioletBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Style.Triggers>
                                        <!-- Solid Red for Live deployment -->
                                        <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerRedButtonBrush}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 9. LIVE CONFIRMATION MODAL DIALOG (560px centered over dimmed backdrop) -->
        <Grid Background="#B0000000" Visibility="{Binding IsConfirmationDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="560" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource DangerRedBrush}" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header with Red Exclamation Circle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource DangerRedBgBrush}" BorderBrush="{DynamicResource DangerRedBrush}" BorderThickness="1.5" Margin="0,0,12,0">
                            <TextBlock Text="!" Foreground="{DynamicResource DangerRedBrush}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Erase Disk and deploy?" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="This action will replace the operating system on the target drive." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Summary Rows Card -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <TextBlock Text="Target Disk:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding SelectedDisk.DisplayText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Image Payload:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="Windows 11 Pro 24H2 (14.5 GB)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Depot Unit:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                    <Run Text="{Binding Profile.Model}" FontWeight="Bold" />
                                    <Run Text=" (SN: " />
                                    <Run Text="{Binding Profile.BiosSerial}" FontWeight="Bold" />
                                    <Run Text=")" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Permanent Erase Warning -->
                    <Border Background="{DynamicResource DangerRedBgBrush}" BorderBrush="{DynamicResource DangerRedBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                        <TextBlock Text="All partitions and data on this disk will be permanently erased. This cannot be undone." Foreground="{DynamicResource DangerRedBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <!-- Safety Check Confirmation Lines -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="✓" Foreground="{DynamicResource SuccessGreenBrush}" FontWeight="Bold" Margin="0,0,8,0" />
                            <TextBlock Text="Target disk is verified and is not the boot media." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="✓" Foreground="{DynamicResource SuccessGreenBrush}" FontWeight="Bold" Margin="0,0,8,0" />
                            <TextBlock Text="Image payload and 18 driver packages are verified." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Typed Confirmation Field ('Type ERASE to confirm') -->
                    <TextBlock Text="Type ERASE to confirm:" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ConfirmationInput, UpdateSourceTrigger=PropertyChanged}" Height="38" Background="{DynamicResource BgInsetBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" FontSize="14" FontFamily="Consolas, monospace" FontWeight="Bold" Padding="10,8" Margin="0,0,0,20" />

                    <!-- Dialog Action Buttons -->
                    <Grid>
                        <Button Content="Cancel" Command="{Binding CancelConfirmationCommand}" Width="100" Height="38" HorizontalAlignment="Left" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand" />
                        <Button Content="Erase and deploy" Command="{Binding ConfirmLiveDeployCommand}" Width="160" Height="38" HorizontalAlignment="Right" Background="{DynamicResource DangerRedButtonBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsEnabled="{Binding CanConfirmLive}" />
                    </Grid>
                </StackPanel>
            </Border>
