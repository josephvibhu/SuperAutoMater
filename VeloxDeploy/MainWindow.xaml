<Window x:Class="VeloxDeploy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VeloxDeploy.ViewModels"
        mc:Ignorable="d"
        Title="VeloxDeploy — Rapid OS Imaging &amp; Depot Provisioning Cockpit" 
        Height="840" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBgBrush}">

    <Window.DataContext>
        <vm:DeployViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header (54px) -->
            <RowDefinition Height="54" />
            <!-- Main Cockpit Body -->
            <RowDefinition Height="*" />
            <!-- Action Toolbar (64px) -->
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- TOP BAR (54px) -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <!-- Logo & Brand -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Machine Identity Chip -->
                    <ColumnDefinition Width="*" />
                    <!-- Status Chips & Options -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Official Velox Deploy Vector Mark & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="32" Height="28" Margin="0,0,10,0">
                        <Canvas Width="50" Height="44">
                            <!-- Main Velox V stroke in crisp white -->
                            <Path Data="M7 5L22 39L32 16" Stroke="#E8EAF0" StrokeThickness="9" StrokeLineJoin="Bevel" />
                            <!-- Electric Orange Accent stroke -->
                            <Path Data="M27 27.5L32 16" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="9" />
                            <!-- Electric Orange D for Deploy -->
                            <Path Data="M37.65 1.5V14.5 M37.65 1.5H42 C45.5 1.5 46.55 4.5 46.55 8 C46.55 11.5 45.5 14.5 42 14.5 H37.65" 
                                  Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="2.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="VELOX" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="DEPLOY" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="18" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BrandOrangeMutedBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0 BETA" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Center: Hardware Summary Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" CornerRadius="16" Padding="14,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DEPOT UNIT:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Profile.Manufacturer}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="{Binding Profile.Model}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" Margin="5,0,0,0" />
                            <TextBlock Text="•" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0" />
                            <TextBlock Text="SN:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding Profile.BiosSerial}" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Status Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ACPI OEM License Badge -->
                    <Border CornerRadius="14" Padding="10,4" Margin="0,0,10,0"
                            Background="{DynamicResource SurfacePanelBrush}"
                            BorderBrush="{Binding Profile.AcpiKey.HasKey, Converter={x:Null}}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                     Fill="{Binding Profile.AcpiKey.HasKey, Converter={x:Null}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF4B55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="NO OEM LICENSE" />
                                        <Setter Property="Foreground" Value="#FF4B55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Profile.AcpiKey.HasKey}" Value="True">
                                                <Setter Property="Text" Value="GENUINE OEM PRO" />
                                                <Setter Property="Foreground" Value="#00E599" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Cloud Status Chip -->
                    <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" CornerRadius="14" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#00E599" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CloudStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1" Margin="18,14">
            <Grid.ColumnDefinitions>
                <!-- Left Hardware & Configuration Column (320px) -->
                <ColumnDefinition Width="320" />
                <!-- Right Main HUD & Progress (Rest) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT CONFIGURATION COLUMN -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <!-- System Details Card -->
                    <RowDefinition Height="Auto" />
                    <!-- Storage Target Card -->
                    <RowDefinition Height="Auto" />
                    <!-- Driver & Unattend Card -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. System Details Card -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="HARDWARE IDENTIFICATION" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" />
                        
                        <Grid Margin="0,3">
                            <TextBlock Text="Processor" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Profile.CpuName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Cores / Threads" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                <Run Text="{Binding Profile.CpuCores}" FontWeight="Bold" />
                                <Run Text=" Cores (" />
                                <Run Text="{Binding Profile.CpuThreads}" FontWeight="Bold" />
                                <Run Text=" Threads)" />
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Memory (RAM)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                <Run Text="{Binding Profile.RamGb, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" GB" />
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Firmware Boot" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="UEFI 64-bit (Native)" Foreground="{DynamicResource StatusGreenBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="BIOS MSDM Key" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding Profile.AcpiKey.MaskedKey}" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Target Storage Disk Selector -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="TARGET STORAGE APPLIANCE" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="Rescan" Command="{Binding RefreshDisksCommand}" HorizontalAlignment="Right" FontSize="11" Padding="6,2" Background="Transparent" Foreground="{DynamicResource BrandOrangeBrush}" BorderThickness="0" Cursor="Hand" />
                        </Grid>

                        <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" DisplayMemberPath="DisplayText" Height="32" Margin="0,4,0,10" Background="{DynamicResource SurfacePanelBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" />

                        <!-- Disk Geometry Diagram -->
                        <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Standard Depot GPT Partition Layout:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,6" />
                                <Grid Height="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="18*" />
                                        <ColumnDefinition Width="4*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#1E3A5F" Margin="1" CornerRadius="2">
                                        <TextBlock Text="EFI (300M)" Foreground="#60A5FA" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="1" Background="#262626" Margin="1" CornerRadius="2">
                                        <TextBlock Text="MSR" Foreground="#A3A3A3" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource BrandOrangeMutedBrush}" Margin="1" CornerRadius="2">
                                        <TextBlock Text="Windows OS NTFS (W:\)" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="3" Background="#3B2A1E" Margin="1" CornerRadius="2">
                                        <TextBlock Text="WinRE" Foreground="#FDBA74" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. DriverVault & Staging Configuration -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="DRIVERVAULT &amp; AUTOMATION" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" />

                        <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Hardware Driver Match" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                <TextBlock Foreground="{DynamicResource StatusGreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0">
                                    <Run Text="✓ " />
                                    <Run Text="{Binding Profile.Manufacturer}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Profile.Model}" />
                                </TextBlock>
                                <TextBlock Text="18 signed INF driver packages ready" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Panther OOBE Automation" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                <TextBlock Text="✓ Microsoft Account Login Bypassed" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                <TextBlock Text="✓ Auto-Logon Enabled (User)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,1,0,0" />
                                <TextBlock Text="✓ VeloxBench Auto-Launch Hooked" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>

                        <CheckBox IsChecked="{Binding AutoReboot}" Content="Auto-Reboot on Complete (15s)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT COCKPIT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Pipeline Step Indicator (48px) -->
                    <RowDefinition Height="52" />
                    <!-- Hero Telemetry Box (160px) -->
                    <RowDefinition Height="165" />
                    <!-- Monospace Console Terminal (*) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Pipeline Stepper -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,12">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Step 1: Probe -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="18" Height="18" Fill="{DynamicResource BrandOrangeBrush}" Margin="0,0,6,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource BrandOrangeColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="1. PROBE" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Step 2: Partition -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="18" Height="18" Margin="0,0,6,0"
                                     Fill="{Binding ProgressPercent, Converter={x:Null}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#2A2F3D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="DiskPartitioning">
                                                <Setter Property="Fill" Value="{DynamicResource BrandOrangeBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="WimStreaming">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="2. PARTITION" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Step 3: Stream -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#2A2F3D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="WimStreaming">
                                                <Setter Property="Fill" Value="{DynamicResource BrandOrangeBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="3. STREAM WIM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Step 4: DriverVault -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#2A2F3D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="DriverInjection">
                                                <Setter Property="Fill" Value="{DynamicResource BrandOrangeBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="4. DRIVERS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Step 5: Unattend -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#2A2F3D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="UnattendProvisioning">
                                                <Setter Property="Fill" Value="{DynamicResource BrandOrangeBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="BootloaderConfig">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="5. UNATTEND" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Step 6: Ready -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#2A2F3D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStage}" Value="Completed">
                                                <Setter Property="Fill" Value="#00E599" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="6. READY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Hero Telemetry Box -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Top metrics row -->
                            <RowDefinition Height="Auto" />
                            <!-- Big Progress Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- Action and Timers -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Large Metrics -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Big Percentage -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F1}}" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="38" FontWeight="Bold" VerticalAlignment="Bottom" />
                                <TextBlock Text="%" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,4" VerticalAlignment="Bottom" />
                            </StackPanel>

                            <!-- Center Status Action -->
                            <TextBlock Grid.Column="1" Text="{Binding CurrentActionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0,0,0" TextTrimming="CharacterEllipsis" />

                            <!-- Write Speed Gauge -->
                            <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,14,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="THROUGHPUT" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SpeedMBps, StringFormat={}{0:F1}}" Foreground="{DynamicResource StatusGreenBrush}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text=" MB/s" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Processed Data -->
                            <Border Grid.Column="3" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="DATA APPLIED" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding BytesText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 1: High-Tech Progress Bar -->
                        <Border Grid.Row="1" Height="14" Background="{DynamicResource SurfacePanelBrush}" CornerRadius="7" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="12" Foreground="{DynamicResource BrandOrangeBrush}" Background="Transparent" BorderThickness="0" Margin="1" />
                        </Border>

                        <!-- Row 2: Timers & Stats -->
                        <Grid Grid.Row="2" Margin="4,10,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Elapsed: " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ElapsedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="  •  Estimated Remaining: " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding RemainingText}" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Mode: " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                <TextBlock Text="SIMULATION (DRY-RUN)" Foreground="{DynamicResource StatusYellowBrush}" FontSize="11" FontWeight="Bold" Visibility="{Binding IsDryRun, Converter={x:Null}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. Monospace Console Terminal -->
                <Border Grid.Row="2" Background="#07080B" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Terminal Title Bar -->
                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#FF4B55" Margin="0,0,6,0" />
                                <Ellipse Width="9" Height="9" Fill="#FFB800" Margin="0,0,6,0" />
                                <Ellipse Width="9" Height="9" Fill="#00E599" Margin="0,0,8,0" />
                                <TextBlock Text="PROVISIONING HUD TERMINAL — WINPE SUBSYSTEM" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="LIVE BUFFER" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Monospace Console Log TextBox -->
                        <TextBox x:Name="ConsoleLogBox" Grid.Row="1" Text="{Binding ConsoleOutput, Mode=OneWay}" 
                                 FontFamily="Consolas, Segoe UI Mono, Courier New" FontSize="11" 
                                 Foreground="#E2E8F0" Background="Transparent" 
                                 BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 TextChanged="ConsoleLogBox_TextChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ACTION TOOLBAR (64px) -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <!-- Mode switch & options -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- Action buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Mode Selection -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton IsChecked="{Binding IsDryRun}" Content="Dry-Run Simulation Mode (Safe Demo)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0" IsEnabled="{Binding IsRunning, Converter={x:Null}}" />
                    <RadioButton IsChecked="{Binding IsDryRun, Converter={x:Null}}" Content="Armed Live Target Mode (Real Disk Write)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" IsEnabled="{Binding IsRunning, Converter={x:Null}}" />
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Abort Button (when running) -->
                    <Button Content="Abort Pipeline" Command="{Binding AbortCommand}" Height="38" Padding="16,0" Margin="0,0,12,0" Background="#331416" Foreground="{DynamicResource StatusRedBrush}" BorderBrush="{DynamicResource StatusRedBrush}" BorderThickness="1" Cursor="Hand" Visibility="{Binding IsRunning, Converter={x:Null}}" />

                    <!-- Dry-Run Simulation Button -->
                    <Button Content="Simulate Deployment (Dry-Run)" Command="{Binding SimulateDeployCommand}" Height="38" Padding="18,0" Margin="0,0,12,0" Background="{DynamicResource SurfacePanelBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1" Cursor="Hand" IsEnabled="{Binding IsRunning, Converter={x:Null}}" />

                    <!-- Live Armed Deploy Button -->
                    <Button Content="⚡ START LIVE DEPLOYMENT" Command="{Binding StartDeployCommand}" Height="38" Padding="22,0" Background="{DynamicResource BrandOrangeBrush}" Foreground="#0A0B0E" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsEnabled="{Binding IsRunning, Converter={x:Null}}">
                        <Button.Effect>
                            <DropShadowEffect Color="{DynamicResource BrandOrangeColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
