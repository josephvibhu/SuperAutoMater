<Window x:Class="VeloxBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:VeloxBench.Converters"
        mc:Ignorable="d"
        Title="VeloxBench — Precision Diagnostic &amp; Refurbishment Engine" 
        Height="880" Width="1280"
        MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C10"
        Foreground="#F0F6FC"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />

        <!-- Card Style -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <!-- Dark Button Style with Rounded Corners -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CaretBrush" Value="#58A6FF" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#F0F6FC" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Connectivity -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Scrollable Content -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Status & Control Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── HEADER BAR ───────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="22" Foreground="#58A6FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VELOX" FontWeight="Bold" FontSize="18" Foreground="#58A6FF" />
                            <TextBlock Text="BENCH" FontWeight="Light" FontSize="18" Foreground="#F0F6FC" Margin="6,0,0,0" />
                            <Border Background="#21262D" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0 PROD" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Hardware Refurbishment &amp; Express QC Diagnostic Engine" FontSize="11" Foreground="#8B949E" />
                    </StackPanel>
                </StackPanel>

                <!-- Real-Time Hybrid Connectivity Banner -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#0D1117" 
                        BorderBrush="{Binding SyncBannerColor, Converter={StaticResource HexBrush}}"
                        BorderThickness="1" CornerRadius="20" Padding="16,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                 Fill="{Binding SyncBannerColor, Converter={StaticResource HexBrush}}" />
                        <TextBlock Text="{Binding SyncBanner}" FontWeight="Bold" FontSize="12"
                                   Foreground="{Binding SyncBannerColor, Converter={StaticResource HexBrush}}" />
                    </StackPanel>
                </Border>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshHardwareCommand}" Margin="0,0,8,0"
                            Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                            Padding="12,6" FontWeight="SemiBold" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                            <TextBlock Text="Probe Hardware" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding GeneratePdfCommand}"
                            Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043" BorderThickness="1"
                            Padding="14,6" FontWeight="Bold" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,6,0" />
                            <TextBlock Text="Print Certificate" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── MAIN CONTENT (SCROLLABLE) ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
            <StackPanel>

                <!-- 1. IDENTIFICATION & WAREHOUSE INTAKE SECTION -->
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top row: Barcode / Asset Tag Scan Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="ASSET TAG / BARCODE SCAN (Auto-Fill &amp; Live Sync)" FontSize="11" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AssetTag, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="15" FontWeight="Bold" Foreground="#3FB950"
                                         Padding="10,6" Background="#0D1117" BorderBrush="#58A6FF" BorderThickness="1.5" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="SERIAL NUMBER" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                    <TextBlock Text="{Binding Serial}" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="MODEL / CHASSIS" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="12" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="BIOS / OEM" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                    <TextBlock Text="{Binding BiosVersion}" FontSize="12" Foreground="#8B949E" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Separator Grid.Row="1" Background="#30363D" Margin="0,0,0,12" />

                        <!-- Operations Attribution (Auto-pushed on change) -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="ASSIGNED TECHNICIAN" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AssignedTechnician, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="SUPPLIER / SOURCE" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="CUSTOMER / DESTINATION" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="COSMETIC GRADE" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <ComboBox Text="{Binding Grade, UpdateSourceTrigger=PropertyChanged}" IsEditable="True">
                                    <ComboBoxItem Content="GRADE A" />
                                    <ComboBoxItem Content="GRADE B" />
                                    <ComboBoxItem Content="GRADE C" />
                                    <ComboBoxItem Content="GRADE PENDING" />
                                    <ComboBoxItem Content="SALVAGE / SCRAP" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="MISSING COMPONENTS / DEFECT NOTES" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MissingComponents, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. HARDWARE TELEMETRY DECK (5 CARDS) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⚡" Foreground="#58A6FF" Margin="0,0,4,0" />
                                <TextBlock Text="PROCESSOR" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                            </StackPanel>
                            <TextBlock Text="{Binding CpuName}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding CpuClockSummary}" FontSize="11" Foreground="#58A6FF" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Load: " FontSize="10" Foreground="#8B949E" />
                                <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,8,0" />
                                <TextBlock Text="Temp: " FontSize="10" Foreground="#8B949E" />
                                <TextBlock Text="{Binding CpuTempC, StringFormat='{}{0}°C'}" FontSize="10" FontWeight="Bold" Foreground="#D29922" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- RAM -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🧠" Foreground="#3FB950" Margin="0,0,4,0" />
                                <TextBlock Text="MEMORY" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                            </StackPanel>
                            <TextBlock Text="{Binding RamSummary}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <Border Background="#21262D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,2,0,0">
                                <TextBlock Text="{Binding RamHealthBadge}" FontSize="10" FontWeight="Bold" Foreground="#3FB950" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- STORAGE -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="💾" Foreground="#A371F7" Margin="0,0,4,0" />
                                <TextBlock Text="STORAGE &amp; S.M.A.R.T." FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                            </StackPanel>
                            <TextBlock Text="{Binding StorageSummary}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SMART Health: " FontSize="10" Foreground="#8B949E" />
                                <TextBlock Text="{Binding StorageHealthPercent, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="#3FB950" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- BATTERY -->
                    <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🔋" Foreground="#D29922" Margin="0,0,4,0" />
                                <TextBlock Text="BATTERY &amp; POWER" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                            </StackPanel>
                            <TextBlock Text="{Binding BatterySummary}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Cycle/Health: " FontSize="10" Foreground="#8B949E" />
                                <TextBlock Text="{Binding BatteryHealthPercent, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- GPU & NETWORK -->
                    <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🎮" Foreground="#F778BA" Margin="0,0,4,0" />
                                <TextBlock Text="GPU &amp; NETWORK" FontSize="10" FontWeight="Bold" Foreground="#8B949E" />
                            </StackPanel>
                            <TextBlock Text="{Binding GpuSummary}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding WifiSsid, StringFormat='Wi-Fi: {0}'}" FontSize="10" Foreground="#8B949E" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. AUTOMATED 8-STAGE EXPRESS QC RUNNER & SUBSYSTEM TILES -->
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <!-- Section Header & Start QC Button -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AUTOMATED 8-STAGE HARDWARE DIAGNOSTIC SUITE" FontSize="12" FontWeight="Bold" Foreground="#F0F6FC" />
                                <TextBlock Text="Rapid hardware testing: Audio FFT loopback, Camera DirectShow, Storage SMART, Memory bit-flip assessment, Battery degradation, Display VSync jitter."
                                           FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding RunQcCommand}"
                                    IsEnabled="{Binding IsQcRunning, Converter={StaticResource InverseBool}}"
                                    Background="#1F6FEB" Foreground="#FFFFFF" BorderBrush="#388BFD" BorderThickness="1"
                                    Padding="18,8" FontWeight="Bold" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,6,0" />
                                    <TextBlock Text="RUN FULL EXPRESS QC" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Overall QC Banner -->
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="QC OVERALL STATE:" FontWeight="SemiBold" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding QcOverallStatus}" FontWeight="Bold" FontSize="13" Foreground="#58A6FF" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Subsystems Card Grid -->
                        <ItemsControl ItemsSource="{Binding Subsystems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D1117" 
                                            BorderBrush="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                                            BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Subsystem Title & Status Badge -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Grid.Column="1" 
                                                        Background="{Binding AccentHex, Converter={StaticResource HexBrush}}" 
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF" />
                                                </Border>
                                            </Grid>

                                            <!-- Metric Value -->
                                            <TextBlock Grid.Row="1" Text="{Binding MetricValue}" FontWeight="Bold" FontSize="14" 
                                                       Foreground="{Binding AccentHex, Converter={StaticResource HexBrush}}" Margin="0,0,0,4" />

                                            <!-- Headline & Detail -->
                                            <StackPanel Grid.Row="2" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Headline}" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Optional Snapshot Image (e.g. Webcam) -->
                                            <Border Grid.Row="3" Visibility="{Binding SnapshotImage, Converter={StaticResource NullVis}}"
                                                    BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0" MaxHeight="80">
                                                <Image Source="{Binding SnapshotImage}" Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── FOOTER STATUS BAR ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Depot Platform: " FontSize="11" Foreground="#8B949E" />
                    <TextBlock Text="Velox Cloud (Railway) + Local WAL Cache" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,16,0" />
                    <TextBlock Text="Automatic Sync: " FontSize="11" Foreground="#8B949E" />
                    <TextBlock Text="Active (Zero-Click Updates)" FontSize="11" FontWeight="SemiBold" Foreground="#3FB950" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VeloxBench 1.0.0 — Velox Depot Operations" FontSize="10" Foreground="#8B949E" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
