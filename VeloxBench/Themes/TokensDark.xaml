<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================== -->
    <!-- VELOX SUITE DARK THEME DESIGN TOKENS (Developer UI Handoff)    -->
    <!-- ============================================================== -->

    <!-- Surfaces -->
    <Color x:Key="ColorBgApp">#0F1115</Color>
    <Color x:Key="ColorBgPanel">#161922</Color>
    <Color x:Key="ColorBgCard">#1D212C</Color>
    <Color x:Key="ColorBgHover">#262B38</Color>
    <Color x:Key="ColorBgInset">#0B0D11</Color>

    <Color x:Key="ColorBorderSubtle">#2A2F3C</Color>
    <Color x:Key="ColorBorderStrong">#3B4152</Color>

    <!-- Typography -->
    <Color x:Key="ColorTextPrimary">#E8EAF0</Color>
    <Color x:Key="ColorTextSecondary">#A4ABBA</Color>
    <Color x:Key="ColorTextMuted">#8A92A3</Color>

    <!-- Brand & Selection -->
    <Color x:Key="ColorBrand">#9279FF</Color>
    <Color x:Key="ColorBrandSolid">#6F4FF2</Color>
    <Color x:Key="ColorBrandSubtle">#241D3F</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="ColorSuccess">#3DD68C</Color>
    <Color x:Key="ColorSuccessBg">#1A3D2A</Color>
    <Color x:Key="ColorSuccessBorder">#2D7A4F</Color>
    <Color x:Key="ColorSuccessSolid">#1B8A5A</Color>

    <Color x:Key="ColorWarning">#F5B94A</Color>
    <Color x:Key="ColorWarningBg">#3B2B11</Color>
    <Color x:Key="ColorWarningBorder">#805D1E</Color>

    <Color x:Key="ColorDanger">#FF6B6B</Color>
    <Color x:Key="ColorDangerBg">#3D1A1A</Color>
    <Color x:Key="ColorDangerBorder">#8A2E2E</Color>

    <Color x:Key="ColorInfo">#4DA3FF</Color>
    <Color x:Key="ColorInfoBg">#14253D</Color>
    <Color x:Key="ColorInfoBorder">#265994</Color>

    <!-- Grade Ramp -->
    <Color x:Key="ColorGradeAPlus">#3DD68C</Color>
    <Color x:Key="ColorGradeA">#5FD3B0</Color>
    <Color x:Key="ColorGradeB">#F5B94A</Color>
    <Color x:Key="ColorGradeC">#FF9A4D</Color>

    <!-- App Identity Colors -->
    <Color x:Key="ColorAppBench">#19B5D8</Color>
    <Color x:Key="ColorAppManager">#8B6CFF</Color>
    <Color x:Key="ColorAppHub">#E04FA8</Color>
    <Color x:Key="ColorAppLink">#4F7CFF</Color>
    <Color x:Key="ColorAppFleet">#F2A93B</Color>

    <!-- ============================================================== -->
    <!-- SEMANTIC SOLID BRUSHES                                         -->
    <!-- ============================================================== -->
    <SolidColorBrush x:Key="TokenBgAppBrush" Color="{StaticResource ColorBgApp}"/>
    <SolidColorBrush x:Key="TokenBgPanelBrush" Color="{StaticResource ColorBgPanel}"/>
    <SolidColorBrush x:Key="TokenBgCardBrush" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="TokenBgHoverBrush" Color="{StaticResource ColorBgHover}"/>
    <SolidColorBrush x:Key="TokenBgInsetBrush" Color="{StaticResource ColorBgInset}"/>

    <SolidColorBrush x:Key="TokenBorderSubtleBrush" Color="{StaticResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="TokenBorderStrongBrush" Color="{StaticResource ColorBorderStrong}"/>

    <SolidColorBrush x:Key="TokenTextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TokenTextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TokenTextMutedBrush" Color="{StaticResource ColorTextMuted}"/>

    <SolidColorBrush x:Key="TokenBrandBrush" Color="{StaticResource ColorBrand}"/>
    <SolidColorBrush x:Key="TokenBrandSolidBrush" Color="{StaticResource ColorBrandSolid}"/>
    <SolidColorBrush x:Key="TokenBrandSubtleBrush" Color="{StaticResource ColorBrandSubtle}"/>

    <SolidColorBrush x:Key="TokenSuccessBrush" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="TokenSuccessBgBrush" Color="{StaticResource ColorSuccessBg}"/>
    <SolidColorBrush x:Key="TokenSuccessBorderBrush" Color="{StaticResource ColorSuccessBorder}"/>
    <SolidColorBrush x:Key="TokenSuccessSolidBrush" Color="{StaticResource ColorSuccessSolid}"/>

    <SolidColorBrush x:Key="TokenWarningBrush" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="TokenWarningBgBrush" Color="{StaticResource ColorWarningBg}"/>
    <SolidColorBrush x:Key="TokenWarningBorderBrush" Color="{StaticResource ColorWarningBorder}"/>

    <SolidColorBrush x:Key="TokenDangerBrush" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="TokenDangerBgBrush" Color="{StaticResource ColorDangerBg}"/>
    <SolidColorBrush x:Key="TokenDangerBorderBrush" Color="{StaticResource ColorDangerBorder}"/>

    <SolidColorBrush x:Key="TokenInfoBrush" Color="{StaticResource ColorInfo}"/>
    <SolidColorBrush x:Key="TokenInfoBgBrush" Color="{StaticResource ColorInfoBg}"/>
    <SolidColorBrush x:Key="TokenInfoBorderBrush" Color="{StaticResource ColorInfoBorder}"/>

    <SolidColorBrush x:Key="TokenGradeAPlusBrush" Color="{StaticResource ColorGradeAPlus}"/>
    <SolidColorBrush x:Key="TokenGradeABrush" Color="{StaticResource ColorGradeA}"/>
    <SolidColorBrush x:Key="TokenGradeBBrush" Color="{StaticResource ColorGradeB}"/>
    <SolidColorBrush x:Key="TokenGradeCBrush" Color="{StaticResource ColorGradeC}"/>

    <SolidColorBrush x:Key="TokenAppColorBrush" Color="{StaticResource ColorAppBench}"/>

    <!-- ============================================================== -->
    <!-- COMPATIBILITY BRUSHES (DARK THEME)                             -->
    <!-- ============================================================== -->
    <SolidColorBrush x:Key="BrushObsidianVoid" Color="#0F1115"/>
    <SolidColorBrush x:Key="BrushObsidianMid" Color="#161922"/>
    <SolidColorBrush x:Key="BrushObsidianTop" Color="#1D212C"/>

    <SolidColorBrush x:Key="BrushCardBgTop" Color="#1D212C"/>
    <SolidColorBrush x:Key="BrushCardBgBottom" Color="#161922"/>
    <SolidColorBrush x:Key="BrushActiveCardTop" Color="#262B38"/>
    <SolidColorBrush x:Key="BrushActiveCardBottom" Color="#1D212C"/>

    <!-- High-Contrast Text (Light for Dark Background) -->
    <SolidColorBrush x:Key="BrushTextWhite" Color="#E8EAF0"/>
    <SolidColorBrush x:Key="BrushTextVioletLight" Color="#A4ABBA"/>
    <SolidColorBrush x:Key="BrushTextVioletMuted" Color="#8A92A3"/>
    <SolidColorBrush x:Key="BrushTextVioletSubdued" Color="#8A92A3"/>
    <SolidColorBrush x:Key="BrushTextEmerald" Color="#3DD68C"/>
    <SolidColorBrush x:Key="BrushTextAmber" Color="#F5B94A"/>
    <SolidColorBrush x:Key="BrushTextRed" Color="#FF6B6B"/>

    <!-- Hairline Borders -->
    <SolidColorBrush x:Key="BrushHairlineViolet" Color="#2A2F3C"/>
    <SolidColorBrush x:Key="BrushHairlineDark" Color="#3B4152"/>
    <SolidColorBrush x:Key="BrushHairlineActive" Color="#9279FF"/>
    <SolidColorBrush x:Key="BrushHairlineSubtle" Color="#2A2F3C"/>
    <SolidColorBrush x:Key="BrushHairlineEmerald" Color="#2D7A4F"/>

    <!-- Functional Accents -->
    <SolidColorBrush x:Key="BrushAccentEmerald" Color="#3DD68C"/>
    <SolidColorBrush x:Key="BrushAccentEmeraldLight" Color="#3DD68C"/>
    <SolidColorBrush x:Key="BrushAccentAmber" Color="#F5B94A"/>
    <SolidColorBrush x:Key="BrushAccentRed" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="BrushAccentBlue" Color="#4DA3FF"/>
    <SolidColorBrush x:Key="BrushAccentViolet" Color="#9279FF"/>
    <SolidColorBrush x:Key="BrushAccentVioletLight" Color="#9279FF"/>
    <SolidColorBrush x:Key="BrushLogoPurple" Color="#19B5D8"/>
    <SolidColorBrush x:Key="BrushLogoPurpleLight" Color="#19B5D8"/>

    <!-- Gradient Backgrounds (Dark Graphite) -->
    <RadialGradientBrush x:Key="BrushObsidianRadial" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#161922" Offset="0.0"/>
        <GradientStop Color="#1D212C" Offset="0.5"/>
        <GradientStop Color="#0F1115" Offset="1.0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushCardVioletGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1D212C" Offset="0.0"/>
        <GradientStop Color="#161922" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushActiveCardViolet" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#262B38" Offset="0.0"/>
        <GradientStop Color="#1D212C" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushTopBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#161922" Offset="0.0"/>
        <GradientStop Color="#1D212C" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPrimaryGlowButton" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6F4FF2" Offset="0.0"/>
        <GradientStop Color="#9279FF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPassQcButton" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1B8A5A" Offset="0.0"/>
        <GradientStop Color="#3DD68C" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
