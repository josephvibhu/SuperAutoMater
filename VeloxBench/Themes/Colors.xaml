<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- Default Dark Palette (Swapped dynamically by ThemeService) -->
        <ResourceDictionary Source="TokensDark.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Semantic Status & Surface Aliases (Forwarding to active tokens) -->
    <SolidColorBrush x:Key="BrushObsidianVoid" Color="{DynamicResource ColorBgApp}"/>
    <SolidColorBrush x:Key="BrushObsidianMid" Color="{DynamicResource ColorBgPanel}"/>
    <SolidColorBrush x:Key="BrushObsidianTop" Color="{DynamicResource ColorBgCard}"/>

    <SolidColorBrush x:Key="BrushCardBgTop" Color="{DynamicResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BrushCardBgBottom" Color="{DynamicResource ColorBgPanel}"/>
    <SolidColorBrush x:Key="BrushActiveCardTop" Color="{DynamicResource ColorBgHover}"/>
    <SolidColorBrush x:Key="BrushActiveCardBottom" Color="{DynamicResource ColorBgCard}"/>

    <!-- Logo & Accent Aliases (Cyan for Bench, Violet for Suite) -->
    <SolidColorBrush x:Key="BrushLogoPurple" Color="{DynamicResource ColorAppBench}"/>
    <SolidColorBrush x:Key="BrushLogoPurpleLight" Color="{DynamicResource ColorAppBench}"/>
    <SolidColorBrush x:Key="BrushAccentViolet" Color="{DynamicResource ColorBrand}"/>
    <SolidColorBrush x:Key="BrushAccentVioletLight" Color="{DynamicResource ColorBrand}"/>

    <!-- Functional Status Brushes -->
    <SolidColorBrush x:Key="BrushAccentEmerald" Color="{DynamicResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushAccentEmeraldLight" Color="{DynamicResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{DynamicResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushAccentRed" Color="{DynamicResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushAccentBlue" Color="{DynamicResource ColorInfo}"/>

    <!-- Hairline Borders -->
    <SolidColorBrush x:Key="BrushHairlineViolet" Color="{DynamicResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="BrushHairlineDark" Color="{DynamicResource ColorBorderStrong}"/>
    <SolidColorBrush x:Key="BrushHairlineActive" Color="{DynamicResource ColorBrand}"/>
    <SolidColorBrush x:Key="BrushHairlineSubtle" Color="{DynamicResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="BrushHairlineEmerald" Color="{DynamicResource ColorSuccessBorder}"/>

    <!-- High-Contrast Readable Text Brushes -->
    <SolidColorBrush x:Key="BrushTextWhite" Color="{DynamicResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextVioletLight" Color="{DynamicResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextVioletMuted" Color="{DynamicResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextVioletSubdued" Color="{DynamicResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextEmerald" Color="{DynamicResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushTextAmber" Color="{DynamicResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushTextRed" Color="{DynamicResource ColorDanger}"/>

    <!-- Gradient Backgrounds -->
    <RadialGradientBrush x:Key="BrushObsidianRadial" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="{DynamicResource ColorBgPanel}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource ColorBgCard}" Offset="0.5"/>
        <GradientStop Color="{DynamicResource ColorBgApp}" Offset="1.0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushCardVioletGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource ColorBgCard}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource ColorBgPanel}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushActiveCardViolet" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource ColorBgHover}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource ColorBgCard}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushTopBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource ColorBgPanel}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource ColorBgCard}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPrimaryGlowButton" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource ColorBrandSolid}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource ColorBrand}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPassQcButton" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource ColorSuccessSolid}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource ColorSuccess}" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
