<Window x:Class="SuperAutoMater.Wpf.Views.BatteryCalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMS Battery Recalibration &amp; Controlled Drain Protocol"
        Height="620" Width="920"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0E1116"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Cockpit Split -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Top Avionics Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🔋 " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="BMS BATTERY RECALIBRATION &amp; CONTROLLED DRAIN PROTOCOL" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,3">
                    <TextBlock x:Name="TxtHeaderBadge" Text="GAS-GAUGE CONDITIONING" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#58A6FF" FontWeight="Bold"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- 2. Main 2-Column Avionics Cockpit -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/> <!-- Left: Drain Radar & Controls -->
                <ColumnDefinition Width="1.25*"/> <!-- Right: Guided 4-Phase Protocol -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Live Battery Drain Telemetry & Load Controller -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#262C36" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- AC Power Connection State Banner -->
                    <Border Grid.Row="0" x:Name="BorderAcStatus" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtAcIcon" Text="⚡ " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAcStatus" Text="DISCHARGING ON BATTERY" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#3FB950" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Primary SOC Gauge & Big Percent -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,10">
                        <TextBlock Text="STATE OF CHARGE (SOC)" Style="{StaticResource TextBadgeMono}" Foreground="{StaticResource BrushTextVioletSubdued}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtSocPercent" Text="78%" FontFamily="{StaticResource FontSans}" FontWeight="ExtraBold" FontSize="44" Foreground="{StaticResource BrushTextWhite}" HorizontalAlignment="Center" Margin="0,2,0,4"/>
                        <ProgressBar x:Name="ProgBarSoc" Height="10" Width="260" Minimum="0" Maximum="100" Value="78" Foreground="#3FB950" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"/>
                        <TextBlock x:Name="TxtTargetNotice" Text="Target Floor: 6% Cutoff" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushTextVioletSubdued}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Live Discharge Telemetry 2x2 Bento Matrix -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Voltage -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,3,3">
                            <StackPanel>
                                <TextBlock Text="TOTAL VOLTAGE" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextVioletSubdued}"/>
                                <TextBlock x:Name="TxtPackVoltage" Text="11.85 V" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextWhite}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Per-Cell Voltage -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,0,0,3">
                            <StackPanel>
                                <TextBlock Text="CELL VOLTAGE (AVG)" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextVioletSubdued}"/>
                                <TextBlock x:Name="TxtCellVoltage" Text="3.95 V / Cell" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="13" Foreground="#58A6FF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Drain Rate -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,3,3,0">
                            <StackPanel>
                                <TextBlock Text="DRAIN FLOW RATE" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextVioletSubdued}"/>
                                <TextBlock x:Name="TxtDrainWatts" Text="22.5 W" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="13" Foreground="#D29922" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Estimated Time -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,3,0,0">
                            <StackPanel>
                                <TextBlock Text="EST. TIME TO TARGET" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextVioletSubdued}"/>
                                <TextBlock x:Name="TxtTimeRemaining" Text="~34 Mins" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="13" Foreground="#3FB950" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Drain Target & Load Configuration -->
                    <Border Grid.Row="3" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="TARGET CUTOFF:" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextVioletSubdued}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbTargetCutoff" SelectionChanged="CmbTargetCutoff_SelectionChanged">
                                        <ComboBoxItem Content="5% (Deepest Flush)"/>
                                        <ComboBoxItem Content="6% (Recommended)"/>
                                        <ComboBoxItem Content="7% (Conservative)"/>
                                        <ComboBoxItem Content="8% (Quick Safe)"/>
                                        <ComboBoxItem Content="10% (Top End)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="LOAD INTENSITY:" Style="{StaticResource TextBadgeMono}" FontSize="9" Foreground="{StaticResource BrushTextVioletSubdued}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbIntensity" SelectionChanged="CmbIntensity_SelectionChanged">
                                        <ComboBoxItem Content="Standard (~22W)"/>
                                        <ComboBoxItem Content="Aggressive (~38W)"/>
                                        <ComboBoxItem Content="Light (~10W Idle)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="🛡 Sleep prevention active: Display stays awake automatically." FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#8B949E"/>
                        </StackPanel>
                    </Border>

                    <!-- Controlled Drain Start / Stop Toggle Button -->
                    <Button Grid.Row="4" x:Name="BtnToggleDrain" Content="▶ START CONTROLLED DRAIN" Style="{StaticResource StyleWarningActionBtn}" Click="BtnToggleDrain_Click" Padding="10,8" FontSize="11" FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Guided 4-Phase Protocol & SOP Manual -->
            <Border Grid.Column="1" Background="#161B22" BorderBrush="#262C36" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="📋 GUIDED RECALIBRATION PROTOCOL" Style="{StaticResource TextCardHeader}" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="TxtCurrentPhaseBadge" Text="PHASE 1 ACTIVE" Style="{StaticResource TextBadgeMono}" Foreground="#58A6FF" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>

                    <!-- 4 Interactive Protocol Step Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- STEP 1 -->
                            <Border x:Name="CardPhase1" Background="#0D1117" BorderBrush="#388BFD" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="1. CONTROLLED DEEP DRAIN" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="#58A6FF"/>
                                        <Border DockPanel.Dock="Right" Background="#21262D" CornerRadius="4" Padding="5,1">
                                            <TextBlock x:Name="TxtPhase1Tag" Text="CURRENT" Style="{StaticResource TextBadgeMono}" Foreground="#58A6FF" FontWeight="Bold" FontSize="9"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Unplug the AC adapter. Run controlled discharge under steady load until the 6% threshold is hit. An acoustic alarm will sound at 6% to prevent brownout shutoff." FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- STEP 2 -->
                            <Border x:Name="CardPhase2" Background="#0D1117" BorderBrush="#262C36" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="2. CHEMICAL &amp; THERMAL EQUILIBRIUM" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextWhite}"/>
                                        <Button x:Name="BtnStartRestTimer" DockPanel.Dock="Right" Content="⏱ START 30M REST" Style="{StaticResource StyleDarkActionBtn}" Click="BtnStartRestTimer_Click" Padding="6,2" FontSize="9"/>
                                    </DockPanel>
                                    <TextBlock Text="Rest unit for 30–60 minutes. Allows lithium-ion electrode concentration gradients to normalize and cell temperatures to cool to 25°C ambient before recharging." FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtRestTimerDisplay" Text="Rest Timer: 30m 00s remaining" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="#D29922" Margin="0,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- STEP 3 -->
                            <Border x:Name="CardPhase3" Background="#0D1117" BorderBrush="#262C36" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="3. UNINTERRUPTED 100% CHARGE" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextWhite}"/>
                                        <Button x:Name="BtnSetPhase3" DockPanel.Dock="Right" Content="🔌 MARK CHARGING" Style="{StaticResource StyleDarkActionBtn}" Click="BtnSetPhase3_Click" Padding="6,2" FontSize="9"/>
                                    </DockPanel>
                                    <TextBlock Text="Connect OEM AC adapter. Charge continuously to 100% without disconnecting. Keep plugged in for 2 extra hours so the BMS fuel-gauge registers current taper and learns true Qmax." FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- STEP 4 -->
                            <Border x:Name="CardPhase4" Background="#0D1117" BorderBrush="#262C36" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="4. BMS GAS-GAUGE VERIFICATION" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextWhite}"/>
                                        <Button x:Name="BtnCompleteCalibration" DockPanel.Dock="Right" Content="✓ COMPLETE" Style="{StaticResource StyleCloudPassButton}" Click="BtnCompleteCalibration_Click" Padding="6,2" FontSize="9"/>
                                    </DockPanel>
                                    <TextBlock Text="Inspect updated Full Charge Capacity in SuperAutoMater telemetry. Verify that runtime discharge curve is linear and free of abrupt drop-offs." FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Real-Time Status & Alert Notice Terminal -->
                    <Border Grid.Row="2" Background="#0D1117" BorderBrush="#262C36" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtStatusHeadline" Text="Ready for Controlled Discharge Protocol" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="10" Foreground="#58A6FF"/>
                            <TextBlock x:Name="TxtStatusDetail" Text="Select drain load and click Start. Unplug AC adapter when prompted." FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#8B949E" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Action Bar -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="📋 COPY SOP GUIDE" Style="{StaticResource StyleDarkActionBtn}" Click="BtnCopySop_Click" Padding="12,6" ToolTip="Copy step-by-step Battery Recalibration SOP text to clipboard"/>
                <Button DockPanel.Dock="Right" Content="CLOSE [ESC]" Style="{StaticResource StyleDarkActionBtn}" Click="BtnClose_Click" Padding="16,6"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
