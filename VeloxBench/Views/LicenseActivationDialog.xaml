<Window x:Class="VeloxBench.Views.LicenseActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeloxBench System Authorization &amp; Cloud Depot Setup"
        Height="540" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0E1116"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Body -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse x:Name="DotStatus" Width="10" Height="10" Fill="#38BDF8" Margin="0,0,10,0"/>
                    <TextBlock Text="VELOXBENCH SYSTEM AUTHORIZATION &amp; CLOUD SYNC" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextWhite}"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#1C2128" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock x:Name="TxtStatusBadge" Text="VERIFIED" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#38BDF8" FontWeight="Bold"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Current License Card -->
                <RowDefinition Height="*"/>    <!-- Key Input & Cloud Info -->
            </Grid.RowDefinitions>

            <!-- Card 1: Active License Overview -->
            <Border Grid.Row="0" Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SYSTEM AUTHORIZATION STATUS" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Company -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FACILITY / ORGANIZATION" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtCompany" Text="Ritchie St Refurb Depot" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Terminal / Bench -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TERMINAL / BENCH" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtBenchName" Text="BENCH-01" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="#A78BFA" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Offline Grace & Validity -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AUTHORIZATION STATUS" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtValidity" Text="Active · Verified" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="#34D399" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TxtStatusSummary" Text="Online validated against Velox Cloud API. 14-day offline lease cached." FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#8B949E" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Activation & Server Config -->
            <Border Grid.Row="1" Background="#161B22" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="SYSTEM ACTIVATION KEY" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextWhite}" Margin="0,0,0,8"/>

                    <!-- Key Input Box + Buttons -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtKeyInput" Grid.Column="0" Text="VLX-ALPHA-TEST-2026" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="Bold" Background="#0D1117" Foreground="#58A6FF" BorderBrush="#30363D" Padding="10,8" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="📋 PASTE" Style="{StaticResource StyleDarkActionBtn}" Click="BtnPaste_Click" Margin="6,0,0,0" Padding="12,0"/>
                        <Button Grid.Column="2" Content="⚡ ACTIVATE ONLINE" Style="{StaticResource StyleCloudPassButton}" Click="BtnActivate_Click" Margin="6,0,0,0" Padding="14,0"/>
                    </Grid>

                    <CheckBox x:Name="ChkPersistUsb" Content="Save key to portable USB drive (license.key) &amp; config.json" IsChecked="True" Foreground="#94A3B8" FontFamily="{StaticResource FontMono}" FontSize="10" Margin="0,0,0,12"/>

                    <!-- Cloud Server Status Line -->
                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="CLOUD API: " FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtServerUrl" Text="http://13.233.xxx.xxx" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#58A6FF" FontWeight="Bold"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="📡 TEST PING" Style="{StaticResource StyleDarkActionBtn}" Click="BtnTestPing_Click" Height="22" Padding="8,2" FontSize="9"/>
                        </DockPanel>
                    </Border>

                    <!-- Feedback Banner -->
                    <Border x:Name="PnlFeedback" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10,8" Visibility="Collapsed">
                        <TextBlock x:Name="TxtFeedback" Text="[VLX-OK-200] License Activated" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#10B981" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="CLOSE [ESC]" Style="{StaticResource StyleDarkActionBtn}" Click="BtnClose_Click" Width="120"/>
                <Button DockPanel.Dock="Right" Content="SAVE &amp; APPLY" Style="{StaticResource StyleCloudPassButton}" Click="BtnClose_Click" Width="140"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
