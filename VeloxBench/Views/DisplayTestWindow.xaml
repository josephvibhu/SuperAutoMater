<Window x:Class="SuperAutoMater.Wpf.Views.DisplayTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Display &amp; Panel Diagnostic Lab"
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        Background="#000000"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        Cursor="Hand"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <!-- Interactive Drawing Surface for Advanced Stages -->
        <Canvas x:Name="DisplayCanvas"/>

        <!-- Top Right Live Refresh / Stage Indicator -->
        <Border x:Name="TopBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#CC161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStageIndex" Text="STAGE 1/14" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#58A6FF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtRefreshRate" Text="60.0 Hz PANEL" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#3FB950" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtTimingDetails" Text="VSYNC NOMINAL (0.0ms Jitter · 0 Drops)" FontFamily="Consolas" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Floating Bottom HUD Control Bar -->
        <Border x:Name="HudPanel"
                Background="#E6161B22"
                BorderBrush="#388BFD"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Effect="{StaticResource EffectCardShadow}">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="📺" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStageTitle" Text="SOLID WHITE (UNIFORMITY &amp; DEAD PIXELS)" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnLaunchTouch" Content="👆 TOUCH DIGITIZER" Style="{StaticResource StyleDarkActionBtn}" Click="BtnLaunchTouch_Click" Padding="8,3" FontSize="10" Margin="0,0,8,0"/>
                        <Button Content="✓ PASS DISPLAY [ENTER]" Style="{StaticResource StyleCloudPassButton}" Click="BtnPass_Click" Padding="12,4" FontSize="10"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Click / [Space] Next · [←/→] Prev · [H] Toggle HUD · [Esc] Exit" FontFamily="Consolas" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="14-STAGE ADVANCED DISPLAY LAB" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="#58A6FF" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
