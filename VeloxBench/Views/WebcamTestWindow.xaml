<Window x:Class="VeloxBench.Views.WebcamTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webcam &amp; Optical Sensor Diagnostic Test"
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0E1116"
        Foreground="#F0F6FC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Selector -->
            <RowDefinition Height="*"/>    <!-- Video Feed -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Top Header & Device Selector -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#3FB950" Margin="0,0,8,0"/>
                    <TextBlock Text="WEBCAM &amp; OPTICAL SENSOR" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="CAMERA: " FontFamily="Consolas" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbCameras" Width="280" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" SelectionChanged="CmbCameras_SelectionChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Video Viewport -->
        <Border Grid.Row="1" Background="#000000" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <Image x:Name="ImgCameraFeed" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- No Camera / Loading Overlay -->
                <StackPanel x:Name="StackNoCamera" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtNoCameraMsg" Text="Searching for camera sensor..." FontFamily="Consolas" FontSize="13" Foreground="#C9D1D9" HorizontalAlignment="Center"/>
                    <TextBlock Text="Check physical privacy shutter switch on laptop bezel" FontFamily="Consolas" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="● SENSOR CONNECTED" FontFamily="Consolas" FontSize="11" Foreground="#3FB950" FontWeight="Bold"/>
                    <TextBlock Text=" | " FontFamily="Consolas" FontSize="11" Foreground="#30363D"/>
                    <TextBlock x:Name="TxtResolution" Text="1280x720 @ 30 FPS" FontFamily="Consolas" FontSize="11" Foreground="#8B949E"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="CANCEL / CLOSE [ESC]" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Click="BtnCancel_Click" Margin="0,0,8,0" Padding="12,6" Cursor="Hand"/>
                    <Button Content="✓ PASS CAMERA TEST [ENTER]" Background="#238636" Foreground="#FFFFFF" BorderBrush="#2EA043" BorderThickness="1" Click="BtnPass_Click" Padding="14,6" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
