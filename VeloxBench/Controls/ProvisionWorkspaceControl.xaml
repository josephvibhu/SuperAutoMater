<UserControl x:Class="VeloxBench.Controls.ProvisionWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootProvision">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Pre-Flight Safety Audit Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: 4 Bento Operational Cards (2x2 Grid) -->
            <RowDefinition Height="*" />
            <!-- 2: Real-Time Execution Console Log -->
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 0. PRE-FLIGHT SAFETY AUDIT BAR                                      -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ " FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="PRE-FLIGHT AUDIT: " FontWeight="Bold" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />

                    <!-- BitLocker Status Pill -->
                    <Border x:Name="BorderBitLocker" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="4,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BitLocker: " FontSize="10" Foreground="#8B949E" />
                            <TextBlock x:Name="TxtBitLockerStatus" Text="Probing..." FontWeight="Bold" FontSize="10" Foreground="#58A6FF" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnSuspendBitLocker" Content="Suspend BitLocker" Background="#21262D" Foreground="#D29922" BorderBrush="#30363D" Padding="6,2" FontSize="9.5" Margin="0,0,10,0" Cursor="Hand" Click="BtnSuspendBitLocker_Click" Visibility="Collapsed" />

                    <!-- Power / Battery Pill -->
                    <Border x:Name="BorderPower" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Power: " FontSize="10" Foreground="#8B949E" />
                            <TextBlock x:Name="TxtPowerStatus" Text="Checking..." FontWeight="Bold" FontSize="10" Foreground="#3FB950" />
                        </StackPanel>
                    </Border>

                    <!-- Windows Activation Pill -->
                    <Border x:Name="BorderActivation" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OS License: " FontSize="10" Foreground="#8B949E" />
                            <TextBlock x:Name="TxtActivationStatus" Text="Probing..." FontWeight="Bold" FontSize="10" Foreground="#F0F6FC" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRefreshPreflight" Content="🔄 Re-Scan Audit" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" Padding="10,4" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="BtnRefreshPreflight_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 1. FOUR OPERATIONAL BENTO TILES (2x2 GRID)                          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── TILE 1: 💾 DISM DRIVER HARVESTING ──────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="💾 " FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="DISM 3RD-PARTY DRIVER HARVEST" FontWeight="Bold" FontSize="11" Foreground="#58A6FF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#21262D" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="PLUG &amp; PLAY" FontSize="9" FontWeight="Bold" Foreground="#8B949E" />
                        </Border>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Preserves proprietary Wi-Fi, audio, chipset and trackpad drivers to USB flash drive before factory reset or clean OS staging." FontSize="9.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="TARGET EXPORT DIRECTORY:" FontSize="9" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtDriverExportPath" FontFamily="Consolas" FontSize="10" Padding="6,3" Margin="0,0,0,8" />

                        <ProgressBar x:Name="ProgBarDrivers" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#58A6FF" Background="#0D1117" BorderBrush="#30363D" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtDriverProgress" Text="Ready for export" FontFamily="Consolas" FontSize="9" Foreground="#6E7681" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnExportDrivers" Grid.Column="0" Content="💾 Export Drivers (DISM)" Background="#1F324D" Foreground="#58A6FF" BorderBrush="#388BFD" BorderThickness="1" Padding="8,6" FontWeight="Bold" FontSize="10" Cursor="Hand" Click="BtnExportDrivers_Click" />
                        <Button x:Name="BtnInjectDrivers" Grid.Column="2" Content="📥 Inject to System" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="8,6" FontSize="10" Cursor="Hand" Click="BtnInjectDrivers_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ── TILE 2: 🧹 DEPOT SANITIZATION (ZERO TRACE) ─────────────────── -->
            <Border Grid.Row="0" Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="🧹 " FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="DEPOT ARTIFACT SANITIZER" FontWeight="Bold" FontSize="11" Foreground="#3FB950" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#21262D" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="ZERO FOOTPRINT" FontSize="9" FontWeight="Bold" Foreground="#3FB950" />
                        </Border>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Purges diagnostic cache, event logs, DNS, crash dumps and temp folders prior to customer handover." FontSize="9.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <CheckBox x:Name="ChkClearEventLogs" Content="Clear Windows Event Logs (App, System, Security)" IsChecked="True" Foreground="#F0F6FC" Margin="0,2,0,2" FontSize="9.5" />
                        <CheckBox x:Name="ChkPurgeVeloxTemp" Content="Purge VeloxBench temp binaries &amp; extraction cache" IsChecked="True" Foreground="#F0F6FC" Margin="0,2,0,2" FontSize="9.5" />
                        <CheckBox x:Name="ChkEmptyRecycleBin" Content="Empty Recycle Bin &amp; purge %TEMP% caches" IsChecked="True" Foreground="#F0F6FC" Margin="0,2,0,2" FontSize="9.5" />
                        <CheckBox x:Name="ChkBypassNro" Content="Set Windows 11 BypassNRO (permit offline local OOBE setup)" IsChecked="True" Foreground="#F0F6FC" Margin="0,2,0,2" FontSize="9.5" />
                    </StackPanel>

                    <Button x:Name="BtnSanitize" Grid.Row="2" Content="🧹 Sanitize System Now" Background="#1B4D3E" Foreground="#3FB950" BorderBrush="#2EA043" BorderThickness="1" Padding="8,6" FontWeight="Bold" FontSize="10" Cursor="Hand" Click="BtnSanitize_Click" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <!-- ── TILE 3: 🚀 WINDOWS SYSPREP & OOBE STAGING ───────────────────── -->
            <Border Grid.Row="1" Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="🚀 " FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="WINDOWS SYSPREP &amp; OOBE AUTOMATION" FontWeight="Bold" FontSize="11" Foreground="#A371F7" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#21262D" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="sysprep.exe" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="#D2A8FF" />
                        </Border>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Generalizes system SIDs and stages clean Out-Of-Box Experience for customer unboxing." FontSize="9.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <!-- Mode selection -->
                        <RadioButton x:Name="RbSysprepShutdown" Content="Generalize &amp; Shutdown (Ready for Box / Customer Shipment)" IsChecked="True" Foreground="#F0F6FC" FontSize="9.5" Margin="0,2,0,2" />
                        <RadioButton x:Name="RbSysprepReboot" Content="Generalize &amp; Reboot to OOBE (Technician First Boot Check)" Foreground="#F0F6FC" FontSize="9.5" Margin="0,2,0,4" />

                        <CheckBox x:Name="ChkApplyUnattend" Content="Generate &amp; Inject Unattended Answer File (unattend.xml)" IsChecked="True" Foreground="#F0F6FC" FontSize="9.5" Margin="0,2,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock Text="OEM Brand: " FontSize="9" Foreground="#8B949E" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtOemBrand" Text="Velox Certified Refurbished" FontFamily="Consolas" FontSize="9" Width="140" Margin="4,0,8,0" />
                            <TextBlock Text="User: " FontSize="9" Foreground="#8B949E" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtDefaultUser" Text="User" FontFamily="Consolas" FontSize="9" Width="50" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BtnExecuteSysprep" Grid.Row="2" Content="🚀 Execute Automated Sysprep" Background="#2B1D4D" Foreground="#D2A8FF" BorderBrush="#8A63D2" BorderThickness="1" Padding="8,6" FontWeight="Bold" FontSize="10" Cursor="Hand" Click="BtnExecuteSysprep_Click" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <!-- ── TILE 4: 🔄 WINDOWS FACTORY RESET & WINRE ────────────────────── -->
            <Border Grid.Row="1" Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,4,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="🔄 " FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="WINDOWS RESET &amp; RECOVERY LAB" FontWeight="Bold" FontSize="11" Foreground="#D29922" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#21262D" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="RECOVERY ENV" FontSize="9" FontWeight="Bold" Foreground="#D29922" />
                        </Border>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Triggers clean factory reset or direct one-time boot to Windows Recovery Environment (WinRE)." FontSize="9.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="• Windows Factory Reset (Push-Button Reset): Re-installs clean Windows while keeping or wiping partitions." FontSize="9" Foreground="#8B949E" Margin="0,0,0,3" />
                        <TextBlock Text="• WinRE Reboot (reagentc /boottore): Restarts directly into advanced recovery diagnostics." FontSize="9" Foreground="#8B949E" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnFactoryReset" Grid.Column="0" Content="🔄 Windows Factory Reset" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="8,6" FontSize="10" Cursor="Hand" Click="BtnFactoryReset_Click" />
                        <Button x:Name="BtnWinReReboot" Grid.Column="2" Content="🛠️ Reboot to WinRE" Background="#3D2914" Foreground="#D29922" BorderBrush="#9E6A03" BorderThickness="1" Padding="8,6" FontWeight="Bold" FontSize="10" Cursor="Hand" Click="BtnWinReReboot_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- 2. REAL-TIME EXECUTION CONSOLE LOG                                  -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0A0D12" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Ellipse Width="6" Height="6" Fill="#58A6FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="AUTO-PROVISIONING EXECUTION STREAM" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Copy Log" Background="#161B22" Foreground="#8B949E" BorderBrush="#30363D" Padding="6,1" FontSize="9" Margin="0,0,6,0" Cursor="Hand" Click="BtnCopyLog_Click" />
                        <Button Content="Clear" Background="#161B22" Foreground="#8B949E" BorderBrush="#30363D" Padding="6,1" FontSize="9" Cursor="Hand" Click="BtnClearLog_Click" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer x:Name="ScrollLog" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="TxtConsoleLog" Background="Transparent" Foreground="#7EE787" FontFamily="Consolas" FontSize="10" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
