<UserControl x:Class="VeloxBench.Controls.KeyboardMatrixControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootKb">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Controls -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#58A6FF" Margin="0,0,8,0"/>
                <TextBlock Text="LIVE KEYBOARD HEATMAP &amp; RAW SCANNER" FontWeight="Bold" FontSize="11" Foreground="#F0F6FC"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Border x:Name="PillLastKey" CornerRadius="4" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtLastKey" Text="LAST KEY: READY" FontFamily="Consolas" FontSize="10" Foreground="#58A6FF" FontWeight="Bold"/>
                </Border>
                <Button x:Name="BtnToggleNumpad" Content="[+ EXPAND NUMPAD]" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Click="BtnToggleNumpad_Click" Padding="8,2" Margin="0,0,8,0" FontSize="10" Cursor="Hand" ToolTip="Toggle dynamic Numpad block (also auto-expands on numpad keypress)"/>
                <TextBlock Text="KEYS LOGGED: " FontFamily="Consolas" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtLoggedCount" Text="0/84" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button x:Name="BtnReset" Content="RESET MATRIX" Background="#21262D" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Click="BtnReset_Click" Padding="8,2" FontSize="10" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <!-- Keyboard Key Matrix Rows -->
        <Border Grid.Row="1" Background="#0D1117" CornerRadius="8" BorderBrush="#30363D" BorderThickness="1" Padding="8,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Main Keyboard Section -->
                <StackPanel x:Name="StackKeyRows" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Generated dynamically in codebehind for instant performance -->
                </StackPanel>

                <!-- Dynamic Numpad Separator Divider -->
                <Rectangle x:Name="NumpadDivider" Width="1" Fill="#30363D" Margin="10,2,10,2" Visibility="Collapsed"/>

                <!-- Dynamic Numpad Section -->
                <StackPanel x:Name="StackNumpadRows" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <!-- Numpad rows generated dynamically -->
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer Bar -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Ellipse Width="6" Height="6" Fill="#3FB950" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Raw Windows Low-Level Input Hook Active · All application shortcuts suppressed" FontFamily="Consolas" FontSize="9.5" Foreground="#3FB950" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="Tip: If top row sends Volume/Mute, toggle laptop Fn-Lock ([Fn + Esc])" FontFamily="Consolas" FontSize="9.5" Foreground="#8B949E" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
