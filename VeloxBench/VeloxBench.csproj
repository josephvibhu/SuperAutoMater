<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>VeloxBench</AssemblyName>
		<Product>VeloxBench — Hardware Diagnostic &amp; QC Cockpit</Product>
		<Company>Velox Depot Systems</Company>
		<Version>1.6.10</Version>
		<AssemblyVersion>1.6.10.0</AssemblyVersion>
		<FileVersion>1.6.10.0</FileVersion>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<NoWarn>NU1701;WFO1000;NU1903</NoWarn>

		<!-- Standalone single EXE publish settings -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishReadyToRunComposite>true</PublishReadyToRunComposite>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<TieredCompilation>true</TieredCompilation>
		<Optimize>true</Optimize>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<ExcludeSatelliteAssemblies>true</ExcludeSatelliteAssemblies>
		<DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

		<!-- Administrator elevation manifest -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="app.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- Native disk and diagnostic tools bundled in lib/ -->
		<None Include="lib\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>lib\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
		</None>
		<None Include="test_audio.mp3" Condition="Exists('test_audio.mp3')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>lib\test_audio.mp3</TargetPath>
		</None>
		<None Include="test_audio.wav" Condition="Exists('test_audio.wav')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>lib\test_audio.wav</TargetPath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Velox.Shared\Velox.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AForge.Video" Version="2.2.5" />
		<PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<PackageReference Include="System.Management" Version="10.0.10" />
		<PackageReference Include="ZXing.Net" Version="0.16.11" />
		<PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
	</ItemGroup>

</Project>
