# ─── VeloxAPI Environment Variables ────────────────────────────────────────────
# Copy this file to .env for local development.
# On Railway: set these as environment secrets in the dashboard.

# ── Required ──────────────────────────────────────────────────────────────────

# Secret key for signing JWTs. Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
VELOX_JWT_SECRET=change-me-generate-a-random-32-char-secret

# Secret for the one-time admin setup endpoint (/api/v1/admin/setup).
# Used only once to create your depot tenant + API key. Keep private.
VELOX_ADMIN_SECRET=change-me-admin-setup-secret

# ── Optional ──────────────────────────────────────────────────────────────────

# SQLite database directory. On Railway, set this to a volume mount path.
# Default: %LocalAppData%/Velox/VeloxAPI/
# VELOX_DB_PATH=/data

# Allowed CORS origins for VeloxLink PWA (comma-separated).
# Default: * (allow all). Restrict in production:
# VELOX_CORS_ORIGINS=https://veloxlink.railway.app,https://yourdomain.com

# Port (default 8080 in Docker, 5000 in dev)
# VELOX_PORT=8080
